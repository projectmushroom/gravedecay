#!/bin/sh
# Homebrew's fixed command surface; source-checkout users may invoke it too.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-}" in
  install|status|uninstall) c=$1; shift; exec "$HERE/$c.sh" "$@";;
  *) echo "usage: gravedecay-mac {install|status|uninstall} [options]" >&2; exit 2;;
esac
