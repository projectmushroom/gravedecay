#!/usr/bin/env python3
"""Stateful Serve fixture; identity/auth still come from a fixed test tailnet."""
import json
import os
from pathlib import Path
import pwd
import sys
import tempfile

args=sys.argv[1:]
identity={'Self':{'UserID':100,'DNSName':'e2ebox.tail-e2e.ts.net.'},
          'User':{'100':{'LoginName':'mole@example.com'},'200':{'LoginName':'bob@example.com'}}}
base=Path('/tmp/grave-e2e-tailscale'); path=base/'serve.json'

def load():
    try: return json.loads(path.read_text())
    except FileNotFoundError: return {}

def save(config):
    base.mkdir(mode=0o700,exist_ok=True)
    owner=pwd.getpwnam('mole')
    if os.geteuid()==0: os.chown(base,owner.pw_uid,owner.pw_gid)
    fd,name=tempfile.mkstemp(dir=base)
    try:
        if os.geteuid()==0: os.fchown(fd,owner.pw_uid,owner.pw_gid)
        with os.fdopen(fd,'w') as out: json.dump(config,out)
        os.replace(name,path)
    finally:
        if os.path.exists(name): os.unlink(name)

if args[:1]==['status']:
    if '--json' in args: print(json.dumps(identity))
    else: print('100.64.0.1  e2ebox  mole@example.com  linux  -')
elif args[:2]==['serve','status']:
    config=load()
    if '--json' in args: print(json.dumps(config))
    else:
        for origin,web in config.get('Web',{}).items():
            print('https://'+origin+' (tailnet only)')
            for mount,handler in web['Handlers'].items(): print('|-- '+mount+' proxy '+handler['Proxy'])
elif args[:2]==['serve','get-config']:
    value=json.dumps(load())
    if len(args)>2: Path(args[2]).write_text(value)
    else: print(value)
elif args[:1]==['serve']:
    config=load(); port=next((x.split('=',1)[1] for x in args if x.startswith('--https=')),'443')
    mount=next((x.split('=',1)[1] for x in args if x.startswith('--set-path=')),'/')
    origin='e2ebox.tail-e2e.ts.net:'+port
    handlers=config.setdefault('Web',{}).setdefault(origin,{'Handlers':{}})['Handlers']
    if args[-1]=='off':
        handlers.pop(mount,None)
        if not handlers:
            config['Web'].pop(origin,None); config.setdefault('TCP',{}).pop(port,None)
    else:
        target=args[-1]
        if not target.startswith('http://127.0.0.1:'): raise SystemExit('unexpected fixture Serve target')
        handlers[mount]={'Proxy':target}; config.setdefault('TCP',{})[port]={'HTTPS':True}
    save(config)
