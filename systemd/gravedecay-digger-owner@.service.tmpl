[Unit]
Description=gravedecay digger %i (owner account: shared or separate-login)
Documentation=https://github.com/projectmushroom/gravedecay/blob/master/docs/DIGGERS.md
# Installed by raise.sh but never enabled or started in M1: there is no runner
# yet. M2 (#246) starts it. No listener, ever: intake is outbound only.
After=network-online.target
Wants=network-online.target
OnFailure=gravedecay-notify@%n.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@GRAVE_ROOT@/config/diggers/%i
Environment=HOME=@HOME@
Environment=GRAVE_ROOT=@GRAVE_ROOT@
Environment=PATH=@TOOLPATH@@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@PYTHON@ -I @GRAVE_ROOT@/scripts/diggers.py run %i
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Same Unix account as the owner (docs/SECURITY.md "Diggers"): HOME stays
# readable, and only the provider state a shared digger uses is writable.
ProtectHome=read-only
ReadWritePaths=@GRAVE_ROOT@/config/diggers/%i @GRAVE_ROOT@/worktrees @GRAVE_ROOT@/agents
ReadWritePaths=-@HOME@/.codex -@HOME@/.claude -@HOME@/.claude.json
UMask=0077
TasksMax=512
MemoryHigh=6G
MemoryMax=8G
CPUQuota=400%
