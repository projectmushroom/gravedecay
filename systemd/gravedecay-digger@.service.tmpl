[Unit]
Description=gravedecay digger %i (dedicated identity)
Documentation=https://github.com/projectmushroom/gravedecay/blob/master/docs/DIGGERS.md
# Installed by raise.sh; `grave digger new|enable` enables and starts one per
# digger, `disable|kill|remove` stops it. Never after or wanting t3code.service
# (doctor checks). No listener, ever: requests arrive as files in its inbox.
After=network-online.target
Wants=network-online.target
OnFailure=gravedecay-notify@%n.service

[Service]
Type=simple
User=grave-digger-%i
Group=grave-digger-%i
WorkingDirectory=@GRAVE_ROOT@/diggers/%i
Environment=HOME=@GRAVE_ROOT@/diggers/%i
Environment=GRAVE_ROOT=@GRAVE_ROOT@
# The root-owned provider copy; never the owner's toolchain under their HOME.
Environment=PATH=@GRAVE_ROOT@/diggers/.tools/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISABLE_AUTOUPDATER=1
ExecStart=@PYTHON@ -I @GRAVE_ROOT@/scripts/diggers.py serve %i --identity dedicated
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# /home, /root and /run/user are hidden: the owner's ~/.config/gh and provider
# logins are unreachable. The digger's own HOME is under GRAVE_ROOT.
ProtectHome=yes
ReadWritePaths=@GRAVE_ROOT@/diggers/%i @GRAVE_ROOT@/diggers/.records/%i
UMask=0077
TasksMax=512
MemoryHigh=6G
MemoryMax=8G
CPUQuota=400%

[Install]
WantedBy=multi-user.target
