#!/usr/bin/env python3
"""Appliance-owned multi-user workspace registry and lifecycle helper."""
import argparse, fcntl, ipaddress, json, os, pwd, re, secrets, shutil, stat, subprocess, sys, tarfile, tempfile, time
from pathlib import Path

ROOT = Path(os.environ.get("GRAVE_ROOT", "/srv/dev"))
REGISTRY = Path(os.environ.get("GRAVE_WORKSPACE_REGISTRY", ROOT / "config/workspaces.json"))
HOME_ROOT = Path(os.environ.get("GRAVE_WORKSPACE_HOME_ROOT", ROOT / "workspaces"))
SLUG = re.compile(r"^[a-z][a-z0-9-]{2,30}$")
PROJECT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$")
ROLES = {"admin", "developer"}
PORT_BASE = {"t3": 4810, "term": 4910, "dash": 5010}
PROVIDER_SECRET=ROOT/"config/secrets/provider.env"
SERVICE_ROOT=ROOT/"config/workspace-services"
MIGRATION_ROOT=ROOT/"config/workspace-migrations"
RESTORE_ROOT=ROOT/"config/workspace-restores"
PROVIDER_NAMES={"OPENAI_API_KEY","ANTHROPIC_API_KEY"}

def die(message): raise SystemExit(f"grave users: {message}")
def unix_name(slug): return f"grave-{slug}"
def loopback_listeners(text):
    """True when every parsed `ss -H -ltn` local endpoint is loopback."""
    for line in text.splitlines():
        fields=line.split()
        if len(fields) < 4: return False
        host=fields[3].rsplit(":",1)[0].strip("[]").split("%",1)[0]
        try: ip=ipaddress.ip_address(host)
        except ValueError: return False
        mapped=getattr(ip,"ipv4_mapped",None)
        if not (ip.is_loopback or (mapped and mapped.is_loopback)): return False
    return True
def run(*args):
    if os.environ.get("GRAVE_WORKSPACE_TEST") == "1": return
    subprocess.run(args, check=True)
def audit(event,workspace=None,target=None,result="ok"):
    path=ROOT/"logs/audit.jsonl"; path.parent.mkdir(parents=True,exist_ok=True)
    record={"ts":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime()),"event":event,"actor":"appliance-admin","workspace":workspace,"target":target,"result":result}
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_APPEND,0o600)
    try: os.write(fd,(json.dumps(record,separators=(",",":"))+"\n").encode())
    finally: os.close(fd)
def as_user(w,*args):
    home=HOME_ROOT/w["slug"]
    if os.environ.get("GRAVE_WORKSPACE_TEST") == "1":
        subprocess.run(args,check=True,env={**os.environ,"HOME":str(home),"XDG_CONFIG_HOME":str(home/"config")}); return
    run("runuser","-u",unix_name(w["slug"]),"--","env",f"HOME={home}",f"XDG_CONFIG_HOME={home/'config'}",*args)
def as_user_result(w,*args,check=True,capture=False):
    home=HOME_ROOT/w["slug"]; env=["env",f"HOME={home}",f"XDG_CONFIG_HOME={home/'config'}"]
    if os.environ.get("GRAVE_WORKSPACE_TEST") == "1": return subprocess.run(args,check=check,capture_output=capture,text=True,env={**os.environ,"HOME":str(home),"XDG_CONFIG_HOME":str(home/"config")})
    return subprocess.run(["runuser","-u",unix_name(w["slug"]),"--",*env,*args],check=check,capture_output=capture,text=True)

def load():
    try: data = json.loads(REGISTRY.read_text())
    except FileNotFoundError: data = {"version": 1, "workspaces": []}
    except (OSError, json.JSONDecodeError) as exc: die(f"cannot read registry: {exc}")
    if data.get("version") != 1 or not isinstance(data.get("workspaces"), list):
        die("unsupported or malformed registry")
    return data

def save(data):
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".workspaces.", dir=REGISTRY.parent)
    try:
        os.fchmod(fd, 0o600)
        if os.environ.get("GRAVE_WORKSPACE_TEST") != "1" and os.environ.get("SUDO_UID"):
            os.fchown(fd,int(os.environ["SUDO_UID"]),int(os.environ.get("SUDO_GID","0")))
        with os.fdopen(fd, "w") as out:
            json.dump(data, out, indent=2, sort_keys=True); out.write("\n"); out.flush(); os.fsync(out.fileno())
        os.replace(name, REGISTRY)
        with absolute_directory(REGISTRY.parent,trusted=True) as directory: os.fsync(directory)
    finally:
        try: os.unlink(name)
        except FileNotFoundError: pass

def validate(data):
    seen_id=set(); seen_slug=set(); seen_port=set()
    for w in data["workspaces"]:
        if not isinstance(w.get("id"), str) or not w["id"].startswith("ts:"): die("unsafe stable identity")
        if not SLUG.fullmatch(w.get("slug", "")): die(f"unsafe slug: {w.get('slug', '')}")
        if w.get("role") not in ROLES or not isinstance(w.get("enabled"), bool): die(f"invalid record: {w['slug']}")
        if not isinstance(w.get("projects"),list): die(f"invalid projects: {w['slug']}")
        project_names=set()
        for project in w["projects"]:
            if not isinstance(project,dict) or not PROJECT.fullmatch(project.get("name","")) or not valid_remote(project.get("url","")) or project["name"] in project_names:
                die(f"invalid project grant: {w['slug']}")
            project_names.add(project["name"])
        removal=w.get('removal')
        if removal is not None:
            if (not isinstance(removal,dict) or set(removal)!={'archive','uid','gid','device','inode'}
                    or not re.fullmatch(re.escape(w['slug'])+r'-[0-9a-f]{32}',str(removal.get('archive','')))
                    or any(type(removal.get(key)) is not int or removal[key]<0 for key in ('uid','gid','device','inode'))
                    or w['enabled']):
                die('invalid workspace removal receipt')
        ports=w.get("ports", {})
        if set(ports) != set(PORT_BASE) or any(not isinstance(p, int) or not 1024 <= p <= 65535 for p in ports.values()):
            die(f"invalid ports: {w['slug']}")
        if w["id"] in seen_id or w["slug"] in seen_slug or seen_port.intersection(ports.values()): die("duplicate identity, slug, or port")
        seen_id.add(w["id"]); seen_slug.add(w["slug"]); seen_port.update(ports.values())

def allocate(data, kind):
    used={w["ports"][kind] for w in data["workspaces"]}
    return next(p for p in range(PORT_BASE[kind], PORT_BASE[kind]+100) if p not in used)

def find(data, value, allow_removal=False):
    matches=[w for w in data["workspaces"] if value in (w["id"], w["slug"])]
    if len(matches) != 1: die(f"workspace not found: {value}")
    if matches[0].get('removal') and not allow_removal: die('workspace removal is pending; retry the confirmed remove command')
    return matches[0]
def service_env(w): return SERVICE_ROOT/(w["slug"]+".env")
def provider_link(w): return SERVICE_ROOT/(w["slug"]+"-provider.env")
def sync_provider(w):
    configured=PROVIDER_SECRET.exists() or PROVIDER_SECRET.is_symlink()
    if configured: check_manager_file(PROVIDER_SECRET)
    with service_directory() as parent:
        name=provider_link(w).name
        try: os.unlink(name,dir_fd=parent)
        except FileNotFoundError: pass
        if w.get('provider',{}).get('llm') and configured:
            os.symlink(str(PROVIDER_SECRET),name,dir_fd=parent)

# Workspace content is always handled after exec under its Unix identity.
# Root only creates/validates the home itself beneath a trusted parent.
from contextlib import contextmanager

@contextmanager
def directory_at(parent, name, uid=None, private=False, create=False):
    created=False
    if create:
        try: os.mkdir(name,0o700,dir_fd=parent); created=True
        except FileExistsError: pass
    fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent)
    try:
        info=os.fstat(fd)
        if uid is not None and (info.st_uid != uid or info.st_mode & (0o077 if private else 0o022)):
            die(f"unsafe workspace directory ownership or mode: {name}")
        yield fd,created
    finally: os.close(fd)

@contextmanager
def absolute_directory(path, trusted=False, create=False):
    path=Path(path)
    if not path.is_absolute() or '..' in path.parts: die("unsafe absolute workspace path")
    fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY)
    owners={0,os.geteuid(),ROOT.lstat().st_uid} if trusted else set()
    try:
        for component in path.parts[1:]:
            if create:
                try: os.mkdir(component,0o755,dir_fd=fd)
                except FileExistsError: pass
            child=os.open(component,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)
            os.close(fd); fd=child
            if trusted:
                info=os.fstat(fd)
                sticky=info.st_uid==0 and info.st_mode & stat.S_ISVTX
                if info.st_uid not in owners or (info.st_mode & 0o022 and not sticky):
                    die(f"unsafe workspace ancestor: {component}")
        yield fd
    finally: os.close(fd)

@contextmanager
def service_directory():
    with absolute_directory(SERVICE_ROOT.parent,trusted=True) as parent:
        with directory_at(parent,SERVICE_ROOT.name,os.geteuid(),private=True,create=True) as (fd,_):
            yield fd

def read_control(parent, name):
    try: fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent)
    except FileNotFoundError: return ''
    with os.fdopen(fd,'r') as source:
        info=os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or info.st_mode & 0o077 or info.st_nlink!=1:
            die('unsafe workspace service configuration')
        data=source.read(16385)
        if len(data)>16384: die('workspace service configuration too large')
        return data

def write_control(parent, name, value):
    read_control(parent,name)
    temporary='.service-'+secrets.token_hex(16)
    fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=parent)
    try:
        with os.fdopen(fd,'w') as out:
            out.write(value); out.flush(); os.fsync(out.fileno())
        os.replace(temporary,name,src_dir_fd=parent,dst_dir_fd=parent)
        os.fsync(parent)
    finally:
        try: os.unlink(temporary,dir_fd=parent)
        except FileNotFoundError: pass

def rename_exclusive(source, name, destination, retained):
    # Linux appliances must support no-replace rename. Never fall back to an
    # overwrite-prone rename when the collaborator controls the archive parent.
    import ctypes, errno
    libc=ctypes.CDLL(None,use_errno=True)
    try: rename=libc.renameat2
    except AttributeError: raise OSError(errno.ENOSYS,'safe project retention requires renameat2')
    rename.argtypes=[ctypes.c_int,ctypes.c_char_p,ctypes.c_int,ctypes.c_char_p,ctypes.c_uint]
    rename.restype=ctypes.c_int
    if rename(source,os.fsencode(name),destination,os.fsencode(retained),1)!=0:
        code=ctypes.get_errno()
        raise OSError(code,os.strerror(code))

class WorkspaceTree:
    directories=('repos','state','state/t3','config','config/secrets','runtime','logs','.claude','.codex')
    files=('.claude/settings.json','.codex/config.toml')
    def __init__(self, home, home_fd=None): self.home=Path(home); self.home_fd=home_fd
    @contextmanager
    def root_directory(self):
        if self.home_fd is None:
            with absolute_directory(self.home) as fd: yield fd
        else:
            fd=os.dup(self.home_fd)
            try: yield fd
            finally: os.close(fd)
    @contextmanager
    def directory(self, relative='', create=False):
        with self.root_directory() as home:
            info=os.fstat(home)
            if info.st_uid != os.geteuid() or info.st_mode & 0o077:
                die("unsafe workspace home ownership or mode")
            fd=os.dup(home)
            try:
                for part in Path(relative).parts:
                    if part in ('.','..') or '/' in part: die("unsafe workspace component")
                    with directory_at(fd,part,os.geteuid(),private=True,create=create) as (child,_):
                        replacement=os.dup(child)
                    os.close(fd); fd=replacement
                yield fd
            finally: os.close(fd)
    def read(self, relative):
        path=Path(relative)
        with self.directory(str(path.parent)) as parent:
            try: fd=os.open(path.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent)
            except FileNotFoundError: return None
            with os.fdopen(fd,'rb') as source:
                info=os.fstat(source.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1 or info.st_mode & 0o022:
                    die(f"unsafe workspace file ownership, type or links: {relative}")
                data=source.read(1024*1024+1)
                if len(data)>1024*1024: die(f"workspace config too large: {relative}")
                return data.decode('utf-8')
    def write(self, relative, value):
        # Preflight the old file, then replace an entry rather than truncate or
        # chmod/chown through a collaborator-replaceable pathname.
        self.read(relative)
        path=Path(relative)
        with self.directory(str(path.parent)) as parent:
            name='.grave-'+secrets.token_hex(16)
            fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=parent)
            try:
                with os.fdopen(fd,'w') as out:
                    out.write(value); out.flush(); os.fsync(out.fileno())
                os.replace(name,path.name,src_dir_fd=parent,dst_dir_fd=parent)
                os.fsync(parent)
            finally:
                try: os.unlink(name,dir_fd=parent)
                except FileNotFoundError: pass
    def check(self, projects=(), allow_missing=False):
        for relative in self.directories:
            try:
                with self.directory(relative): pass
            except FileNotFoundError:
                if not allow_missing: raise
        try:
            with self.directory('revoked'): pass
        except FileNotFoundError: pass
        for relative in self.files:
            try: self.read(relative)
            except FileNotFoundError:
                if not allow_missing: raise
        for project in projects:
            if not PROJECT.fullmatch(project): die("unsafe project name")
            with self.directory('repos') as repos:
                with directory_at(repos,project,os.geteuid()): pass
    def revoke(self, name):
        if not PROJECT.fullmatch(name): die('unsafe project name')
        with self.directory('repos') as repos:
            try: os.stat(name,dir_fd=repos,follow_symlinks=False)
            except FileNotFoundError: return None
            with directory_at(repos,name,os.geteuid()): pass
            with self.directory('revoked',create=True) as revoked:
                retained=name+'-'+time.strftime('%Y%m%d-%H%M%S',time.gmtime())+'-'+secrets.token_hex(8)
                rename_exclusive(repos,name,revoked,retained)
                os.fsync(repos); os.fsync(revoked)
                return retained
    def provision(self, helper, projects):
        # Verify all existing managed paths before modifying any contents.
        self.check(projects,allow_missing=True)
        for relative in self.directories:
            with self.directory(relative,create=True): pass
        settings=self.read('.claude/settings.json')
        try: data=json.loads(settings) if settings else {}
        except json.JSONDecodeError: data=None
        if isinstance(data,dict) and isinstance(data.get('hooks',{}),dict):
            hooks=data.setdefault('hooks',{})
            command=f'{helper} claude'
            entry={'matcher':'','hooks':[{'type':'command','command':command}]}
            for name in ('Stop','Notification'):
                current=hooks.get(name) if isinstance(hooks.get(name),list) else []
                if not any(isinstance(block,dict) and isinstance(block.get('hooks'),list) and
                           any(isinstance(h,dict) and h.get('command')==command for h in block['hooks']) for block in current):
                    current.append(entry)
                hooks[name]=current
            self.write('.claude/settings.json',json.dumps(data,indent=2)+'\n')
        config=self.read('.codex/config.toml') or ''
        if 'grave-agent-notify' not in config and not re.search(r'(?m)^[ \t]*notify[ \t]*=',config):
            config=config.rstrip()+f'\n\nnotify = [{json.dumps(str(helper))}, "codex"]\n'
        self.write('.codex/config.toml',config)

def workspace_account(w):
    if os.environ.get('GRAVE_WORKSPACE_TEST')=='1':
        return pwd.getpwuid(os.geteuid())
    account=pwd.getpwnam(unix_name(w['slug']))
    if account.pw_uid==0 or account.pw_dir != str(HOME_ROOT/w['slug']):
        die(f"unsafe Unix account drift for {unix_name(w['slug'])}")
    return account

def tree_command(w, action, **arguments):
    try: account=workspace_account(w)
    except KeyError: die(f"missing Unix account: {w['slug']}")
    payload={'projects':[p['name'] for p in w['projects']],
             'helper':str(Path(os.environ.get('GRAVE_AGENT_NOTIFY',ROOT/'scripts/grave-agent-notify')))}
    payload.update(arguments)
    env={'PATH':'/usr/local/bin:/usr/bin:/bin','HOME':str(HOME_ROOT/w['slug'])}
    options={} if os.environ.get('GRAVE_WORKSPACE_TEST')=='1' else {'user':account.pw_uid,'group':account.pw_gid,'extra_groups':[]}
    result=subprocess.run([sys.executable,str(Path(__file__).absolute()),'__tree',action,str(HOME_ROOT/w['slug'])],
                          input=json.dumps(payload),env=env,text=True,capture_output=True,**options)
    if result.returncode: die(f"unsafe workspace tree: {w['slug']}; "+result.stderr.strip())
    return result.stdout.strip()

def prepare_workspace_home(w):
    home=HOME_ROOT/w['slug']
    with absolute_directory(HOME_ROOT,trusted=True,create=True) as parent:
        try: account=workspace_account(w)
        except KeyError:
            # Refuse an unmanaged existing entry before useradd can adopt it.
            try: os.stat(w['slug'],dir_fd=parent,follow_symlinks=False)
            except FileNotFoundError: pass
            else: die(f"unmanaged workspace home already exists: {w['slug']}")
            run('useradd','--system','--no-create-home','--home-dir',str(home),'--shell','/bin/bash',unix_name(w['slug']))
            account=workspace_account(w)
        with directory_at(parent,w['slug'],create=True) as (fd,created):
            if created:
                os.fchmod(fd,0o700)
                os.fchown(fd,account.pw_uid,account.pw_gid)
            info=os.fstat(fd)
            if info.st_uid!=account.pw_uid or info.st_mode & 0o077:
                die(f"unsafe workspace home ownership or mode: {w['slug']}")

def provision(w):
    if w.get('removal'): die('workspace removal is pending; retry the confirmed remove command')
    prepare_workspace_home(w)
    tree_command(w,'provision')
    home=HOME_ROOT/w['slug']
    env=service_env(w)
    with service_directory() as parent: old=read_control(parent,env.name)
    token=next((line.partition("=")[2].strip().strip('"') for line in old.splitlines()
                if line.startswith("GRAVEDECAY_BACKEND_TOKEN=") and len(line.partition("=")[2].strip().strip('"')) >= 32),secrets.token_hex(32))
    # Later `grave users add` calls do not carry raise.sh's explicit tool
    # arguments; resolve the appliance's installed binaries instead of
    # reviving a stale /usr/bin assumption.
    t3_bin=os.environ.get("GRAVE_T3_BIN") or shutil.which("t3") or "/usr/bin/t3"
    ttyd_bin=os.environ.get("GRAVE_TTYD_BIN") or shutil.which("ttyd") or "/usr/bin/ttyd"
    grave_bin=os.environ.get("GRAVE_BIN") or shutil.which("grave") or "/usr/local/bin/grave"
    values={"WORKSPACE_SLUG":w["slug"],"GRAVE_WORKSPACE_ID":w["id"],"WORKSPACE_ROLE":w["role"],"WORKSPACE_HOME":str(home),
            "T3_PORT":w["ports"]["t3"],"TERM_PORT":w["ports"]["term"],"DASH_PORT":w["ports"]["dash"],
            "T3_BIN":t3_bin,"GRAVEDECAY_T3":t3_bin,"TTYD_BIN":ttyd_bin,"GRAVEDECAY_GRAVE":grave_bin,
            "PATH":os.environ.get("GRAVE_TOOL_PATH","")+"/usr/local/bin:/usr/bin:/bin","GRAVEDECAY_BACKEND_TOKEN":token}
    with service_directory() as parent:
        write_control(parent,env.name,"".join(f'{key}="{str(value).replace(chr(34), "")}"\n' for key,value in values.items()))
    sync_provider(w)
    if os.environ.get("GRAVE_WORKSPACE_TEST") != "1":
        if env.stat().st_uid != 0: die("service environment must be root-owned")
        if w["enabled"] and os.environ.get("GRAVE_WORKSPACE_START","1")=="1": run("systemctl","enable","--now",f"gravedecay-t3@{w['slug']}.service",f"gravedecay-term@{w['slug']}.service",f"gravedecay-dashboard@{w['slug']}.service")

def cmd_add(a):
    check_restore_staging()
    if not SLUG.fullmatch(a.slug): die("slug must match ^[a-z][a-z0-9-]{2,30}$")
    if not a.identity.isdigit(): die("identity must be the numeric stable Tailscale user ID")
    data=load(); identity=f"ts:{a.identity}"
    existing=[w for w in data["workspaces"] if identity == w["id"] or a.slug == w["slug"]]
    if existing:
        w=existing[0]
        if w["id"] != identity or w["slug"] != a.slug: die("identity or slug already belongs to another workspace")
        provision(w); print(f"unchanged {w['slug']}"); return
    w={"id":identity,"login":a.login,"slug":a.slug,"role":a.role,"enabled":True,"projects":[],
       "ports":{kind:allocate(data,kind) for kind in PORT_BASE},"provider":{"llm":a.llm}}
    data["workspaces"].append(w); validate(data); provision(w); save(data); audit("workspace_added",w["slug"]); print(f"added {w['slug']}")

@contextmanager
def migration_directory(create=False):
    with absolute_directory(MIGRATION_ROOT.parent,trusted=True) as parent:
        with directory_at(parent,MIGRATION_ROOT.name,os.geteuid(),private=True,create=create) as (fd,_):
            yield fd

def check_migration_staging():
    try:
        with migration_directory() as fd:
            if os.listdir(fd): die('owner migration staging is incomplete; inspect config/workspace-migrations before retrying')
    except FileNotFoundError: pass

def copy_owner_state(content, payload):
    # A fresh exec runs this entire operation as the appliance owner. The
    # inherited directory handle permits entry without opening the root-only
    # staging parent to any unprivileged account.
    if os.geteuid()==0: die('owner state must not be copied as root')
    os.fchdir(content)
    root=Path(payload['root']); owner=Path(payload['owner_home'])
    def copy(source,destination):
        try: info=source.lstat()
        except FileNotFoundError: return
        if stat.S_ISLNK(info.st_mode): die('owner migration source must not be a symlink')
        Path(destination).parent.mkdir(parents=True,exist_ok=True)
        if stat.S_ISDIR(info.st_mode): shutil.copytree(source,destination,symlinks=True)
        elif stat.S_ISREG(info.st_mode): shutil.copy2(source,destination)
        else: die('owner migration source must be a file or directory')
    copy(root/'agents/t3code','state/t3')
    repos=root/'repos'
    if repos.is_symlink(): die('owner repos directory must not be a symlink')
    if repos.exists():
        for repo in sorted(repos.iterdir()):
            if repo.is_dir() and not repo.is_symlink(): copy(repo,Path('repos')/repo.name)
    for relative in ('.config/gh','.codex','.claude','.gitconfig'):
        copy(owner/relative,relative)
    copy(root/'config/secrets/linear.env','config/secrets/linear.env')
    copy(root/'config/gravedecay-settings.json','config/gravedecay-settings.json')
    # Private copies retain executable bits and repository symlinks. Never
    # follow a copied link when adjusting modes or later assigning ownership.
    for _,directories,files,fd in os.fwalk('.',follow_symlinks=False):
        os.fchmod(fd,0o700)
        for name in files:
            info=os.stat(name,dir_fd=fd,follow_symlinks=False)
            if stat.S_ISLNK(info.st_mode): continue
            if not stat.S_ISREG(info.st_mode) or info.st_nlink!=1: die('unsafe staged file')
            child=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=fd)
            try: os.fchmod(child,0o700 if info.st_mode & 0o111 else 0o600)
            finally: os.close(child)
    projects=[]
    if Path('repos').exists():
        for repo in sorted(Path('repos').iterdir()):
            if not PROJECT.fullmatch(repo.name) or not (repo/'.git').is_dir(): continue
            result=subprocess.run(['git','-C',str(repo),'remote','get-url','origin'],capture_output=True,text=True)
            url=result.stdout.strip()
            if result.returncode==0 and valid_remote(url): projects.append({'name':repo.name,'url':url})
    tree=WorkspaceTree('.',home_fd=content)
    tree.provision(payload['helper'],[p['name'] for p in projects])
    tree.check([p['name'] for p in projects])
    return projects

def assign_staged_owner(content, account):
    # Only unpublished content behind a root-private parent is traversed by
    # root. Hardlinks and special files are refused; symlink targets are never
    # opened or chowned. There is no recursive repair of a live workspace.
    for _,directories,files,fd in os.fwalk('.',dir_fd=content,follow_symlinks=False):
        for name in directories+files:
            info=os.stat(name,dir_fd=fd,follow_symlinks=False)
            if stat.S_ISLNK(info.st_mode):
                os.chown(name,account.pw_uid,account.pw_gid,dir_fd=fd,follow_symlinks=False)
            elif stat.S_ISREG(info.st_mode):
                child=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=fd)
                try:
                    info=os.fstat(child)
                    if not stat.S_ISREG(info.st_mode) or info.st_nlink!=1: die('unsafe staged file')
                    os.fchown(child,account.pw_uid,account.pw_gid); os.fsync(child)
                finally: os.close(child)
            elif not stat.S_ISDIR(info.st_mode): die('unsafe staged file')
        os.fchown(fd,account.pw_uid,account.pw_gid); os.fsync(fd)

def cmd_migrate_owner(a):
    check_restore_staging()
    if not SLUG.fullmatch(a.slug) or not a.identity.isdigit(): die('unsafe owner identity or slug')
    data=load(); validate(data)
    if any(w['id']==f'ts:{a.identity}' or w['slug']==a.slug for w in data['workspaces']):
        die('owner migration requires a fresh identity and slug; existing workspaces are never overwritten')
    owner=pwd.getpwnam(a.owner)
    if owner.pw_uid==0 or owner.pw_uid!=ROOT.lstat().st_uid: die('migration owner must be the non-root appliance owner')
    check_migration_staging()
    with absolute_directory(HOME_ROOT,trusted=True,create=True) as homes:
        try: os.stat(a.slug,dir_fd=homes,follow_symlinks=False)
        except FileNotFoundError: pass
        else: die('owner migration target already exists')
        if os.environ.get('GRAVE_WORKSPACE_TEST')!='1':
            try: pwd.getpwnam(unix_name(a.slug))
            except KeyError: pass
            else: die('owner migration Unix account already exists')
        with migration_directory(create=True) as stages:
            stage=a.slug+'-'+secrets.token_hex(16)
            with directory_at(stages,stage,os.geteuid(),private=True,create=True) as (parent,_):
                os.fsync(stages)
                write_control(parent,'record.json',json.dumps({'slug':a.slug,'identity':a.identity,'owner':a.owner})+'\n')
                with directory_at(parent,'content',create=True) as (content,_):
                    os.fchown(content,owner.pw_uid,owner.pw_gid); os.fsync(parent)
                    payload={'root':str(ROOT),'owner_home':owner.pw_dir,
                             'helper':str(Path(os.environ.get('GRAVE_AGENT_NOTIFY',ROOT/'scripts/grave-agent-notify')))}
                    options={} if os.environ.get('GRAVE_WORKSPACE_TEST')=='1' else {'user':owner.pw_uid,'group':owner.pw_gid,'extra_groups':[]}
                    result=subprocess.run([sys.executable,str(Path(__file__).absolute()),'__migration_copy',str(content)],
                                          pass_fds=(content,),input=json.dumps(payload),text=True,capture_output=True,
                                          env={'PATH':'/usr/local/bin:/usr/bin:/bin','HOME':owner.pw_dir},**options)
                    if result.returncode: die('owner state copy failed; originals unchanged, inspect private migration staging')
                    projects=json.loads(result.stdout)
                    w={'id':f'ts:{a.identity}','login':a.login,'slug':a.slug,'role':'admin','enabled':True,
                       'projects':projects,'ports':{kind:allocate(data,kind) for kind in PORT_BASE},'provider':{'llm':a.llm}}
                    data['workspaces'].append(w); validate(data)
                    run('useradd','--system','--no-create-home','--home-dir',str(HOME_ROOT/a.slug),'--shell','/bin/bash',unix_name(a.slug))
                    account=workspace_account(w)
                    assign_staged_owner(content,account)
                    rename_exclusive(parent,'content',homes,a.slug)
                    os.fsync(parent); os.fsync(homes)
                # Save before provisioning so a failed service setup leaves an
                # inspectable registry record; the staging receipt stays pending.
                save(data)
                os.environ['GRAVE_WORKSPACE_START']='0'
                provision(w)
                os.unlink('record.json',dir_fd=parent); os.fsync(parent)
            os.rmdir(stage,dir_fd=stages); os.fsync(stages)
    audit('owner_migrated',a.slug); print(f'migrated {a.slug}')

# Restore never feeds an archive to root tar or overlays a live workspace.
@contextmanager
def restore_directory(create=False):
    with absolute_directory(RESTORE_ROOT.parent,trusted=True) as parent:
        with directory_at(parent,RESTORE_ROOT.name,os.geteuid(),private=True,create=create) as (fd,_):
            yield fd

def check_restore_staging():
    try:
        with restore_directory() as fd:
            if os.listdir(fd): die('workspace restore is incomplete; inspect config/workspace-restores before continuing')
    except FileNotFoundError: pass

def restore_registry(data):
    if not isinstance(data,dict) or type(data.get('version')) is not int or data['version']!=1 or not isinstance(data.get('workspaces'),list) or not data['workspaces']:
        die('invalid or empty restore registry')
    for w in data['workspaces']:
        if (not isinstance(w,dict) or set(w)!={'id','login','slug','role','enabled','projects','ports','provider'}
                or not isinstance(w['id'],str) or not re.fullmatch(r'ts:[0-9]+',w['id'])
                or not isinstance(w['slug'],str) or not isinstance(w['role'],str)
                or not isinstance(w['login'],str) or not w['login'] or any(ord(c)<32 for c in w['login'])
                or not isinstance(w['ports'],dict) or not isinstance(w['provider'],dict)
                or set(w['provider'])!={'llm'} or type(w['provider']['llm']) is not bool):
            die('invalid restore workspace record (pending removals cannot be restored)')
        if not isinstance(w['projects'],list) or any(
                not isinstance(p,dict) or not isinstance(p.get('name'),str) or not isinstance(p.get('url'),str)
                for p in w['projects']):
            die('invalid restored project grants')
    validate(data)
    return data

def archive_path(name):
    # GNU tar directory entries have a trailing slash; ./ prefixes are harmless.
    while name.startswith('./'): name=name[2:]
    name=name.rstrip('/')
    parts=name.split('/')
    if not name or any(p in ('','.','..') for p in parts) or '\x00' in name:
        die('unsafe workspace archive path')
    return parts

def extract_workspace_backup(content, inputs, payload):
    import hashlib, tarfile
    if os.geteuid()==0: die('workspace archives must not be extracted as root')
    # Inputs are root-owned snapshots behind the private stage. Reverify these
    # exact bytes rather than trusting a preflight of mutable source paths.
    with os.fdopen(os.dup(inputs[0]),'rb') as stream:
        manifest=json.loads(stream.read(16*1024*1024+1))
    if not isinstance(manifest,dict) or type(manifest.get('version')) is not int or manifest['version'] not in (1,2):
        die('invalid restore manifest')
    if manifest['version']==2:
        for fd,name in zip(inputs[1:],('configs/grave-platform.tar.gz','configs/workspaces.tar.gz')):
            expected=manifest.get('artifacts',{}).get(name)
            with os.fdopen(os.dup(fd),'rb') as stream:
                checksum=hashlib.sha256()
                for block in iter(lambda: stream.read(1024*1024),b''): checksum.update(block)
                digest=checksum.hexdigest()
            os.lseek(fd,0,os.SEEK_SET)
            if not isinstance(expected,dict) or expected.get('sha256')!=digest or expected.get('size')!=os.fstat(fd).st_size:
                die('workspace restore checksum mismatch')
    else: print('WARNING: legacy backup has no checksums; archive paths will still be validated',file=sys.stderr)
    with os.fdopen(os.dup(inputs[2]),'rb') as stream, tarfile.open(fileobj=stream,mode='r:gz') as archive:
        members={}; embedded=None
        for member in archive:
            parts=archive_path(member.name)
            name='/'.join(parts)
            if name in members: die('duplicate workspace archive path')
            members[name]=member
            if name=='config/workspaces.json':
                if not member.isreg() or not 0<member.size<=16*1024*1024: die('invalid embedded registry')
                embedded=restore_registry(json.load(archive.extractfile(member)))
            elif name=='config/secrets/provider.env':
                if not member.isreg() or member.size>16384 or manifest.get('secrets_included') is not True:
                    die('invalid archived provider credentials')
            elif parts[0]!='workspaces': die('archive contains an outside path')
        if embedded is None:
            # Older backups kept the registry only in the platform archive.
            with os.fdopen(os.dup(inputs[1]),'rb') as platform_stream, tarfile.open(fileobj=platform_stream,mode='r:gz') as platform:
                records=[m for m in platform if archive_path(m.name)==['config','workspaces.json']]
                if len(records)!=1 or not records[0].isreg() or not 0<records[0].size<=16*1024*1024:
                    die('backup requires exactly one regular workspace registry')
                data=restore_registry(json.load(platform.extractfile(records[0])))
        else: data=embedded
        slugs={w['slug'] for w in data['workspaces']}
        # Provider material is an explicit backup-only recovery artifact. It is
        # never installed or granted by workspace restore; controls regenerate.
        members={name:member for name,member in members.items() if name.startswith('workspaces/') or name=='workspaces'}
        for name,member in members.items():
            parts=name.split('/')
            if len(parts)>1 and parts[1] not in slugs: die('archive contains an unregistered workspace')
            if len(parts)<=2 and not member.isdir(): die('workspace archive roots must be directories')
            if not (member.isdir() or member.isreg() or member.issym() or member.islnk()):
                die('special files are not allowed in workspace archives')
        for slug in slugs:
            if 'workspaces/'+slug not in members: die('backup is missing a registered workspace home')
        for name,member in members.items():
            parts=name.split('/')
            for end in range(1,len(parts)):
                parent=members.get('/'.join(parts[:end]))
                if parent is not None and not parent.isdir(): die('archive entry descends through a file or link')
        def regular_target(name):
            visited=set(); current=name
            while True:
                if current in visited or current not in members: die('invalid archive hardlink')
                visited.add(current); member=members[current]
                if member.isreg(): return member
                if not member.islnk(): die('archive hardlink must resolve to a regular file')
                parts=archive_path(member.linkname)
                if len(parts)<3 or parts[:2]!=name.split('/')[:2]: die('archive hardlink crosses workspace boundary')
                current='/'.join(parts)
        for name,member in members.items():
            if member.islnk(): regular_target(name)
        tree=WorkspaceTree('.',home_fd=content)
        # Directories/files first, links last. All traversal uses verified
        # directory handles. Archive owners, modes and privileged metadata are
        # ignored; only ordinary executable bits survive.
        for name,member in members.items():
            relative='/'.join(name.split('/')[1:])
            if not relative: continue
            if member.isdir():
                with tree.directory(relative,create=True): pass
            elif member.isreg() or member.islnk():
                target=regular_target(name)
                path=Path(relative)
                with tree.directory(str(path.parent),create=True) as parent:
                    fd=os.open(path.name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o700 if target.mode&0o111 else 0o600,dir_fd=parent)
                    with os.fdopen(fd,'wb') as output, archive.extractfile(target) as source:
                        shutil.copyfileobj(source,output); output.flush(); os.fsync(output.fileno())
            elif member.issym():
                # Preserve repository links as data, never use their targets.
                if '\x00' in member.linkname: die('invalid archive symlink')
        for name,member in members.items():
            if member.issym():
                path=Path('/'.join(name.split('/')[1:]))
                with tree.directory(str(path.parent),create=True) as parent:
                    os.symlink(member.linkname,path.name,dir_fd=parent)
        for w in data['workspaces']:
            with tree.directory(w['slug']) as home:
                workspace=WorkspaceTree('.',home_fd=home)
                workspace.provision(payload['helper'],[p['name'] for p in w['projects']])
                workspace.check([p['name'] for p in w['projects']])
    return data

@contextmanager
def restore_input_snapshot(backup, parent):
    from contextlib import ExitStack
    with ExitStack() as stack:
        source=stack.enter_context(absolute_directory(backup,trusted=True))
        configs,_=stack.enter_context(directory_at(source,'configs'))
        outputs=[]
        for directory,name in ((source,'manifest.json'),(configs,'grave-platform.tar.gz'),(configs,'workspaces.tar.gz')):
            fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=directory)
            with os.fdopen(fd,'rb') as stream:
                info=os.fstat(stream.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_nlink!=1 or info.st_mode&0o022
                        or info.st_uid not in (0,ROOT.lstat().st_uid)):
                    die('unsafe restore input ownership, type or permissions')
                if name=='manifest.json' and info.st_size>16*1024*1024: die('backup manifest too large')
                out=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=parent)
                with os.fdopen(out,'wb') as output:
                    shutil.copyfileobj(stream,output); output.flush(); os.fsync(output.fileno())
            reader=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=parent)
            stack.callback(os.close,reader); outputs.append(reader)
        os.fsync(parent)
        yield outputs

def cmd_restore(a):
    data=load(); validate(data); check_migration_staging(); check_restore_staging()
    if any(w.get('removal') for w in data['workspaces']): die('finish pending workspace removals before restoring')
    owner=pwd.getpwuid(ROOT.lstat().st_uid)
    if owner.pw_uid==0: die('restore requires a non-root appliance owner')
    with restore_directory(create=True) as stages:
        stage='restore-'+secrets.token_hex(16)
        with directory_at(stages,stage,os.geteuid(),private=True,create=True) as (parent,_):
            os.fsync(stages)
            write_control(parent,'record.json',json.dumps({'backup':str(a.backup),'state':'validating'})+'\n')
            with restore_input_snapshot(a.backup,parent) as inputs, directory_at(parent,'content',create=True) as (content,_):
                os.fchown(content,owner.pw_uid,owner.pw_gid); os.fsync(parent)
                payload={'helper':str(Path(os.environ.get('GRAVE_AGENT_NOTIFY',ROOT/'scripts/grave-agent-notify')))}
                options={} if os.environ.get('GRAVE_WORKSPACE_TEST')=='1' else {'user':owner.pw_uid,'group':owner.pw_gid,'extra_groups':[]}
                result=subprocess.run([sys.executable,str(Path(__file__).absolute()),'__restore_extract',str(content),*map(str,inputs)],
                                      pass_fds=(content,*inputs),input=json.dumps(payload),text=True,capture_output=True,
                                      env={'PATH':'/usr/local/bin:/usr/bin:/bin','HOME':owner.pw_dir},**options)
                if result.returncode: die('workspace archive validation/extraction failed; inspect private restore staging (no homes published)')
                if result.stderr.startswith('WARNING: legacy backup has no checksums;'):
                    print('WARNING: legacy backup has no checksums; archive paths were validated',file=sys.stderr)
                recovered=restore_registry(json.loads(result.stdout))
                combined={'version':1,'workspaces':data['workspaces']+recovered['workspaces']}
                validate(combined)  # Reject identity/slug/port conflicts before creating any accounts.
                with absolute_directory(HOME_ROOT,trusted=True,create=True) as homes:
                    for w in recovered['workspaces']:
                        try: os.stat(w['slug'],dir_fd=homes,follow_symlinks=False)
                        except FileNotFoundError: pass
                        else: die('restore target already exists; existing homes are never overwritten')
                        if os.environ.get('GRAVE_WORKSPACE_TEST')!='1':
                            try: pwd.getpwnam(unix_name(w['slug']))
                            except KeyError: pass
                            else: die('restore Unix account already exists')
                    with service_directory() as services:
                        for w in recovered['workspaces']:
                            for name in (service_env(w).name,provider_link(w).name):
                                try: os.stat(name,dir_fd=services,follow_symlinks=False)
                                except FileNotFoundError: pass
                                else: die('restore service configuration already exists')
                    write_control(parent,'record.json',json.dumps({'backup':str(a.backup),'state':'publishing','workspaces':[w['slug'] for w in recovered['workspaces']]})+'\n')
                    for w in recovered['workspaces']:
                        run('useradd','--system','--no-create-home','--home-dir',str(HOME_ROOT/w['slug']),'--shell','/bin/bash',unix_name(w['slug']))
                        with directory_at(content,w['slug'],owner.pw_uid,private=True) as (home,_):
                            assign_staged_owner(home,workspace_account(w))
                        rename_exclusive(content,w['slug'],homes,w['slug']); os.fsync(content); os.fsync(homes)
                    save(combined)
                    os.environ['GRAVE_WORKSPACE_START']='0'
                    for w in recovered['workspaces']: provision(w)
            # Successful publication leaves only known private input snapshots.
            for name in ('manifest.json','grave-platform.tar.gz','workspaces.tar.gz','record.json'):
                os.unlink(name,dir_fd=parent)
            os.rmdir('content',dir_fd=parent); os.fsync(parent)
        os.rmdir(stage,dir_fd=stages); os.fsync(stages)
    audit('workspaces_restored'); print(f"restored {len(recovered['workspaces'])} workspace(s); services remain stopped until reapply")


# Backups use inherited stdout only: root never accepts a caller-selected output
# pathname, and every workspace traversal happens after exec as that workspace.
WORKSPACE_BACKUP_SECRETS={('config','secrets'),('config','gh'),('.config','gh'),
                          ('.codex','auth.json'),('.claude','.credentials.json'),('.claude.json',)}

def backup_tree(home, slug, include_secrets):
    import tarfile
    if os.geteuid()==0: die('workspace backup traversal must not run as root')
    tree=WorkspaceTree(home); tree.check(allow_missing=False)
    def header(name,info,kind):
        item=tarfile.TarInfo(name); item.type=kind; item.mtime=int(info.st_mtime)
        item.mode=0o700 if kind==tarfile.DIRTYPE or info.st_mode&0o111 else 0o600
        return item
    with tree.directory() as home_fd, tarfile.open(fileobj=sys.stdout.buffer,mode='w|') as archive:
        def walk(fd,parts):
            info=os.fstat(fd)
            archive.addfile(header('/'.join(('workspaces',slug,*parts)),info,tarfile.DIRTYPE))
            for name in sorted(os.listdir(fd)):
                relative=(*parts,name)
                if not include_secrets and relative in WORKSPACE_BACKUP_SECRETS: continue
                info=os.stat(name,dir_fd=fd,follow_symlinks=False)
                archived='/'.join(('workspaces',slug,*relative))
                if stat.S_ISLNK(info.st_mode):
                    item=header(archived,info,tarfile.SYMTYPE); item.linkname=os.readlink(name,dir_fd=fd)
                    archive.addfile(item)
                elif stat.S_ISDIR(info.st_mode):
                    with directory_at(fd,name) as (child,_): walk(child,relative)
                elif stat.S_ISREG(info.st_mode):
                    source=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=fd)
                    with os.fdopen(source,'rb') as stream:
                        before=os.fstat(stream.fileno())
                        if not stat.S_ISREG(before.st_mode): die('workspace backup file changed type')
                        item=header(archived,before,tarfile.REGTYPE); item.size=before.st_size
                        archive.addfile(item,stream)
                        after=os.fstat(stream.fileno())
                        if (before.st_size,before.st_mtime_ns,before.st_ctime_ns)!=(after.st_size,after.st_mtime_ns,after.st_ctime_ns):
                            die('workspace file changed during backup; pause writers and retry')
                elif stat.S_ISSOCK(info.st_mode): continue  # Live Unix sockets contain no recoverable file data.
                else: die('unsupported special file in workspace backup')
        walk(home_fd,())

def cmd_backup_export(a):
    import io, tarfile
    data=load(); validate(data); check_restore_staging(); check_migration_staging()
    if any(w.get('removal') for w in data['workspaces']): die('finish pending workspace removal before backup')
    registered={w['slug'] for w in data['workspaces']}
    with absolute_directory(HOME_ROOT,trusted=True,create=True) as homes:
        if set(os.listdir(homes))!=registered: die('workspace homes differ from registry; refusing incomplete backup')
    def add_bytes(archive,name,value):
        item=tarfile.TarInfo(name); item.mode=0o600; item.size=len(value)
        archive.addfile(item,io.BytesIO(value))
    with tarfile.open(fileobj=sys.stdout.buffer,mode='w|gz') as archive:
        # Kept first for cheap coverage inspection. The registry lock spans all
        # workers, so restored grants and the covered set describe this export.
        add_bytes(archive,'config/workspaces.json',(json.dumps(data,sort_keys=True)+'\n').encode())
        if a.include_secrets and (PROVIDER_SECRET.exists() or PROVIDER_SECRET.is_symlink()):
            check_manager_file(PROVIDER_SECRET)
            with absolute_directory(PROVIDER_SECRET.parent,trusted=True) as parent:
                fd=os.open(PROVIDER_SECRET.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent)
                with os.fdopen(fd,'rb') as stream:
                    info=os.fstat(stream.fileno())
                    if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or info.st_mode&0o077 or info.st_nlink!=1 or info.st_size>16384:
                        die('unsafe shared provider backup source')
                    add_bytes(archive,'config/secrets/provider.env',stream.read(16385))
        for w in data['workspaces']:
            account=workspace_account(w); home=HOME_ROOT/w['slug']
            options={} if os.environ.get('GRAVE_WORKSPACE_TEST')=='1' else {'user':account.pw_uid,'group':account.pw_gid,'extra_groups':[]}
            process=subprocess.Popen([sys.executable,str(Path(__file__).absolute()),'__backup_tree',str(home),w['slug'],str(int(a.include_secrets))],
                                     stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,
                                     env={'PATH':'/usr/local/bin:/usr/bin:/bin','HOME':str(home)},**options)
            try:
                with tarfile.open(fileobj=process.stdout,mode='r|') as source:
                    for item in source:
                        parts=archive_path(item.name)
                        if parts[:2]!=['workspaces',w['slug']] or not (item.isdir() or item.isreg() or item.issym()):
                            die('invalid workspace backup stream')
                        archive.addfile(item,source.extractfile(item) if item.isreg() else None)
                if process.wait()!=0: die(f"workspace backup failed: {w['slug']}; inspect private paths and pause writers")
            finally:
                process.stdout.close()
                if process.poll() is None: process.terminate(); process.wait()
    audit('workspaces_backed_up')

def cmd_backup_check(a):
    import hashlib
    data=load(); validate(data)
    with absolute_directory(a.backup,trusted=True) as parent:
        fd=os.open('manifest.json',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent)
        with os.fdopen(fd,'r') as source:
            info=os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size>16*1024*1024: die('unsafe backup manifest')
            manifest=json.load(source)
    coverage=manifest.get('workspace_coverage')
    digest=hashlib.sha256((json.dumps(data,sort_keys=True)+'\n').encode()).hexdigest()
    if not isinstance(coverage,dict) or coverage.get('registry_sha256')!=digest:
        die('latest backup does not cover the current workspace registry; run grave backup')
    if 'configs/workspaces.tar.gz' not in manifest.get('artifacts',{}): die('workspace backup artifact missing')
    print(f"verified backup covers {len(data['workspaces'])} workspace(s)")


def cmd_list(a):
    data=load(); validate(data)
    if a.json: print(json.dumps(data["workspaces"], indent=2)); return
    print("SLUG\tROLE\tSTATE\tLOGIN\tTAILSCALE ID")
    for w in data["workspaces"]: print(f"{w['slug']}\t{w['role']}\t{'enabled' if w['enabled'] else 'disabled'}\t{w['login']}\t{w['id']}")
def cmd_status(a):
    data=load(); validate(data); rows=[]
    for w in data["workspaces"]:
        home=HOME_ROOT/w["slug"]; size=sum(p.stat().st_size for p in home.rglob("*") if p.is_file()) if home.exists() else 0
        services={}
        for kind in ("t3","term","dashboard"):
            if os.environ.get("GRAVE_WORKSPACE_TEST")=="1": services[kind]="test"
            else: services[kind]="active" if subprocess.run(["systemctl","is-active","--quiet",f"gravedecay-{kind}@{w['slug']}"],check=False).returncode==0 else "inactive"
        rows.append({"slug":w["slug"],"enabled":w["enabled"],"bytes":size,"services":services,"projects":len(w["projects"]),"llm":w["provider"]["llm"],"removal_pending":bool(w.get('removal'))})
    print(json.dumps(rows,indent=2))

def cmd_inspect(a):
    data=load(); validate(data); print(json.dumps(find(data,a.workspace,allow_removal=True),indent=2,sort_keys=True))
def cmd_disable(a):
    data=load(); w=find(data,a.workspace); w["enabled"]=False; save(data)
    run("systemctl","disable","--now",f"gravedecay-t3@{w['slug']}.service",f"gravedecay-term@{w['slug']}.service",f"gravedecay-dashboard@{w['slug']}.service")
    audit("workspace_disabled",w["slug"]); print(f"disabled {w['slug']}")
def cmd_doctor(a):
    data=load(); validate(data)
    pending=[w['slug'] for w in data['workspaces'] if w.get('removal')]
    if pending: die('workspace removal pending; retry confirmed remove for: '+', '.join(pending))
    check_removal_archives()
    check_restore_staging()
    check_migration_staging()
    checkout_paths=set()
    if os.environ.get("GRAVE_WORKSPACE_TEST") != "1" and (not SERVICE_ROOT.is_dir() or SERVICE_ROOT.stat().st_uid!=0 or SERVICE_ROOT.stat().st_mode&0o077): die("workspace service directory ownership drift")
    registered={w["slug"] for w in data["workspaces"]}
    if HOME_ROOT.exists():
        orphan_dirs={p.name for p in HOME_ROOT.iterdir() if p.is_dir()}-registered
        if orphan_dirs: die("orphaned workspace directories: "+", ".join(sorted(orphan_dirs)))
    if os.environ.get("GRAVE_WORKSPACE_TEST") != "1":
        try: tail_users=json.loads(subprocess.check_output(["tailscale","status","--json"],text=True))["User"]
        except Exception: die("cannot verify Tailscale identities")
        missing_ids=[w["id"] for w in data["workspaces"] if w["id"].removeprefix("ts:") not in tail_users]
        if missing_ids: die("Tailscale identity missing: "+", ".join(missing_ids))
        orphan_users={entry.pw_name.removeprefix("grave-") for entry in pwd.getpwall() if entry.pw_name.startswith("grave-")}-registered
        if orphan_users: die("orphaned workspace users: "+", ".join(sorted(orphan_users)))
    entitled=any(w["provider"]["llm"] for w in data["workspaces"])
    if entitled and not PROVIDER_SECRET.is_file(): die("shared provider is required by an entitled workspace")
    if PROVIDER_SECRET.exists() or PROVIDER_SECRET.is_symlink(): check_manager_file(PROVIDER_SECRET)
    for w in data["workspaces"]:
        home=HOME_ROOT/w["slug"]
        tree_command(w,'check')
        check_manager_file(service_env(w))
        for kind in ("linear","activity"): check_personal_credentials(w,kind)
        linked=check_manager_file(provider_link(w),optional=True,provider_reference=True)
        if linked != bool(w["provider"]["llm"] and PROVIDER_SECRET.exists()): die(f"provider entitlement drift: {w['slug']}")
        if os.environ.get("GRAVE_WORKSPACE_TEST") != "1":
            try: account=pwd.getpwnam(unix_name(w["slug"]))
            except KeyError: die(f"missing Unix account: {w['slug']}")
            if account.pw_uid == 0 or account.pw_dir != str(home): die(f"unsafe account: {w['slug']}")
            if not home.is_dir() or home.stat().st_uid != account.pw_uid or home.stat().st_mode & 0o077:
                die(f"ownership or mode drift: {w['slug']}")
            env_file=service_env(w)
            if env_file.stat().st_uid != 0 or env_file.stat().st_mode & 0o077: die(f"unsafe service environment: {w['slug']}")
            token=next((line.partition("=")[2].strip().strip('"') for line in env_file.read_text().splitlines() if line.startswith("GRAVEDECAY_BACKEND_TOKEN=")),"")
            if len(token) < 32: die(f"missing backend capability: {w['slug']}")
            for project in w["projects"]:
                checkout=home/"repos"/project["name"]
                if checkout.is_symlink() or not checkout.is_dir() or checkout.stat().st_uid != account.pw_uid: die(f"project ownership drift: {w['slug']}/{project['name']}")
                resolved=checkout.resolve()
                if resolved in checkout_paths: die("unsafe shared writable checkout")
                checkout_paths.add(resolved)
            for unit in ("gravedecay-t3","gravedecay-term","gravedecay-dashboard"):
                check_unit_credentials(w,f"{unit}@{w['slug']}.service",unit)
                enabled=subprocess.run(["systemctl","is-enabled",f"{unit}@{w['slug']}.service"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0
                if enabled != w["enabled"]: die(f"service enablement drift: {unit}@{w['slug']}")
                instance=f"{unit}@{w['slug']}.service"
                active=subprocess.run(["systemctl","is-active","--quiet",instance]).returncode==0
                if active:
                    user=subprocess.check_output(["systemctl","show","-p","User","--value",instance],text=True).strip()
                    if unit == "gravedecay-term":
                        pid=subprocess.check_output(["systemctl","show","-p","MainPID","--value",instance],text=True).strip()
                        try:
                            args=Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0") if pid.isdecimal() and int(pid)>0 else []
                        except OSError:
                            args=[]
                        if b"--check-origin" not in args: die(f"terminal origin validation missing: {instance}")
                    if user != unix_name(w["slug"]): die(f"service identity drift: {instance}")
            for kind,port in w["ports"].items():
                listeners=subprocess.run(["ss","-H","-ltn",f"sport = :{port}"],capture_output=True,text=True).stdout
                if listeners and not loopback_listeners(listeners):
                    die(f"non-loopback workspace listener: {w['slug']}/{kind} ({listeners.strip()})")
    print(f"ok: {len(data['workspaces'])} workspace(s)")
# Archiving never recursively traverses workspace content as root. Completed
# removal archives stay behind root-owned private directories even if a UID is reused.
@contextmanager
def removal_archives(create=False):
    with absolute_directory(ROOT/'backups',trusted=True,create=create) as backups:
        with directory_at(backups,'removed-workspaces',os.geteuid(),private=True,create=create) as (fd,_):
            yield fd

def check_removal_archives():
    try:
        with removal_archives() as archives:
            for name in os.listdir(archives):
                with directory_at(archives,name,os.geteuid(),private=True) as (entry,_):
                    with directory_at(entry,'home') as (home,_):
                        if os.fstat(home).st_mode & 0o077: die('unsafe retained workspace home permissions')
    except FileNotFoundError:
        # An absent archive root is normal; missing content in an existing
        # archive is not (checked separately to avoid swallowing that error).
        if (ROOT/'backups/removed-workspaces').exists(): die('incomplete workspace removal archive')

def removal_account(w, receipt=None):
    try: account=workspace_account(w)
    except KeyError:
        if receipt: return None  # retry after userdel succeeded but registry save did not
        die(f"missing Unix account: {w['slug']}")
    if receipt and (account.pw_uid,account.pw_gid)!=(receipt['uid'],receipt['gid']):
        die('workspace account changed during removal')
    return account

def retained_identity(parent, name, receipt):
    with directory_at(parent,name,receipt['uid'],private=True) as (fd,_):
        info=os.fstat(fd)
        if (info.st_dev,info.st_ino)!=(receipt['device'],receipt['inode']):
            die('workspace removal identity drift')

def archive_workspace(data, w):
    receipt=w.get('removal')
    account=removal_account(w,receipt)
    with absolute_directory(HOME_ROOT,trusted=True) as homes, removal_archives(create=True) as archives:
        if receipt is None:
            with directory_at(homes,w['slug'],account.pw_uid,private=True) as (home,_):
                info=os.fstat(home)
                if info.st_dev!=os.fstat(archives).st_dev:
                    die('workspace removal archive must share the home filesystem; no data moved')
                name=w['slug']+'-'+secrets.token_hex(16)
                receipt={'archive':name,'uid':account.pw_uid,'gid':account.pw_gid,
                         'device':info.st_dev,'inode':info.st_ino}
            try: os.stat(name,dir_fd=archives,follow_symlinks=False)
            except FileNotFoundError: pass
            else: die('workspace removal archive already exists')
            # Durable intent lets retries distinguish a completed rename from an
            # unrelated pre-existing archive; keep the registry entry until userdel.
            w['removal']=receipt
            save(data)
        name=receipt['archive']
        with directory_at(archives,name,os.geteuid(),private=True,create=True) as (target,_):
            os.fsync(archives)
            try: source=os.stat(w['slug'],dir_fd=homes,follow_symlinks=False)
            except FileNotFoundError: source=None
            if source is not None:
                if account is None: die('workspace home exists without its removal account')
                retained_identity(homes,w['slug'],receipt)
                try: os.stat('home',dir_fd=target,follow_symlinks=False)
                except FileNotFoundError: pass
                else: die('both source and archive exist; refusing to overwrite retained data')
                # Both parents are administrator-controlled. No unprivileged
                # process can substitute this source/destination directory entry.
                os.rename(w['slug'],'home',src_dir_fd=homes,dst_dir_fd=target)
                os.fsync(homes); os.fsync(target)
            retained_identity(target,'home',receipt)
            os.fsync(homes); os.fsync(target)
    return ROOT/'backups/removed-workspaces'/name/'home',account

def cmd_remove(a):
    if a.confirm != a.workspace: die("destructive removal requires --confirm WORKSPACE")
    data=load(); validate(data); w=find(data,a.workspace,allow_removal=True)
    if w['enabled']: die('disable workspace before removal')
    run('systemctl','disable','--now',f"gravedecay-t3@{w['slug']}.service",f"gravedecay-term@{w['slug']}.service",f"gravedecay-dashboard@{w['slug']}.service")
    archive,account=archive_workspace(data,w)
    with service_directory() as parent:
        for path in (service_env(w),provider_link(w)):
            try: os.unlink(path.name,dir_fd=parent)
            except FileNotFoundError: pass
        os.fsync(parent)
    if account is not None: run('userdel',unix_name(w['slug']))
    data['workspaces'].remove(w); save(data)
    audit('workspace_removed',w['slug'],str(archive))
    print(f"removed {w['slug']}; retained at {archive}")

def valid_remote(url):
    return (url.startswith("https://") or url.startswith("ssh://") or re.fullmatch(r"git@[^: ]+:[^ ]+",url)) and "\n" not in url
def cmd_grant(a):
    if not PROJECT.fullmatch(a.name): die("unsafe project name")
    if not valid_remote(a.url): die("remote must use HTTPS or SSH")
    data=load(); w=find(data,a.workspace)
    existing=[p for p in w["projects"] if p["name"]==a.name]
    if existing:
        if existing[0]["url"] != a.url: die("project name already granted with another remote")
        print(f"unchanged {w['slug']}/{a.name}"); return
    dest=HOME_ROOT/w["slug"]/"repos"/a.name
    if dest.exists(): die("unmanaged destination already exists")
    if os.environ.get("GRAVE_WORKSPACE_TEST") == "1": dest.mkdir(parents=True)
    else: as_user(w,"git","clone","--",a.url,str(dest))
    w["projects"].append({"name":a.name,"url":a.url}); save(data); audit("project_granted",w["slug"],a.name); print(f"granted {w['slug']}/{a.name}")
def cmd_revoke(a):
    if not PROJECT.fullmatch(a.name): die('unsafe project name')
    data=load(); validate(data); w=find(data,a.workspace)
    matches=[p for p in w['projects'] if p['name']==a.name]
    if not matches: print(f"unchanged {w['slug']}/{a.name}"); return
    retained=tree_command(w,'revoke',name=a.name)
    if retained and not re.fullmatch(re.escape(a.name)+r'-[0-9]{8}-[0-9]{6}-[0-9a-f]{16}',retained):
        die('invalid retained project path')
    w['projects'].remove(matches[0]); save(data); audit('project_revoked',w['slug'],a.name)
    location=str(HOME_ROOT/w['slug']/'revoked'/retained) if retained else 'checkout already absent'
    print(f"revoked {w['slug']}/{a.name}; retained at {location}")
def cmd_git_config(a):
    data=load(); w=find(data,a.workspace)
    as_user(w,"git","config","--global","user.name",a.name)
    as_user(w,"git","config","--global","user.email",a.email)
    if a.signing_key:
        as_user(w,"git","config","--global","user.signingkey",a.signing_key)
        as_user(w,"git","config","--global","commit.gpgsign","true")
    print(f"configured Git identity for {w['slug']}")
def cmd_projects(a):
    data=load(); w=find(data,a.workspace); print(json.dumps(w["projects"],indent=2))
def cmd_adopt(a):
    if not PROJECT.fullmatch(a.name) or not valid_remote(a.url): die("invalid adopted project")
    data=load(); w=find(data,a.workspace); dest=HOME_ROOT/w["slug"]/"repos"/a.name
    if not dest.is_dir(): die("adopted checkout does not exist")
    matches=[p for p in w["projects"] if p["name"]==a.name]
    if matches:
        if matches[0]["url"]!=a.url: die("adopted project remote mismatch")
        return
    w["projects"].append({"name":a.name,"url":a.url}); save(data); audit("project_adopted",w["slug"],a.name)
def credential_command(w, action, kind=None, value=None):
    helper=ROOT/"scripts/workspace-env.py"
    home=HOME_ROOT/w["slug"]
    command=["python3",str(helper),action,str(home)] + ([kind] if kind else [])
    env={"PATH":"/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin", "HOME":str(home), "XDG_CONFIG_HOME":str(home/"config")}
    if os.environ.get("GRAVE_WORKSPACE_TEST") == "1":
        command[0]=sys.executable
        command[1]=str(Path(__file__).resolve().parents[1]/"libexec/workspace-env.py")
    else:
        command=["runuser","-u",unix_name(w["slug"]),"--",*command]
    return subprocess.run(command,input=value,capture_output=True,text=True,env=env,check=False)

def check_personal_credentials(w, kind):
    result=credential_command(w,"check",kind)
    if result.returncode: die(f"unsafe {kind} credentials: {w['slug']}; check private paths and allowed fields")
    return result.stdout.strip()=="configured"

def check_manager_file(path, optional=False, provider_reference=False):
    """PID 1 inputs must stay outside collaborator-controlled directories.

    The appliance owner is a trusted administrator. The one permitted link is
    the root-created entitlement reference to the exact shared provider file.
    """
    expected_uid=os.geteuid() if os.environ.get("GRAVE_WORKSPACE_TEST")=="1" else 0
    trusted={0,expected_uid,ROOT.stat().st_uid}
    for parent in reversed(path.parents):
        info=parent.lstat()
        sticky_root=info.st_uid==0 and info.st_mode & stat.S_ISVTX
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid not in trusted
                or (info.st_mode & 0o022 and not sticky_root)):
            die("unsafe service credential directory: "+str(parent))
    try: info=path.lstat()
    except FileNotFoundError:
        if optional: return False
        die("missing service credential source: "+str(path))
    if provider_reference:
        if not stat.S_ISLNK(info.st_mode): die("provider entitlement must reference the shared provider file")
        if info.st_uid != expected_uid or os.readlink(path) != str(PROVIDER_SECRET):
            die("unsafe provider entitlement reference")
        return check_manager_file(PROVIDER_SECRET)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != expected_uid
            or info.st_mode & 0o077 or info.st_nlink != 1):
        die("unsafe service credential source: "+str(path))
    return True

def check_unit_credentials(w, instance, kind):
    expected=[f"{service_env(w)} (ignore_errors=no)"]
    if kind=="gravedecay-t3": expected.append(f"{provider_link(w)} (ignore_errors=yes)")
    actual=subprocess.check_output(["systemctl","show","-p","EnvironmentFiles","--value",instance],text=True).splitlines()
    if actual != expected: die(f"unsafe service EnvironmentFiles: {instance}; re-raise to replace legacy units/drop-ins")
    command=subprocess.check_output(["systemctl","show","-p","ExecStart","--value",instance],text=True)
    profile="activity" if kind=="gravedecay-dashboard" else "linear"
    required=f"{ROOT}/scripts/workspace-env.py exec {HOME_ROOT/w['slug']} {profile} "
    if required not in command: die(f"workspace credential loader missing: {instance}; re-raise")

def cmd_integration_status(a):
    data=load(); w=find(data,a.workspace)
    linear=check_personal_credentials(w,"linear")
    github=as_user_result(w,"gh","auth","status","--hostname","github.com",check=False,capture=True).returncode==0 if shutil.which("gh") else False
    print(json.dumps({"workspace":w["slug"],"github":"configured" if github else "onboarding","linear":"configured" if linear else "onboarding"}))
def cmd_github_login(a):
    data=load(); w=find(data,a.workspace); as_user_result(w,"gh","auth","login","--hostname","github.com","--git-protocol","ssh","--web"); audit("integration_login",w["slug"],"github"); print(f"GitHub configured for {w['slug']}")
def cmd_github_logout(a):
    data=load(); w=find(data,a.workspace); as_user_result(w,"gh","auth","logout","--hostname","github.com","--user",a.user); audit("integration_logout",w["slug"],"github"); print(f"GitHub login removed for {w['slug']}")
def cmd_linear_set(a):
    data=load(); w=find(data,a.workspace); value=sys.stdin.readline(8193).strip()
    result=credential_command(w,"write-linear",value=value)
    if result.returncode: die(f"cannot set Linear credentials: {w['slug']}; check key and private paths")
    if os.environ.get("GRAVE_WORKSPACE_TEST") != "1":
        as_user_result(w,"codex","mcp","remove","linear",check=False)
        as_user_result(w,"codex","mcp","add","linear","--url","https://mcp.linear.app/mcp","--bearer-token-env-var","LINEAR_API_KEY")
        as_user_result(w,"claude","mcp","remove","--scope","user","linear",check=False)
        as_user_result(w,"claude","mcp","add","--transport","http","--scope","user","linear","https://mcp.linear.app/mcp","--header","Authorization: Bearer ${LINEAR_API_KEY}")
        run("systemctl","restart",f"gravedecay-t3@{w['slug']}",f"gravedecay-term@{w['slug']}",f"gravedecay-dashboard@{w['slug']}")
    audit("integration_login",w["slug"],"linear"); print(f"Linear configured for {w['slug']}")
def cmd_linear_logout(a):
    data=load(); w=find(data,a.workspace)
    result=credential_command(w,"delete-linear")
    if result.returncode: die(f"cannot remove Linear credentials: {w['slug']}; check private paths")
    if os.environ.get("GRAVE_WORKSPACE_TEST") != "1":
        as_user_result(w,"codex","mcp","remove","linear",check=False); as_user_result(w,"claude","mcp","remove","--scope","user","linear",check=False)
        run("systemctl","restart",f"gravedecay-t3@{w['slug']}",f"gravedecay-term@{w['slug']}",f"gravedecay-dashboard@{w['slug']}")
    audit("integration_logout",w["slug"],"linear"); print(f"Linear login removed for {w['slug']}")
def cmd_provider_set(a):
    lines=[line.strip() for line in sys.stdin if line.strip()]
    parsed=[]
    for line in lines:
        name,sep,value=line.partition("=")
        if not sep or name not in PROVIDER_NAMES or len(value)<20 or any(c.isspace() for c in value): die("provider input must be OPENAI_API_KEY=... or ANTHROPIC_API_KEY=...")
        parsed.append((name,value))
    if not parsed or len({name for name,_ in parsed}) != len(parsed): die("provider input is empty or duplicated")
    PROVIDER_SECRET.parent.mkdir(parents=True,exist_ok=True)
    fd=os.open(PROVIDER_SECRET,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
    try:
        os.write(fd,"".join(f"{name}={value}\n" for name,value in parsed).encode()); os.fchmod(fd,0o600)
        if os.environ.get("GRAVE_WORKSPACE_TEST") != "1": os.fchown(fd,0,0)
    finally: os.close(fd)
    data=load()
    for w in data["workspaces"]: sync_provider(w)
    if os.environ.get("GRAVE_WORKSPACE_TEST") != "1":
        for w in data["workspaces"]:
            if w["enabled"] and w["provider"]["llm"]: run("systemctl","restart",f"gravedecay-t3@{w['slug']}")
    print(f"shared provider configured ({', '.join(name for name,_ in parsed)})")
def cmd_provider_policy(a):
    data=load(); w=find(data,a.workspace); enabled=a.policy=="grant"
    w["provider"]["llm"]=enabled; save(data); sync_provider(w)
    if os.environ.get("GRAVE_WORKSPACE_TEST") != "1": run("systemctl","restart",f"gravedecay-t3@{w['slug']}")
    audit("provider_policy_changed",w["slug"],result=a.policy); print(f"shared provider {'granted to' if enabled else 'revoked from'} {w['slug']}")
def cmd_reapply(a):
    check_restore_staging()
    if a.t3_bin: os.environ["GRAVE_T3_BIN"]=a.t3_bin
    if a.ttyd_bin: os.environ["GRAVE_TTYD_BIN"]=a.ttyd_bin
    if a.tool_path is not None: os.environ["GRAVE_TOOL_PATH"]=a.tool_path
    if a.grave_bin: os.environ["GRAVE_BIN"]=a.grave_bin
    data=load(); validate(data)
    if os.environ.get("SUDO_UID"): os.chown(REGISTRY,int(os.environ["SUDO_UID"]),int(os.environ.get("SUDO_GID","0")))
    for w in data["workspaces"]: provision(w)
    print(f"reapplied {len(data['workspaces'])} workspace(s)")
def cmd_provider_status(a):
    data=load(); configured=PROVIDER_SECRET.is_file() and not PROVIDER_SECRET.stat().st_mode&0o077
    print(json.dumps({"configured":configured,"workspaces":[{"slug":w["slug"],"llm":w["provider"]["llm"]} for w in data["workspaces"]]}))

def main():
    p=argparse.ArgumentParser(prog="grave users"); s=p.add_subparsers(required=True)
    q=s.add_parser("list"); q.add_argument("--json",action="store_true"); q.set_defaults(fn=cmd_list)
    q=s.add_parser("status"); q.set_defaults(fn=cmd_status)
    q=s.add_parser("add"); q.add_argument("identity"); q.add_argument("login"); q.add_argument("slug"); q.add_argument("--role",choices=sorted(ROLES),default="developer"); q.add_argument("--no-llm",dest="llm",action="store_false",default=True); q.set_defaults(fn=cmd_add)
