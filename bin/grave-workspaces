    lock=REGISTRY.with_suffix(".lock")
    with lock.open("a") as f: fcntl.flock(f,fcntl.LOCK_EX); a.fn(a)
if __name__ == "__main__":
    try:
        if len(sys.argv)>1 and sys.argv[1]=='__backup_tree':
            backup_tree(sys.argv[2],sys.argv[3],sys.argv[4]=='1')
        elif len(sys.argv)>1 and sys.argv[1]=='__restore_extract':
            print(json.dumps(extract_workspace_backup(int(sys.argv[2]),list(map(int,sys.argv[3:])),json.load(sys.stdin))))
        elif len(sys.argv)>1 and sys.argv[1]=='__migration_copy':
            print(json.dumps(copy_owner_state(int(sys.argv[2]),json.load(sys.stdin))))
        elif len(sys.argv)>1 and sys.argv[1]=='__tree':
            if os.geteuid()==0: die("workspace content operations must not run as root")
            _,_,action,home=sys.argv
            tree=WorkspaceTree(home); payload=json.load(sys.stdin)
            if action=='provision': tree.provision(payload['helper'],payload['projects'])
            elif action=='check': tree.check(payload['projects'])
            elif action=='revoke': print(tree.revoke(payload['name']) or '')
            else: die("invalid workspace tree operation")
        else: main()
    except (OSError,UnicodeError,tarfile.TarError) as exc:
        die(f"workspace path unavailable or unsafe ({type(exc).__name__}); inspect ownership and symlinks")
