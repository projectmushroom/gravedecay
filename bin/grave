#!/usr/bin/env bash
# grave — unified control tool for a gravedecay appliance.
# Docs: $GRAVE_ROOT/docs (or the gravedecay repo)   Config: /etc/gravedecay/grave.conf
set -euo pipefail

CONF="${GRAVE_CONF:-/etc/gravedecay/grave.conf}"
[[ -r "$CONF" ]] || { echo "grave: config not found at $CONF (run raise.sh first)"; exit 1; }
# shellcheck disable=SC1090
source "$CONF"

# On a managed-toolchain host (Homebrew + rootless docker under $HOME) the tools
# grave shells out to — docker, tailscale, tmux — aren't on a bare login PATH.
# TOOL_PATH (set by raise.sh; empty on package-manager hosts) makes grave
# self-sufficient regardless of how it was invoked.
[[ -n "${TOOL_PATH:-}" ]] && export PATH="$TOOL_PATH$PATH"

# Tailnet port range for `grave preview` (dev-server tunnels), and any platform
# ports that fall inside it and must never be exposed (Playwright is on 3050).
# Defaults here so installs whose grave.conf predates the feature still work;
# documented in docs/PORTS.md and grave.conf.example.
: "${PREVIEW_RANGE:=3000-3999}"
: "${PREVIEW_RESERVED:=3050}"
: "${MULTI_USER:=0}"

# Doctor fails when the newest verified backup is older than this (#112).
# Default here so installs whose grave.conf predates the feature still work;
# documented in docs/RECOVERY.md and grave.conf.example.
: "${BACKUP_MAX_AGE_DAYS:=2}"

# Event classes allowed to page the human via `grave notify --event` (#78).
# Default here so installs whose grave.conf predates the feature still work;
# documented in docs/NOTIFICATIONS.md and grave.conf.example. The dashboard's
# ⚙️ checkboxes write an override file (it runs unprivileged and must not need
# sudo for a notification preference — same reasoning as the gamewatch flag),
# which wins over the conf value when present.
: "${NOTIFY_EVENTS:=session-exit bell agent-done unit-failure doctor digest}"
[[ -r "$GRAVE_ROOT/config/notify-events" ]] && NOTIFY_EVENTS="$(<"$GRAVE_ROOT/config/notify-events")"

LOG_FILE="$GRAVE_ROOT/logs/grave.log"
NOTIFY_ENV="$GRAVE_ROOT/config/secrets/notify.env"
T3_ACTIVITY_ENV="$GRAVE_ROOT/config/secrets/t3-activity.env"
PUSH_SUBS="$GRAVE_ROOT/config/push-subscriptions.json"
AGENT_NOTIFY="$GRAVE_ROOT/scripts/grave-agent-notify"
GAMEWATCH_PREFERENCE="$GRAVE_ROOT/config/gamewatch.preference"
AUTO_THAW_UNIT="gravedecay-auto-thaw"
AUTO_THAW_TIMER="$AUTO_THAW_UNIT.timer"
RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'; BLD=$'\e[1m'; RST=$'\e[0m'

log() { { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"; } 2>/dev/null || true; }
say() { printf '%s\n' "$*"; }
ok()  { printf '  %b✓%b %s\n' "$GRN" "$RST" "$*"; }
bad() { printf '  %b✗%b %s\n' "$RED" "$RST" "$*"; }
hdr() { printf '\n%b%s%b\n' "$BLD" "$*" "$RST"; }

need_root_helper() { [[ $EUID == 0 ]] && return; sudo -n systemctl --version >/dev/null 2>&1 || { say "grave needs passwordless sudo for this (see docs/SECURITY.md)"; exit 1; }; }

tmuxa() { tmux -L "$TMUX_SOCKET" "$@"; }
workspace_services() {
  [[ "${MULTI_USER:-0}" == 1 && -r "$GRAVE_ROOT/config/workspaces.json" ]] || return 0
  jq -r '.workspaces[] | select(.enabled) | .slug' "$GRAVE_ROOT/config/workspaces.json" | while read -r slug; do
    printf '%s\n' "gravedecay-t3@$slug" "gravedecay-term@$slug" "gravedecay-dashboard@$slug"
  done
}

# Container engine: rootless Docker (per-user, no sudo — durable on immutable
# hosts like SteamOS) vs system Docker (sudo). dk = the docker CLI, dkctl =
# how we manage the docker unit (per-user vs system systemd). Everything else
# in grave calls these two, so the sudo/rootless split lives in one place.
if [[ "${DOCKER_ROOTLESS:-0}" == 1 ]]; then
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  [[ -n "${DOCKER_HOST:-}" ]] && export DOCKER_HOST
  _DOCKER=(docker);      _DKCTL=(systemctl --user)
else
  _DOCKER=(sudo docker); _DKCTL=(sudo systemctl)
fi
dk()    { "${_DOCKER[@]}" "$@"; }
dkctl() { "${_DKCTL[@]}"  "$@"; }

compose() { # compose <stack> <args...>
  local stack="$1"; shift
  dk compose --project-directory "$GRAVE_ROOT/docker/$stack" "$@"
}

mem_available_mib() { awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo; }

auto_thaw_active() {
  systemctl is-active --quiet "$AUTO_THAW_TIMER"
}

cancel_auto_thaw() {
  auto_thaw_active || return 0
  need_root_helper
  sudo systemctl stop "$AUTO_THAW_TIMER" >/dev/null 2>&1 || true
  ok "cancelled pending gaming auto-thaw"
}

valid_auto_thaw_duration() {
  if systemd-analyze --help 2>/dev/null | grep -qw timespan; then
    systemd-analyze timespan "$1" >/dev/null 2>&1
  else
    # systemd 228 lacks the parser command. Accept the documented duration
    # subset here; systemd-run still performs the final timer validation.
    [[ "$1" =~ ^([0-9]+([.][0-9]+)?(ms|s|min|m|h|d|w))+$ ]]
  fi
}

schedule_auto_thaw() { # schedule_auto_thaw <systemd timespan, e.g. 2h or 90m>
  local duration="$1" grave_bin
  valid_auto_thaw_duration "$duration" \
    || { bad "invalid --for duration '$duration' (examples: 30m, 2h, 1h30m)"; exit 1; }
  command -v systemd-run >/dev/null 2>&1 \
    || { bad "systemd-run is required for --for"; exit 1; }
  need_root_helper
  grave_bin="$(readlink -f "$0")"
  # Re-enter the already-authorized grave root helper instead of broadening the
  # sudoers surface to systemd-run. Existing boxes can use --for immediately
  # after a headless upgrade, even before their next interactive sudoers refresh.
  sudo -n "$grave_bin" __auto-thaw schedule "$duration"
}

cmd_auto_thaw_root() { # root-only helper: cmd_auto_thaw_root schedule <timespan>
  [[ $EUID == 0 ]] || { bad "auto-thaw root helper must run through sudo"; exit 1; }
  local sub="${1:-}" duration="${2:-}" uid="${SUDO_UID:-}" gid="${SUDO_GID:-}"
  [[ "$sub" == schedule && "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ ]] \
    || { bad "invalid auto-thaw helper invocation"; exit 1; }
  valid_auto_thaw_duration "$duration" \
    || { bad "invalid auto-thaw duration"; exit 1; }
  local user home grave_bin
  user="$(getent passwd "$uid" | cut -d: -f1)"
  home="$(getent passwd "$uid" | cut -d: -f6)"
  [[ -n "$user" && -n "$home" ]] || { bad "cannot resolve auto-thaw owner"; exit 1; }
  grave_bin="$(readlink -f "$0")"
  # A system transient timer survives the invoking shell/dashboard request. The
  # service itself runs as the appliance owner so rootless Docker and the user
  # tmux session are restored in the same context as an interactive command.
  local run_args=(--quiet)
  # systemd 228 (Leap 42.3) predates --collect. Successful transient units
  # are still garbage-collected by the manager without this option.
  systemd-run --help | grep -q -- --collect && run_args+=(--collect)
  /usr/bin/systemd-run "${run_args[@]}" \
    --unit="$AUTO_THAW_UNIT" --on-active="$duration" \
    --timer-property=AccuracySec=1s \
    --description="Restore gravedecay developer mode after gaming" \
    --uid="$uid" --gid="$gid" --setenv="HOME=$home" \
    --setenv="USER=$user" --setenv="LOGNAME=$user" \
    "$grave_bin" developer
  ok "auto-thaw scheduled in $duration"
}

pkg_mgr() {
  if command -v pacman >/dev/null; then echo pacman
  elif command -v zypper >/dev/null; then echo zypper
  elif command -v apt-get >/dev/null; then echo apt
  elif command -v dnf >/dev/null; then echo dnf
  else echo none; fi
}

t3_version() {
  t3 --version 2>/dev/null | sed -n 's/^t3 v//p' | head -1
}

t3_latest_version() {
  npm view t3 dist-tags.latest --silent 2>/dev/null | tail -1
}

# ------------------------------------------------------------- t3 connect ----
# T3 Connect (upstream's managed relay) state is scoped per T3 data dir, so
# everything here pins --base-dir to the appliance instance: a bare `t3` run
# or the desktop app links the DEFAULT profile (~/.t3) instead — a second
# Connect identity this box's contract doesn't cover (doctor warns on those).
T3_BASE_DIR="${T3_BASE_DIR:-$GRAVE_ROOT/agents/t3code}"
# Operator's declared mode, same file-flag pattern as gamewatch/keepalive.
#   off      — no Connect link (tailnet-only box; absent file means this)
#   publish  — link WITHOUT the managed tunnel: agent activity (push, Live
#              Activities) reaches the official mobile apps, transport stays
#              the tailnet
#   full     — managed relay tunnel; official apps reach the box with no VPN
T3_CONNECT_MODE_FILE="$GRAVE_ROOT/config/t3-connect.mode"

t3_connect_mode() {
  local m=off
  [[ -r "$T3_CONNECT_MODE_FILE" ]] && m="$(tr -d '[:space:]' <"$T3_CONNECT_MODE_FILE")"
  case "$m" in publish|full) printf '%s\n' "$m" ;; *) printf 'off\n' ;; esac
}

t3_owner() {
  local owner
  owner=$(systemctl show -p User t3code 2>/dev/null | sed -n 's/^User=//p')
  [[ -n "$owner" ]] && getent passwd "$owner" >/dev/null || {
    echo "Cannot resolve t3code service user; run raise.sh first." >&2
    return 1
  }
  printf '%s\n' "$owner"
}

t3_owner_run() { # run with the same Unix identity and home as t3code.service
  local owner record owner_uid owner_home owner_path
  owner=$(t3_owner) || return
  record=$(getent passwd "$owner") || return
  owner_uid=$(cut -d: -f3 <<<"$record")
  owner_home=$(cut -d: -f6 <<<"$record")
  owner_path="$owner_home/.local/bin:${TOOL_PATH:-}/usr/local/bin:/usr/bin:/bin"
  if [[ "$EUID" == "$owner_uid" ]]; then
    env HOME="$owner_home" USER="$owner" LOGNAME="$owner" PATH="$owner_path" "$@"
  elif [[ "$EUID" == 0 ]]; then
    sudo -n -H -u "$owner" env HOME="$owner_home" USER="$owner" LOGNAME="$owner" PATH="$owner_path" "$@"
  else
    echo "Run this command as $owner (the t3code service user)." >&2
    return 1
  fi
}

t3_connect_files_ok() {
  # Root's ability to read mode-600 files says nothing about the service.
  # Probe as its actual user and do not expose any secret contents.
  t3_owner_run bash -c '
    shopt -s nullglob
    for file in "$1"/userdata/secrets/cloud-*.bin "$1"/userdata/secrets/relay-*.bin; do
      [[ -r "$file" && -w "$file" && $(stat -c %a "$file") == 600 ]] || exit 1
    done
    [[ ! -d "$1/userdata/secrets" || ( -r "$1/userdata/secrets" && -x "$1/userdata/secrets" && -w "$1/userdata/secrets" ) ]]
  ' bash "$T3_BASE_DIR"
}

t3_connect_set_mode() {
  t3_owner_run bash -c 'mkdir -p "$(dirname "$1")"; printf "%s\n" "$2" >"$1"' bash "$T3_CONNECT_MODE_FILE" "$1"
}

t3_connect_json() { # persisted Connect state of the appliance instance
  t3_owner_run t3 connect status --json --base-dir "$T3_BASE_DIR" 2>/dev/null
}

t3c_is() { # t3c_is <jq bool expr> <json> — predicate for doctor checks
  jq -e "$1" <<<"$2" >/dev/null 2>&1
}

t3_connect_restart() { # apply a link-state change to the running service
  if systemctl is-active --quiet t3code; then
    need_root_helper
    sudo -n systemctl restart t3code
    # A new full link performs relay reconciliation before T3 is ready and can
    # take 10+ seconds. curl's --retry does not retry connection-refused unless
    # explicitly requested, so the old single call failed immediately while
    # the healthy service was still starting.
    local i
    for i in $(seq 1 30); do
      if curl -sf --max-time 2 -o /dev/null "http://127.0.0.1:$T3_PORT/"; then
        ok "t3code restarted — Connect link state applies from this start"
        return 0
      fi
      sleep 1
    done
    bad "t3code did not answer after restart"; exit 1
  else
    say "  t3code is stopped (gaming mode?) — the change applies on its next start"
  fi
}

cmd_t3_connect() { # grave t3 connect [status|diagnose|publish|full|off]
  local want="${1:-status}" desired json
  if [[ "${MULTI_USER:-0}" == 1 ]]; then
    bad "appliance Connect is unavailable in multi-user mode"; return 1
  fi
  case "$want" in
    diagnose)
      t3_owner_run python3 "$GRAVE_ROOT/scripts/t3-connect-diagnose.py" "$T3_BASE_DIR"
      ;;
    status)
      desired="$(t3_connect_mode)"
      say "T3 Connect — declared mode: ${BLD}$desired${RST} ($T3_CONNECT_MODE_FILE)"
      if json="$(t3_connect_json)" && [[ -n "$json" ]]; then
        say "  exposure:  $(jq -r 'if .desired then "enabled" else "disabled" end' <<<"$json")"
        say "  authorized: $(jq -r 'if .authenticated then "yes" else "no" end' <<<"$json")"
        say "  linked:    $(jq -r 'if .linked then "yes (" + (.cloudUserId // "?") + ")" else "no" end' <<<"$json")"
        say "  relay:     $(jq -r '.relayUrl // "not provisioned"' <<<"$json")"
        say "  publish agent activity: $(jq -r 'if .publishAgentActivity then "on" else "off" end' <<<"$json")"
        # `.desired` is only local INTENT — the mode file's own claim, restated.
        # The relay decides whether the environment is actually linked, and it
        # can refuse (403 on environment-links) long after a link command
        # "succeeded". Reporting a match on intent alone printed a green tick
        # over a box that no app could reach.
        case "$desired" in
          off)     t3c_is '.desired|not' "$json" && ok "matches declared mode" || bad "drift: link desired but mode is off — 'grave t3 connect off' (or declare a mode)" ;;
          publish|full)
            if ! t3c_is '.desired' "$json"; then
              bad "drift: mode is $desired but no link desired — 'grave t3 connect $desired'"
            elif ! t3c_is '.linked' "$json"; then
              bad "mode is $desired and a link is desired, but the relay has NOT linked this environment"
              say "     run 'grave t3 connect diagnose' for the latest relay failure and"
              say "     registered environments. A managed-tunnel limit is one possible"
              say "     cause; see 'Freeing a managed-tunnel slot' in docs/SECURITY.md."
            elif [[ "$desired" == full ]] && ! t3c_is '.relayUrl' "$json"; then
              bad "linked but no relay provisioned — mode full expects a relay URL"
            else
              ok "matches declared mode"
            fi ;;
        esac
      else
        bad "could not read t3 connect status as the t3code service user"
        say "     check private-file ownership under $T3_BASE_DIR/userdata/secrets"
        return 1
      fi
      ;;
    publish|full)
      hdr "T3 Connect — $want"
      if [[ "$want" == publish ]]; then
        say "publish-only: pushes agent activity (notifications, Live Activities) to"
        say "your signed-in official T3 apps. No relay tunnel — the box stays"
        say "reachable over the tailnet only."
      else
        say "full: opens a managed relay tunnel (relay.t3.codes) so the official T3"
        say "apps reach this box WITHOUT Tailscale. Session traffic transits T3's"
        say "relay — read the trust note in docs/SECURITY.md before enabling."
      fi
      say ""
      # --headless: the box has no browser; t3 prints an URL to open on your
      # phone/laptop and prompts for the code shown after sign-in.
      local args=(connect link --headless --base-dir "$T3_BASE_DIR")
      [[ "$want" == publish ]] && args+=(--publish-only)
      t3_owner_run t3 "${args[@]}" || { bad "t3 connect link failed"; exit 1; }
      # publish-only sets the publish flag itself; a full link does not, and
      # phone notifications are half the point of enabling Connect on this box.
      [[ "$want" == full ]] && t3_owner_run t3 connect publish --base-dir "$T3_BASE_DIR"
      t3_connect_set_mode "$want"
      t3_connect_restart
      log "t3 connect: mode $want"
      ok "T3 Connect mode: $want — 'grave doctor' now enforces it"
      ;;
    off)
      hdr "T3 Connect — off"
      # unlink keeps the stored authorization (relinking later skips sign-in);
      # `t3 connect logout --base-dir $T3_BASE_DIR` clears that too.
      t3_owner_run t3 connect unlink --base-dir "$T3_BASE_DIR" || { bad "unlink failed; declared mode retained"; return 1; }
      t3_connect_set_mode off
      t3_connect_restart
      log "t3 connect: mode off"
      ok "T3 Connect disabled — the box is tailnet-only again"
      ;;
    *) say "usage: grave t3 connect [status|diagnose|publish|full|off]"; exit 1 ;;
  esac
}

cmd_t3() { # grave t3 [status|update|connect …] — manage the stable T3 Code CLI
  local sub="${1:-status}" installed latest t3_bin npm_bin
  # connect dispatches before the version lookups: it must not depend on npm
  # or the network being up.
  if [[ "$sub" == connect ]]; then shift; cmd_t3_connect "$@"; return; fi
  command -v t3 >/dev/null 2>&1 || { bad "t3 is not installed"; exit 1; }
  command -v npm >/dev/null 2>&1 || { bad "npm is not installed"; exit 1; }
  installed=$(t3_version)
  [[ -n "$installed" ]] || { bad "t3 is installed but does not run"; exit 1; }
  latest=$(t3_latest_version)
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    bad "could not resolve npm's stable t3 version"; exit 1;
  }

  case "$sub" in
    status)
      say "T3 Code: installed v$installed; stable v$latest"
      [[ "$installed" == "$latest" ]] && ok "T3 Code is up to date" || say "  update available — run: grave t3 update"
      ;;
    update)
      if [[ "$installed" == "$latest" ]]; then
        ok "T3 Code v$installed is already up to date"
        return
      fi
      say "Updating T3 Code v$installed → v$latest (stable)..."
      t3_bin=$(command -v t3)
      npm_bin=$(command -v npm)
      if [[ "$t3_bin" == "$HOME/.local/"* ]]; then
        # SteamOS: node-pty must be rebuilt against the pinned Node ABI using
        # the header wrappers created by steamos-toolchain.sh.
        local wrappers="$HOME/.local/toolchain-wrappers"
        PATH="$wrappers:$(dirname "$npm_bin"):$PATH" CC=cc CXX=c++ \
          "$npm_bin" install -g --prefix "$HOME/.local" "t3@$latest"
      else
        need_root_helper
        # Package-manager hosts install t3 system-wide. npm update follows the
        # package's stable latest tag; the exact result is validated below.
        sudo npm update -g t3
      fi
      local updated
      updated=$(t3_version)
      [[ "$updated" == "$latest" ]] || {
        bad "update validation failed: expected v$latest, found v${updated:-unknown}"
        exit 1
      }
      if [[ "${MULTI_USER:-0}" == 1 && -r "$GRAVE_ROOT/config/workspaces.json" ]]; then
        local slug port any=0
        while read -r slug port; do
          systemctl is-active --quiet "gravedecay-t3@$slug" || continue; any=1
          sudo -n systemctl restart "gravedecay-t3@$slug"
          curl -sf --retry 10 --retry-delay 1 -o /dev/null "http://127.0.0.1:$port/" || { bad "T3 workspace $slug did not answer"; exit 1; }
          ok "T3 workspace $slug answering after restart"
        done < <(jq -r '.workspaces[] | select(.enabled) | "\(.slug) \(.ports.t3)"' "$GRAVE_ROOT/config/workspaces.json")
        (( any )) || say "  workspace T3 services are stopped (gaming mode?) — they will use v$updated next start"
      elif systemctl is-active --quiet t3code; then
        sudo -n systemctl restart t3code
        if curl -sf --retry 10 --retry-delay 1 -o /dev/null \
            "http://127.0.0.1:$T3_PORT/"; then
          ok "t3code answering after restart"
        else
          bad "t3code did not answer after restart"
          exit 1
        fi
      else
        say "  t3code is stopped (gaming mode?) — it will use v$updated next start"
      fi
      log "t3: updated v$installed to v$updated"
      ok "T3 Code updated to v$updated"
      ;;
    *) say "usage: grave t3 [status|update|connect [status|diagnose|publish|full|off]]"; exit 1 ;;
  esac
}

# ---------------------------------------------------------------- status ----
cmd_status() {
  hdr "Always-on services"
  local s
  for s in "${ALWAYS_ON[@]}"; do
    if systemctl is-active --quiet "$s"; then ok "$s"; else bad "$s (inactive)"; fi
  done

  hdr "Developer services"
  for s in "${DEV_SERVICES[@]}"; do
    if systemctl is-active --quiet "$s"; then ok "$s"; else bad "$s (stopped)"; fi
  done
  if dkctl is-active --quiet docker; then
    ok "docker"
    dk ps --format '    {{.Names}}: {{.Status}}' 2>/dev/null || true
  else
    bad "docker (stopped)"
  fi

  hdr "Agent tmux sessions ($TMUX_SOCKET)"
  local sessions
  sessions=$(tmuxa list-sessions 2>/dev/null || true)
  if [[ -n "$sessions" ]]; then sed 's/^/    /' <<<"$sessions"; else say "    (none)"; fi

  hdr "Tailscale"
  if command -v tailscale >/dev/null && tailscale status --peers=false >/dev/null 2>&1; then
    tailscale status --peers=false | sed 's/^/    /'
  else
    bad "tailscale not connected"
  fi

  hdr "System"
  printf '    uptime:%s\n' "$(uptime -p | sed 's/^up//')"
  printf '    mem available: %s MiB\n' "$(mem_available_mib)"
  printf '    disk %s: %s free\n' "$GRAVE_ROOT" "$(df -h "$GRAVE_ROOT" | awk 'NR==2{print $4}')"
  if command -v sensors >/dev/null; then
    sensors 2>/dev/null | awk '/^Package id 0|^Tctl|junction|^edge/ {printf "    temp %s\n", $0}' | head -3
  fi

  if auto_thaw_active; then
    local deadline
    deadline="$(LC_ALL=C systemctl list-timers "$AUTO_THAW_TIMER" --no-legend --no-pager 2>/dev/null \
      | awk 'NF {print $1, $2, $3, $4; exit}')"
    hdr "Gaming auto-thaw"
    say "    pending${deadline:+; next: $deadline}"
  fi
}

# ------------------------------------------------------------- start/stop ----
start_dev() {
  need_root_helper
  say "Starting developer services..."
  dkctl start docker
  local stack
  for stack in "${DEV_STACKS[@]}"; do
    compose "$stack" up -d --wait 2>/dev/null || compose "$stack" up -d
    ok "stack $stack"
  done
  local s
  for s in "${DEV_SERVICES[@]}"; do sudo systemctl start "$s"; ok "$s"; done
  while read -r s; do [[ -n "$s" ]] && { sudo systemctl start "$s"; ok "$s"; }; done < <(workspace_services)
  log "developer mode: started"
}

# Agent freeze uses the cgroup v2 freezer, NOT SIGSTOP: the tmux server
# SIGCONTs any stopped pane child (see tmux server_child_stopped), so signals
# silently lose. The kernel freezer is signal-proof — frozen tasks never run.
TORPOR_CG=/sys/fs/cgroup/grave-torpor

collect_tree() { # collect_tree <pid> -> appends pid + descendants to ALL_PIDS
  local pid="$1" c
  ALL_PIDS+=("$pid")
  for c in $(ps -o pid= --ppid "$pid" 2>/dev/null); do collect_tree "$c"; done
}

freeze_agents() {
  local pids p n=0
  pids=$(tmuxa list-panes -a -F '#{pane_pid}' 2>/dev/null) || return 0
  [[ -z "$pids" ]] && return 0
  sudo mkdir -p "$TORPOR_CG"
  ALL_PIDS=()
  for p in $pids; do collect_tree "$p"; n=$((n+1)); done
  for p in "${ALL_PIDS[@]}"; do
    echo "$p" | sudo tee "$TORPOR_CG/cgroup.procs" >/dev/null 2>&1 || true
  done
  echo 1 | sudo tee "$TORPOR_CG/cgroup.freeze" >/dev/null
  ok "froze $n agent pane(s) 🧊 (cgroup freezer: RAM kept, zero CPU — 'grave developer' thaws)"
}

thaw_agents() {
  [[ -f "$TORPOR_CG/cgroup.freeze" ]] || return 0
  [[ "$(cat "$TORPOR_CG/cgroup.freeze")" == 1 ]] || return 0
  echo 0 | sudo tee "$TORPOR_CG/cgroup.freeze" >/dev/null
  ok "thawed agent sessions"
}

stop_dev() { # stop_dev [kill]  — kill: also destroy tmux sessions (max free RAM)
  local kill_sessions="${1:-}"
  need_root_helper
  say "Stopping developer services..."
  local s
  for s in "${DEV_SERVICES[@]}"; do sudo systemctl stop "$s" 2>/dev/null || true; ok "stopped $s"; done
  while read -r s; do [[ -n "$s" ]] && { sudo systemctl stop "$s" 2>/dev/null || true; ok "stopped $s"; }; done < <(workspace_services)
  if [[ "$kill_sessions" == kill ]]; then
    if tmuxa list-sessions >/dev/null 2>&1; then
      tmuxa kill-server 2>/dev/null || true
      ok "killed agent tmux sessions ☠️"
    fi
  else
    freeze_agents
  fi
  if dkctl is-active --quiet docker; then
    local stack idx
    for (( idx=${#DEV_STACKS[@]}-1; idx>=0; idx-- )); do
      stack="${DEV_STACKS[$idx]}"
      compose "$stack" stop 2>/dev/null || true
      ok "stopped stack $stack"
    done
    # stop any remaining containers so docker can shut down cleanly
    local rest; rest=$(dk ps -q)
    [[ -n "$rest" ]] && dk stop $rest >/dev/null
    dkctl stop docker.service; dkctl stop docker.socket 2>/dev/null || true
    ok "stopped docker"
  fi
  log "developer mode: stopped"
}

cmd_gaming() { # cmd_gaming [--kill] [--for <timespan>]
  local tier=pause duration=""
  while (($#)); do
    case "$1" in
      --kill) tier=kill ;;
      --for)  shift; duration="${1:?usage: grave gaming [--kill] [--for <duration>]}" ;;
      *)      say "usage: grave gaming [--kill] [--for <duration>]"; exit 1 ;;
    esac
    shift
  done
  [[ -z "$duration" ]] || valid_auto_thaw_duration "$duration" \
    || { bad "invalid --for duration '$duration' (examples: 30m, 2h, 1h30m)"; exit 1; }
  cancel_auto_thaw
  [[ -z "$duration" ]] || schedule_auto_thaw "$duration"
  local before after
  before=$(mem_available_mib)
  if [[ "$tier" == kill ]]; then stop_dev kill; else stop_dev; fi
  after=$(mem_available_mib)
  say ""
  if [[ "$tier" == kill ]]; then
    say "${BLD}🎮 Gaming mode (full kill).${RST} Freed ~$(( after - before )) MiB RAM. Agent sessions are gone."
  else
    say "${BLD}🎮 Gaming mode (torpor).${RST} Freed ~$(( after - before )) MiB RAM."
    say "Agent sessions are frozen in place — 'grave developer' thaws them."
  fi
  say "Remote access (Tailscale + SSH) is untouched."
  log "gaming mode: active ($tier, freed $(( after - before )) MiB)"
}

cmd_developer() {
  # Stopping only the timer is safe when this command is itself the transient
  # service fired by that timer; stopping the service would kill the restore.
  cancel_auto_thaw
  thaw_agents
  start_dev
  say ""
  say "${BLD}💻 Developer mode.${RST} All services up. 'grave status' for details."
  log "developer mode: active"
}

# ---------------------------------------------------------------- agents ----
# Managed worktrees stay under this appliance's own root. Never accept an
# arbitrary path from session metadata for a cleanup operation.
agent_worktree_valid() {
  local name="$1" meta="$GRAVE_ROOT/agents/$1/meta.json" repo dir
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ && ! -L "$meta" ]] || return 1
  jq -e '.worktree == true and .pruned != true' "$meta" >/dev/null || return 1
  repo=$(jq -er '.repo' "$meta") || return 1
  dir=$(jq -er '.dir' "$meta") || return 1
  [[ "$repo" =~ ^[A-Za-z0-9_-][A-Za-z0-9_.-]*$ ]] || return 1
  [[ "$dir" == "$GRAVE_ROOT/worktrees/$repo/$name" && ! -L "$dir" && -d "$dir" && -w "$dir" ]] || return 1
  [[ ! -L "$GRAVE_ROOT/worktrees" && ! -L "$GRAVE_ROOT/worktrees/$repo" ]] || return 1
  [[ -d "$GRAVE_ROOT/repos/$repo/.git" && ! -L "$GRAVE_ROOT/repos/$repo" ]] || return 1
  [[ "$(git -C "$dir" rev-parse --git-common-dir)" -ef "$GRAVE_ROOT/repos/$repo/.git" ]]
}

agent_worktrees_check() {
  if [[ -e "$GRAVE_ROOT/worktrees" || -L "$GRAVE_ROOT/worktrees" ]]; then
    [[ -d "$GRAVE_ROOT/worktrees" && -w "$GRAVE_ROOT/worktrees" && ! -L "$GRAVE_ROOT/worktrees" ]] || return 1
  fi
  local meta name
  for meta in "$GRAVE_ROOT"/agents/*/meta.json; do
    [[ -f "$meta" ]] || continue
    jq -e 'type == "object"' "$meta" >/dev/null || return 1
    jq -e '.worktree == true and .pruned != true' "$meta" >/dev/null || continue
    name=$(basename "$(dirname "$meta")")
    agent_worktree_valid "$name" || return 1
  done
}

agent_worktrees_prune() {
  local meta name repo dir base head status panes tmp unpushed
  # Failure to inspect tmux must not be interpreted as an idle checkout.
  panes=$(tmuxa list-panes -a -F '#{pane_current_path}' 2>/dev/null) || {
    if tmuxa list-sessions >/dev/null 2>&1; then bad "cannot inspect live panes"; return 1; fi
    panes=""
  }
  for meta in "$GRAVE_ROOT"/agents/*/meta.json; do
    [[ -f "$meta" ]] || continue
    jq -e '.worktree == true and .pruned != true' "$meta" >/dev/null || continue
    name=$(basename "$(dirname "$meta")")
    agent_worktree_valid "$name" || { bad "$name: invalid worktree metadata; retained"; continue; }
    repo=$(jq -r '.repo' "$meta"); dir=$(jq -r '.dir' "$meta"); base=$(jq -r '.base' "$meta")
    if [[ -e "$GRAVE_ROOT/agents/$name/.run.lock" ]] && ! flock -n "$GRAVE_ROOT/agents/$name/.run.lock" true; then
      say "  $name: scheduled run active; retained"; continue
    fi
    if tmuxa has-session -t "=$name" 2>/dev/null ||
       awk -v d="$dir" '$0 == d || index($0,d "/") == 1 {found=1} END {exit !found}' <<<"$panes"; then
      say "  $name: live; retained"; continue
    fi
    status=$(git -C "$dir" status --porcelain --untracked-files=all --ignored) || continue
    [[ -z "$status" ]] || { say "  $name: local files or changes; retained"; continue; }
    head=$(git -C "$dir" rev-parse HEAD) || continue
    # An untouched new branch is disposable. Otherwise require both a merge
    # into the source checkout's HEAD and a remote ref containing the commits.
    if [[ "$head" != "$base" ]]; then
      git -C "$GRAVE_ROOT/repos/$repo" merge-base --is-ancestor "$head" HEAD || {
        say "  $name: not merged into the source checkout; retained"; continue;
      }
      unpushed=$(git -C "$dir" rev-list HEAD --not --remotes) || continue
      [[ -z "$unpushed" ]] || {
        say "  $name: unpushed commits; retained"; continue;
      }
    fi
    if git -C "$GRAVE_ROOT/repos/$repo" worktree remove "$dir"; then
      tmp=$(mktemp "$meta.XXXXXX")
      jq '.pruned = true' "$meta" >"$tmp" && mv "$tmp" "$meta"
      ok "$name: checkout removed; branch and session history retained"
    else
      bad "$name: Git could not safely remove the checkout; retained (Git 2.17+ required)"
    fi
  done
}

agent_tasks_check() {
  local meta task_file
  for meta in "$GRAVE_ROOT"/agents/*/meta.json; do
    [[ -f "$meta" ]] || continue
    jq -e '.dispatch != null' "$meta" >/dev/null || continue
    task_file="$(dirname "$meta")/task.json"
    python3 "$GRAVE_ROOT/scripts/agent-task.py" check "$task_file" || return 1
    jq -e --slurpfile task "$task_file" \
      '.dispatch == {agent:$task[0].agent,issue:($task[0].issue | {id,title,url})}' "$meta" >/dev/null || return 1
  done
}

cmd_agents() {
  case "${1:-list}" in
    new|kill|resume|prune)
      [[ ! -L "$GRAVE_ROOT/agents" ]] || { bad "agents directory must not be a symlink"; return 1; }
      mkdir -p "$GRAVE_ROOT/agents"
      # Serialize lifecycle changes, but don't pass the lock into tmux's
      # long-lived server or pane processes.
      (flock -x 9; cmd_agents_unlocked "$@" 9>&-) 9>"$GRAVE_ROOT/agents/.lifecycle.lock" ;;
    run|jobs|__scheduler)
      [[ "${MULTI_USER:-0}" == 0 ]] || { bad "scheduled runs require single-owner mode"; return 1; }
      local action="$1"; shift
      [[ "$action" != __scheduler ]] || action=scheduler
      GRAVE_ROOT="$GRAVE_ROOT" GRAVE_CONF="$CONF" GRAVE_BIN="$(readlink -f "$0")" \
        python3 "$GRAVE_ROOT/scripts/agent-jobs.py" "$action" "$@" ;;
    *) cmd_agents_unlocked "$@" ;;
  esac
}

cmd_agents_unlocked() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      tmuxa list-sessions 2>/dev/null || say "No agent sessions. Start one: grave agents new <name> [dir]" ;;
    new)
      local name="${1:?usage: grave agents new <name> [dir]}"
      # The name is interpolated into a path and into the pipe-pane command tmux
      # runs via /bin/sh, so restrict it to a safe charset (traversal + injection).
      [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || { bad "session name must be letters, digits, '-' or '_'"; exit 1; }
      [[ "$name" != t3code && ${#name} -le 50 ]] || { bad "session name is reserved or longer than 50 characters"; return 1; }
      shift
      local dir="" repo="" branch="" worktree=0 base="" meta tmp task=""
      while (($#)); do
        case "$1" in
          --worktree) worktree=1 ;;
          --repo) shift; repo="${1:?--repo requires a repository name}"; worktree=1 ;;
          --branch) shift; branch="${1:?--branch requires a new branch name}" ;;
          --task) shift; task="${1:?--task requires a private issue task JSON file}" ;;
          -*) bad "unknown agents new option: $1"; return 1 ;;
          *) [[ -z "$dir" ]] || { bad "only one working directory is allowed"; return 1; }; dir="$1" ;;
        esac
        shift
      done
      [[ ! -L "$GRAVE_ROOT/agents" && ! -L "$GRAVE_ROOT/agents/$name" ]] || { bad "session directory must not be a symlink"; return 1; }
      meta="$GRAVE_ROOT/agents/$name/meta.json"
      if [[ -n "$task" ]]; then
        [[ $worktree == 1 && -n "$repo" && ! -e "$GRAVE_ROOT/agents/$name" ]] || {
          bad "--task requires --repo and a new session name"; return 1;
        }
        python3 "$GRAVE_ROOT/scripts/agent-task.py" validate "$task" || return 1
      fi
      if tmuxa has-session -t "=$name" 2>/dev/null; then bad "session '$name' already exists"; return 1; fi
      if (( worktree )); then
        [[ -z "$dir" && "$repo" =~ ^[A-Za-z0-9_-][A-Za-z0-9_.-]*$ ]] || {
          bad "use --worktree --repo <name> (a repository under $GRAVE_ROOT/repos), without [dir]"; return 1;
        }
        [[ ! -e "$meta" ]] || { bad "session history already exists; use agents resume or a new name"; return 1; }
        [[ -d "$GRAVE_ROOT/repos/$repo/.git" && ! -L "$GRAVE_ROOT/repos/$repo" ]] || {
          bad "repository must be a primary checkout under $GRAVE_ROOT/repos"; return 1;
        }
        branch="${branch:-agent/$name}"
        git check-ref-format --branch "$branch" >/dev/null || return 1
        [[ "$branch" != -* ]] || { bad "invalid branch"; return 1; }
        base=$(git -C "$GRAVE_ROOT/repos/$repo" rev-parse --verify HEAD) || return 1
        dir="$GRAVE_ROOT/worktrees/$repo/$name"
        [[ ! -L "$GRAVE_ROOT/worktrees" && ! -L "$GRAVE_ROOT/worktrees/$repo" && ! -e "$dir" && ! -L "$dir" ]] || {
          bad "worktree path exists or is a symlink"; return 1;
        }
        (umask 077; mkdir -p "$GRAVE_ROOT/worktrees/$repo")
        git -C "$GRAVE_ROOT/repos/$repo" worktree add -b "$branch" "$dir" "$base" || return 1
      else
        [[ -z "$branch" ]] || { bad "--branch requires --repo"; return 1; }
        dir="${dir:-$GRAVE_ROOT/repos}"
        if jq -e '.worktree == true' "$meta" >/dev/null 2>&1; then
          agent_worktree_valid "$name" && [[ "$dir" == "$(jq -r '.dir' "$meta")" ]] || {
            bad "managed session must resume its existing worktree; use a new session name"; return 1;
          }
        fi
      fi
      dir=$(cd "$dir" && pwd -P) || return 1
      mkdir -p "$GRAVE_ROOT/agents/$name"
      if (( worktree )); then
        tmp=$(mktemp "$meta.XXXXXX")
        jq -n --arg dir "$dir" --arg repo "$repo" --arg branch "$branch" --arg base "$base" \
          --arg created "$(date -u +%FT%TZ)" \
          '{dir:$dir,repo:$repo,branch:$branch,base:$base,created:$created,worktree:true}' >"$tmp"
        mv "$tmp" "$meta"
      fi
      if [[ -n "$task" ]]; then
        chmod 700 "$GRAVE_ROOT/agents/$name"
        install -m 600 "$task" "$GRAVE_ROOT/agents/$name/task.json"
        tmp=$(mktemp "$meta.XXXXXX")
        jq --slurpfile task "$GRAVE_ROOT/agents/$name/task.json" \
          '.dispatch = {agent:$task[0].agent,issue:($task[0].issue | {id,title,url})}' "$meta" >"$tmp"
        mv "$tmp" "$meta"
      fi
      local pane
      pane=$(tmuxa -f "$TMUX_CONF" new-session -d -P -F '#{pane_id}' -s "$name" -c "$dir")
      # Record the working dir so `agents resume` (and the dashboard's ▶
      # button) can bring a dead session back where it lived (#110).
      if ! jq -e '.worktree == true' "$meta" >/dev/null 2>&1; then
        jq -n --arg dir "$dir" --arg created "$(date -u +%FT%TZ)" \
        '{dir:$dir, created:$created}' >"$GRAVE_ROOT/agents/$name/meta.json" 2>/dev/null || true
      fi
      # Resolve the dated log path in bash: the old deferred date-in-tmux form
      # double-escaped the percents and logged a literal filename, never a date.
      local logfile="$GRAVE_ROOT/agents/$name/session-$(date +%Y%m%d).log"
      local quoted_log; printf -v quoted_log '%q' "$logfile"
      tmuxa pipe-pane -t "$pane" -o "cat >> $quoted_log" 2>/dev/null || true
      if [[ -n "$task" ]]; then
        # Respawn directly instead of typing issue text into a shell. Python
        # reads the private JSON and passes one literal prompt argument.
        local runner
        runner=$(python3 -c 'import shlex,sys; print(" ".join(map(shlex.quote,sys.argv[1:])))' \
          python3 "$GRAVE_ROOT/scripts/agent-task.py" run "$GRAVE_ROOT/agents/$name/task.json")
        tmuxa respawn-pane -k -t "$pane" "$runner; exec bash -l"
      fi
      ok "session '$name' created in $dir (attach: grave agents attach $name)" ;;
    attach)
      exec tmux -L "$TMUX_SOCKET" attach -t "${1:?usage: grave agents attach <name>}" ;;
    kill)
      local name="${1:?usage: grave agents kill <name>}"
      [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
      tmuxa kill-session -t "=$name"; ok "killed ${1}; any worktree is retained" ;;
    prune) agent_worktrees_prune ;;
    history)
      # Dead sessions leave their pipe-pane logs behind (#110): list every
      # session dir that has logs, live or not. agents/t3code is T3 server
      # state, not a tmux session dir.
      local d name logs last state
      printf '%-24s %-6s %-18s %s\n' "SESSION" "STATE" "LAST ACTIVITY" "LOGS"
      for d in "$GRAVE_ROOT"/agents/*/; do
        name=$(basename "$d"); [[ "$name" == t3code ]] && continue
        logs=$(ls -1 "$d" 2>/dev/null | grep -c '^session-[0-9]*\.log$') || true
        (( logs > 0 )) || continue
        last=$(date -d "@$(stat -c %Y "$d"session-*.log | sort -n | tail -1)" '+%F %H:%M')
        state=dead; tmuxa has-session -t "=$name" 2>/dev/null && state=live
        printf '%-24s %-6s %-18s %s\n' "$name" "$state" "$last" "$logs"
      done ;;
    resume)
      local name="${1:?usage: grave agents resume <name>}"
      [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || { bad "session name must be letters, digits, '-' or '_'"; exit 1; }
      if tmuxa has-session -t "=$name" 2>/dev/null; then
        ok "session '$name' is already live (attach: grave agents attach $name)"; return
      fi
      # Back to the dir it lived in; sessions predating meta.json fall back to
      # the default. The old logs stay put — the new day's log appends beside them.
      local dir
      if [[ -e "$GRAVE_ROOT/agents/$name/meta.json" ]]; then
        jq -e 'type == "object" and (.dir | type == "string")' "$GRAVE_ROOT/agents/$name/meta.json" >/dev/null || {
          bad "invalid session metadata; repair it before resuming"; return 1;
        }
      fi
      dir=$(jq -r '.dir // empty' "$GRAVE_ROOT/agents/$name/meta.json" 2>/dev/null) || dir=""
      if jq -e '.worktree == true' "$GRAVE_ROOT/agents/$name/meta.json" >/dev/null 2>&1; then
        agent_worktree_valid "$name" || { bad "worktree is missing or invalid; recover it before resuming"; return 1; }
      else
        [[ -d "$dir" ]] || dir="$GRAVE_ROOT/repos"
      fi
      cmd_agents_unlocked new "$name" "$dir" ;;
    *) say "usage: grave agents [list|new|attach|kill|history|resume|prune|run|jobs]"; exit 1 ;;
  esac
}

# ---------------------------------------------------------------- docker ----
cmd_docker() {
  local sub="${1:-ps}"; shift || true
  case "$sub" in
    ps)    dk ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' ;;
    up)    compose "${1:?stack name}" up -d ;;
    down)  compose "${1:?stack name}" down ;;
    logs)  dk logs --tail 100 -f "${1:?container name}" ;;
    stacks) ls -1 "$GRAVE_ROOT/docker" ;;
    disk)  dk system df ;;
    *) say "usage: grave docker [ps|up <stack>|down <stack>|logs <container>|stacks|disk]"; exit 1 ;;
  esac
}

# --------------------------------------------------------------- preview ----
# Expose a running dev server to the tailnet over HTTPS at the ROOT of its own
# port — NOT behind a path. A path prefix (/preview) breaks any framework that
# assumes it lives at "/" : Vite/Next HMR websockets, /@vite, /_next, absolute
# asset URLs all 404. Serving at the port root means the dev server works
# unmodified, no per-project base-path config. The server stays bound to
# 127.0.0.1; Tailscale terminates TLS and proxies over the tailnet ONLY (this
# is `serve`, not `funnel` — nothing is exposed to the public internet).
# Ports are confined to PREVIEW_RANGE so a preview can never shadow a platform
# service (4711-4713) or anything outside the sandbox.
tailnet_host() { local h; h=$(tailscale status --json 2>/dev/null | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p'); printf '%s\n' "${h%%$'\n'*}"; }

preview_reserved() { # preview_reserved <port>  — a platform service sits on it
  local p="$1" r
  for r in ${PREVIEW_RESERVED:-}; do [[ "$p" == "$r" ]] && return 0; done
  return 1
}

preview_in_range() { # preview_in_range <port>  — valid, non-reserved preview port
  local p="$1" lo="${PREVIEW_RANGE%-*}" hi="${PREVIEW_RANGE#*-}"
  [[ "$p" =~ ^[0-9]+$ ]] && (( p >= lo && p <= hi )) && ! preview_reserved "$p"
}

port_listening() { # port_listening <port>  — something bound to it right now?
  ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"
}

listening_previews() { # previewable ports with a live listener (one per line)
  local p
  ss -tlnH 2>/dev/null | awk '{print $4}' | sed -n 's/.*[:.]\([0-9]\{1,\}\)$/\1/p' | sort -un |
    while read -r p; do preview_in_range "$p" && echo "$p"; done
}

preview_start() { # preview_start <port>
  local port="$1" host
  preview_reserved "$port" && { bad "port $port belongs to a platform service — refusing to expose it"; exit 1; }
  preview_in_range "$port" || { bad "port $port is outside the preview range $PREVIEW_RANGE"; exit 1; }
  host=$(tailnet_host)
  [[ -n "$host" ]] || { bad "can't read the tailnet name — is tailscale up?"; exit 1; }
  if ! port_listening "$port"; then
    say "  ${YLW}nothing is listening on 127.0.0.1:$port yet — start your dev server first (this maps it anyway).${RST}"
  fi
  tailscale serve --bg --https="$port" "http://127.0.0.1:$port" >/dev/null
  log "preview: on $port"
  ok "https://$host:$port  →  127.0.0.1:$port  (tailnet only — 'grave preview off $port' to stop)"
}

preview_stop() { # preview_stop <port>
  local port="$1"
  preview_in_range "$port" || { bad "port $port is outside the preview range $PREVIEW_RANGE"; exit 1; }
  tailscale serve --https="$port" off >/dev/null 2>&1 || true
  log "preview: off $port"
  ok "preview on $port stopped"
}

cmd_preview() { # grave preview [<port>|off <port>|list]
  local sub="${1:-}"; shift || true
  case "$sub" in
    ""|auto)
      # No port: expose the single dev server listening in range. If several
      # are up we can't guess — list them and ask for an explicit port.
      local ports; mapfile -t ports < <(listening_previews)
      case "${#ports[@]}" in
        0) say "No dev server is listening in $PREVIEW_RANGE. Start one, then:"
           say "  grave preview <port>"; exit 1 ;;
        1) preview_start "${ports[0]}" ;;
        *) say "Several dev servers are listening — name the port:"
           local p; for p in "${ports[@]}"; do say "  grave preview $p"; done; exit 1 ;;
      esac ;;
    off|stop) preview_stop "${1:?usage: grave preview off <port>}" ;;
    list|status|ls)
      local host line port any=0; host=$(tailnet_host)
      while IFS= read -r line; do
        port=$(sed -n 's#^https://[^ :]*:\([0-9]\{1,\}\).*#\1#p' <<<"$line")
        [[ -n "$port" ]] && preview_in_range "$port" && { say "  https://$host:$port  →  127.0.0.1:$port"; any=1; }
      done < <(tailscale serve status 2>/dev/null)
      (( any )) || say "  (no previews active)" ;;
    *)
      if [[ "$sub" =~ ^[0-9]+$ ]]; then preview_start "$sub"  # start (validates range/reserved)
      else say "usage: grave preview [<port>|off <port>|list]"; exit 1; fi ;;
  esac
}

# ---------------------------------------------------------------- update ----
cmd_update() {
  need_root_helper
  if command -v snapper >/dev/null; then
    say "Snapshotting before update..."
    sudo snapper -c root create --description "grave-pre-update" --cleanup-algorithm number || true
  fi
  if [[ "${CHECK_IMMUTABLE_ROOT:-0}" == 1 ]]; then
    # Immutable rootfs (e.g. stock SteamOS): never pacman into read-only /usr —
    # it won't survive an OS update. The durable toolchain updates via Homebrew
    # under $HOME; the base OS updates through its own image updater. See
    # docs/STEAMOS.md.
    if command -v brew >/dev/null; then
      say "Updating Homebrew toolchain..."
      brew update >/dev/null 2>&1 && brew upgrade 2>&1 | tail -1 || say "${YLW}brew upgrade had issues (non-fatal)${RST}"
    fi
    say "${YLW}base OS is image-based — update it with the system updater, not grave${RST}"
  else
    say "Updating system packages..."
    case "$(pkg_mgr)" in
      pacman) sudo pacman -Syu --noconfirm
              if command -v paru >/dev/null; then paru -Sua --noconfirm || say "${YLW}AUR update had issues (non-fatal)${RST}"; fi ;;
      zypper) sudo zypper --non-interactive update ;;
      apt)    sudo apt-get update && sudo apt-get -y upgrade ;;
      dnf)    sudo dnf -y upgrade ;;
      *)      say "${YLW}no known package manager — skipping system update${RST}" ;;
    esac
    if ((${#NPM_GLOBAL_TOOLS[@]})); then
      say "Updating npm-global tools..."
      sudo npm update -g "${NPM_GLOBAL_TOOLS[@]}" 2>&1 | tail -1 || true
    fi
  fi
  say "Checking T3 Code..."
  cmd_t3 update
  if dkctl is-active --quiet docker; then
    say "Pulling docker images..."
    local stack; for stack in "${DEV_STACKS[@]}"; do compose "$stack" pull -q || true; done
  fi
  say "Agent CLIs (claude/codex) self-update on launch."
  log "update: completed"
  ok "update complete — reboot only if the kernel changed"
}

# -------------------------------------------------------------- bootmode ----
cmd_bootmode() { # what the box boots into: developer (dev services up) or gaming
  case "${1:-}" in
    "")
      # Capture then take the first line in bash — piping the streaming
      # workspace_services into `head -1` closes the pipe early, SIGPIPEs the
      # producer, and under `set -o pipefail` aborts `grave bootmode` (exit 141).
      local first_workspace; first_workspace=$(workspace_services); first_workspace=${first_workspace%%$'\n'*}
      if systemctl is-enabled --quiet t3code 2>/dev/null || { [[ -n "$first_workspace" ]] && systemctl is-enabled --quiet "$first_workspace"; }; then
        say "boot mode: developer (dev services start at boot)"
      else
        say "boot mode: gaming (dev services stay down until 'grave developer')"
      fi ;;
    developer|dev)
      need_root_helper
      sudo systemctl enable t3code >/dev/null 2>&1 || true
      while read -r s; do [[ -n "$s" ]] && sudo systemctl enable "$s" >/dev/null 2>&1 || true; done < <(workspace_services)
      dkctl enable docker >/dev/null 2>&1 || true   # rootless: per-user unit
      ok "boot mode: developer — dev services start automatically after reboot" ;;
    gaming|game)
      need_root_helper
      sudo systemctl disable t3code >/dev/null 2>&1 || true
      while read -r s; do [[ -n "$s" ]] && sudo systemctl disable "$s" >/dev/null 2>&1 || true; done < <(workspace_services)
      dkctl disable docker docker.socket >/dev/null 2>&1 || true
      ok "boot mode: gaming — after reboot only ALWAYS_ON runs; 'grave developer' wakes the rest" ;;
    *) say "usage: grave bootmode [developer|gaming]"; exit 1 ;;
  esac
}

# ------------------------------------------------------------- gamewatch ----
# Game-mode auto-throttle toggle. The gravedecay-gamewatch.service loop watches
# for a running game and flips grave gaming/developer; this just flips the flag
# file it reads each poll (no sudo — the file lives under $GRAVE_ROOT).
cmd_gamewatch() {
  local flag="$GRAVE_ROOT/config/gamewatch.on" state="$GRAVE_ROOT/logs/gamewatch.state"
  case "${1:-status}" in
    on)  systemctl cat gravedecay-gamewatch.service >/dev/null 2>&1 \
           || { bad "gravedecay-gamewatch.service not installed — re-run raise.sh first"; exit 1; }
         mkdir -p "$GRAVE_ROOT/config"; printf 'on\n' >"$GAMEWATCH_PREFERENCE"; : > "$flag"; rm -f "$state"
         ok "auto-throttle ON — launching a game freezes agents; 'grave gamewatch off' to stop" ;;
    off) mkdir -p "$GRAVE_ROOT/config"; printf 'off\n' >"$GAMEWATCH_PREFERENCE"; rm -f "$flag" "$state"
         ok "auto-throttle OFF (persistent; games no longer flip modes)" ;;
    status)
      [[ -e "$flag" ]] && say "auto-throttle: ${GRN}on${RST}" || say "auto-throttle: ${YLW}off${RST}"
      [[ -r "$GAMEWATCH_PREFERENCE" ]] && say "  saved preference: $(tr -d '[:space:]' <"$GAMEWATCH_PREFERENCE")"
      if systemctl is-active --quiet gravedecay-gamewatch; then say "  watcher service: running"
      else say "  watcher service: ${YLW}stopped${RST} (re-run raise.sh)"; fi
      [[ -r "$GRAVE_ROOT/logs/gamewatch.state" ]] && say "  last seen: $(cat "$GRAVE_ROOT/logs/gamewatch.state")" ;;
    *) say "usage: grave gamewatch [on|off|status]"; exit 1 ;;
  esac
}

# ------------------------------------------------------------ keepalive ----
# "Always alive" toggle. The gravedecay-keepalive.service loop pings online
# tailnet peers every couple of seconds so a remote device on a DERP relay keeps
# its path warm and its T3/dashboard websocket doesn't idle-drop. This just
# flips the flag file the loop reads each poll (no sudo — it lives under
# $GRAVE_ROOT).
cmd_keepalive() {
  local flag="$GRAVE_ROOT/config/keepalive.on"
  case "${1:-status}" in
    on)  systemctl cat gravedecay-keepalive.service >/dev/null 2>&1 \
           || { bad "gravedecay-keepalive.service not installed on this host — re-raise to install it"; exit 1; }
         mkdir -p "$GRAVE_ROOT/config"; : > "$flag"
         ok "always-alive ON — warming tailnet relay paths; 'grave keepalive off' to stop" ;;
    off) rm -f "$flag"; ok "always-alive OFF (tailnet paths no longer warmed)" ;;
    status)
      [[ -e "$flag" ]] && say "always-alive: ${GRN}on${RST}" || say "always-alive: ${YLW}off${RST}"
      if systemctl is-active --quiet gravedecay-keepalive; then say "  keepalive service: running"
      else say "  keepalive service: ${YLW}stopped${RST} (re-raise to install)"; fi ;;
    *) say "usage: grave keepalive [on|off|status]"; exit 1 ;;
  esac
}

# ---------------------------------------------------------------- notify ----
# Push a message to the human (docs/NOTIFICATIONS.md) over two channels:
#   ntfy     — $GRAVE_ROOT/config/secrets/notify.env (600, git-ignored):
#                NTFY_URL=https://ntfy.sh/<random-topic>
#                NTFY_TOKEN=tk_...          # optional bearer token
#   Web Push — PWA devices enrolled from ⚙️ settings; the dashboard holds the
#              VAPID key + subscriptions and does the crypto, we just POST the
#              message to its loopback /api/push-send.
# Event sources (tmux hooks, OnFailure= units, doctor) call
# `grave notify --event <name>`, which is a silent no-op unless a channel is
# configured AND the event class is listed in NOTIFY_EVENTS — so the hooks ship
# enabled everywhere without spamming an unconfigured box.
ntfy_ready() {
  [[ -r "$NOTIFY_ENV" ]] || return 1
  # shellcheck disable=SC1090
  ( source "$NOTIFY_ENV"; [[ "${NTFY_URL:-}" =~ ^https?:// ]] )
}

push_ready() { # at least one PWA device is enrolled for Web Push
  [[ -s "$PUSH_SUBS" ]] && jq -e '.subscriptions | length > 0' "$PUSH_SUBS" >/dev/null 2>&1
}

notify_configured() { ntfy_ready || push_ready; }

ntfy_send() { # ntfy_send <title> <body> <priority>
  local title="$1" body="$2" priority="$3"
  # shellcheck disable=SC1090
  source "$NOTIFY_ENV"
  [[ "${NTFY_URL:-}" =~ ^https?:// ]] || return 1
  # Headers are a protocol boundary: a newline in an interpolated value (a tmux
  # session name reaches here) becomes header injection. Strip CR/LF and pin
  # the priority to ntfy's vocabulary. The body travels as --data-raw, never
  # -d/--data-binary, whose @ prefix would read local files into the request.
  title=${title//[$'\r\n']/ }
  [[ "$priority" =~ ^[a-z1-5]+$ ]] || priority=default
  local args=(-sf -m 10 -o /dev/null -H "Title: $title" -H "Priority: $priority")
  [[ -n "${NTFY_TOKEN:-}" ]] && args+=(-H "Authorization: Bearer ${NTFY_TOKEN//[$'\r\n']/}")
  curl "${args[@]}" --data-raw "$body" "$NTFY_URL"
}

PUSH_ERROR=""
push_send() { # push_send <title> <body> <priority> <link> <event>
  # jq builds the JSON so a hostile session name can't break out of the
  # payload; the dashboard validates the link (on-origin paths only). Keep the
  # response: its output carries the push service's rejection reason (#97 —
  # discarding it turned Apple's 'BadJwtToken' into a bare 'delivery failed').
  local resp
  resp=$(jq -n --arg t "$1" --arg b "$2" --arg p "$3" --arg u "$4" --arg e "$5" \
      '{title:$t, body:$b, priority:$p, url:$u, tag:(if $e=="" then "manual" else $e end)}' \
    | GRAVE_ROOT="$GRAVE_ROOT" DASH_PORT="${DASH_PORT:-4712}" python3 "$GRAVE_ROOT/scripts/gravedecay.py" --local-request /api/push-send) || { [[ -n "$resp" ]] || { PUSH_ERROR="dashboard unreachable"; return 1; }; }
  jq -e .ok <<<"$resp" >/dev/null 2>&1 && return 0
  PUSH_ERROR=$(jq -r '.output // "push failed"' <<<"$resp" 2>/dev/null)
  return 1
}

notify_record() { # notify_record <title> <body> <link> <event> <delivered> — inbox line (#119)
  # Pushes are ephemeral on every channel (dismiss and it's gone; iOS truncates
  # long bodies); this file is the durable copy the dashboard's 🔔 Inbox
  # renders. jq builds the JSON so hostile titles/session names can't break the
  # encoding; 0600 because bodies carry private detail; best-effort throughout —
  # a full disk must never break delivery itself.
  local inbox="$GRAVE_ROOT/logs/notifications.jsonl"
  {
    mkdir -p "$GRAVE_ROOT/logs"
    # size-capped: keep the newest ~400 entries once the file passes 256 KiB
    if [[ -f "$inbox" ]] && (( $(stat -c %s "$inbox") > 262144 )); then
      tail -n 400 "$inbox" >"$inbox.tmp" && mv "$inbox.tmp" "$inbox"
    fi
    [[ -f "$inbox" ]] || : >"$inbox"
    chmod 600 "$inbox"
    jq -nc --arg t "$1" --arg b "$2" --arg l "$3" --arg e "$4" --argjson d "$5" \
      '{ts:(now|floor), event:(if $e=="" then "manual" else $e end),
        title:$t, body:$b, link:$l, delivered:$d}' >>"$inbox"
  } 2>/dev/null || true
}

notify_send() { # notify_send <title> <body> <priority> <link> <event> — ok if ANY channel delivered
  local sent=0
  if ntfy_ready; then ntfy_send "$1" "$2" "$3" && sent=1; fi
  if push_ready; then push_send "$1" "$2" "$3" "$4" "$5" && sent=1; fi
  notify_record "$1" "$2" "$4" "$5" "$([[ $sent == 1 ]] && echo true || echo false)"
  (( sent ))
}

notify_reachable() {
  # Doctor probe without publishing: ntfy's poll endpoint returns the topic's
  # cached messages and exercises auth, so a doctor run never pages the phone.
  # shellcheck disable=SC1090
  source "$NOTIFY_ENV"
  [[ "${NTFY_URL:-}" =~ ^https?:// ]] || return 1
  local args=(-sf -m 10 -o /dev/null)
  [[ -n "${NTFY_TOKEN:-}" ]] && args+=(-H "Authorization: Bearer ${NTFY_TOKEN//[$'\r\n']/}")
  curl "${args[@]}" "$NTFY_URL/json?poll=1"
}

claude_notify_hook_present() {
  local settings="$HOME/.claude/settings.json" cmd="$AGENT_NOTIFY claude"
  [[ -r "$settings" ]] || return 1
  jq -e --arg cmd "$cmd" '
    def hascmd($name): any(.hooks[$name][]?; any(.hooks[]?; .command == $cmd));
    hascmd("Stop") and hascmd("Notification")
  ' "$settings"
}

codex_notify_hook_present() {
  local conf="$HOME/.codex/config.toml"
  [[ -r "$conf" ]] || return 1
  grep -Eq '^[[:space:]]*notify[[:space:]]*=.*grave-agent-notify.*codex' "$conf"
}

cmd_notify() { # grave notify [--event <name>] [--priority <p>] [--link </path>] <title> [body...]
  local event="" priority=default link=""
  while (($#)); do
    case "$1" in
      --event)    event="${2:?event name}"; shift 2 ;;
      --priority) priority="${2:?priority}"; shift 2 ;;
      --link)     link="${2:?link}"; shift 2 ;;   # on-origin deep link for the push tap
      --) shift; break ;;
      -*) say "usage: grave notify [--event <name>] [--priority min|low|default|high|urgent] [--link </path>] <title> [body]"; exit 1 ;;
      *) break ;;
    esac
  done
  local title="${1:-}"; shift || true
  local body="$*"
  if [[ -n "$event" ]]; then
    # Hook-driven path: tmux hooks and OnFailure units fire on EVERY box,
    # configured or not, and must never fail their caller — drop quietly when
    # no channel is configured or the event class is muted in NOTIFY_EVENTS.
    notify_configured || exit 0
    local e enabled=0
    for e in $NOTIFY_EVENTS; do [[ "$e" == "$event" ]] && enabled=1; done
    (( enabled )) || exit 0
    [[ -n "$title" ]] || exit 0
    notify_send "$title" "${body:-$event}" "$priority" "$link" "$event" || { log "notify: $event delivery failed${PUSH_ERROR:+ — $PUSH_ERROR}"; exit 0; }
    log "notify: $event — $title"
    exit 0
  fi
  [[ -n "$title" ]] || { say "usage: grave notify <title> [body]"; exit 1; }
  notify_configured || {
    bad "notifications are not configured"
    say "  Web Push (recommended, no account): dashboard ⚙️ settings → Notifications → 🔔 enable"
    say "  ntfy (optional relay): create $NOTIFY_ENV (chmod 600) with:"
    say "    NTFY_URL=https://ntfy.sh/<your-random-topic>"
    say "    NTFY_TOKEN=tk_...   # optional (authed/self-hosted servers)"
    say "  Full guide: docs/NOTIFICATIONS.md"
    exit 1
  }
  notify_send "$title" "$body" "$priority" "$link" "" || { bad "delivery failed on every channel${PUSH_ERROR:+ — $PUSH_ERROR}"; exit 1; }
  ok "notification sent"
  log "notify: manual — $title"
}

# ---------------------------------------------------------------- digest ----
# One page at ~08:00 (gravedecay-digest.timer) answering "what did the box do
# overnight?": agent sessions, spend, the doctor verdict, backup freshness.
# Delivery goes through `grave notify --event digest`, so it inherits the usual
# gating — a silent no-op when no channel is configured or the class is muted
# in ⚙️ settings — and the timer can safely fire on every box.
cmd_digest() { # grave digest [--print]  (--print: compose only, never page)
  local print_only=0
  [[ "${1:-}" == "--print" ]] && print_only=1

  # Agents: tmux sessions live right now, plus per-provider session counts from
  # the CLIs' own state dirs. T3 shells out to the same claude/codex binaries
  # with default state paths, so counting transcripts covers T3, tmux, and bare
  # CLI sessions alike — tmux alone would read "0" every morning on a T3-first
  # box. Claude: one .jsonl per session (subagent transcripts excluded);
  # Codex: one rollout-*.jsonl per session.
  local live_names live=0 claude_24h codex_24h
  live_names=$(tmuxa list-sessions -F '#S' 2>/dev/null | paste -sd, -) || live_names=""
  [[ -n "$live_names" ]] && live=$(awk -F, '{print NF}' <<<"$live_names")
  claude_24h=$(find "$HOME/.claude/projects" -name '*.jsonl' -not -path '*/subagents/*' \
               -mmin -1440 2>/dev/null | wc -l)
  codex_24h=$(find "$HOME/.codex/sessions" -name 'rollout-*.jsonl' -mmin -1440 2>/dev/null | wc -l)
  local agents_line="agents: $live tmux live${live_names:+ ($live_names)} · 24h sessions: $claude_24h Claude, $codex_24h Codex"

  # Spend: the dashboard already parses the Claude/Codex transcripts — ask it
  # on loopback instead of duplicating the parsers in bash. Its absence (gaming
  # mode, stopped) is itself morning news, so say so rather than omit the line.
  local usage spend_line="spend: dashboard stopped — no numbers this morning"
  usage=$(GRAVE_ROOT="$GRAVE_ROOT" DASH_PORT="${DASH_PORT:-4712}" python3 "$GRAVE_ROOT/scripts/gravedecay.py" --local-request /api/state 2>/dev/null \
          | jq -c '.usage // empty' 2>/dev/null) || usage=""
  if [[ -n "$usage" ]]; then
    spend_line=$(jq -r '
      def k: (. // 0) | if . >= 1000000 then "\((. / 100000 | round) / 10)M"
             elif . >= 1000 then "\((. / 1000) | round)k" else tostring end;
      "spend: Claude $\(((.claude.today.cost // 0) * 100 | round) / 100)"
      + " (\(.claude.today.msgs // 0) msgs)"
      + " · Codex \(((.codex.today.in // 0) + (.codex.today.cached // 0) + (.codex.today.out // 0)) | k) tok"
      + " (\(.codex.today.sessions // 0) sessions)"' <<<"$usage" 2>/dev/null) \
      || spend_line="spend: unavailable (unexpected /api/state shape)"
  fi

  # Doctor: the full contract run, with its own page suppressed — the digest
  # IS the morning page, and two notifications about one failure teach the
  # human to mute both.
  local doctor_line doctor_out doctor_rc
  set +e
  doctor_out=$("$0" doctor --no-page 2>/dev/null)
  doctor_rc=$?
  set -e
  if (( doctor_rc == 0 )); then
    doctor_line="doctor: ✓ all checks passed"
  else
    local fails; fails=$(grep -oE '[0-9]+ check\(s\) failed' <<<"$doctor_out" | tail -1)
    doctor_line="doctor: ✗ ${fails:-failing} — run: grave doctor"
  fi

  local backup_line="backup: none verified yet — run: grave backup"
  if [[ -f "$BACKUP_DIR/.last-verified" ]]; then
    local age_h=$(( ($(date +%s) - $(stat -c %Y "$BACKUP_DIR/.last-verified")) / 3600 ))
    backup_line="backup: ✓ verified ${age_h}h ago"
  fi

  local body title
  body=$(printf '%s\n' "🤖 $agents_line" "🧾 $spend_line" "🩺 $doctor_line" "🪦 $backup_line")
  # $HOSTNAME (bash builtin) — the hostname binary is an optional package on
  # Arch-family hosts and the digest must not depend on it.
  title="🌄 ${HOSTNAME:-gravedecay}: $live agent(s) live, doctor $([[ $doctor_rc == 0 ]] && echo ✓ || echo ✗)"
  say "$body"
  (( print_only )) && return 0
  cmd_notify --event digest --link "/grave/" "$title" "$body"
}

# --------------------------------------------------------------- upgrade ----
upgrade_repo() {
  local repo="${REPO_DIR:-$GRAVE_ROOT/repos/gravedecay}"
  [[ -d "$repo/.git" ]] || { bad "gravedecay checkout not found at $repo (set REPO_DIR in grave.conf)"; exit 1; }
  printf '%s\n' "$repo"
}

fetch_upgrade_refs() {
  local repo="$1"
  git -C "$repo" fetch --tags --prune -q origin
  git -C "$repo" remote set-head origin -a >/dev/null 2>&1 || true
}

cmd_releases() { # grave releases [--json] — list selectable stable releases
  local format="${1:-}" repo current checkout
  [[ -z "$format" || "$format" == "--json" ]] || { say "usage: grave releases [--json]"; exit 1; }
  repo=$(upgrade_repo)
  fetch_upgrade_refs "$repo"
  current=$(git -C "$repo" describe --tags --exact-match HEAD 2>/dev/null || true)
  # `git branch --show-current` arrived in Git 2.22; Leap 42.3 ships 2.13.
  checkout="${current:-$(git -C "$repo" symbolic-ref -q --short HEAD || true)}"
  [[ -n "$checkout" ]] || checkout=$(git -C "$repo" rev-parse --short HEAD)
  local tags
  tags=$(git -C "$repo" tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname \
    | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -20 || true)
  if [[ "$format" == "--json" ]]; then
    jq -n --arg current "$current" --arg checkout "$checkout" \
      --argjson releases "$(printf '%s\n' "$tags" | jq -Rsc 'split("\n")|map(select(length>0))')" \
      '{current:$current,checkout:$checkout,releases:$releases}'
  else
    say "gravedecay checkout: $checkout"
    [[ -n "$tags" ]] && printf '  %s\n' $tags || say "  no stable releases found"
  fi
}

cmd_upgrade() { # grave upgrade [--edge|--release|--tag vX.Y.Z]
  local channel="${UPGRADE_CHANNEL:-release}"
  local repo tag=""
  repo=$(upgrade_repo)
  while (($#)); do
    case "$1" in
      --edge) channel=edge; shift ;;
      --release) channel=release; shift ;;
      --tag)
        [[ $# -ge 2 && "$2" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
          say "usage: grave upgrade [--edge|--release|--tag vX.Y.Z]"; exit 1;
        }
        channel=tag; tag="$2"; shift 2 ;;
      *) say "usage: grave upgrade [--edge|--release|--tag vX.Y.Z]"; exit 1 ;;
    esac
  done
  if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
    bad "checkout at $repo has local changes — commit or stash them first"
    exit 1
  fi
  say "Fetching updates (${channel} channel)..."
  fetch_upgrade_refs "$repo"
  local target=""
  if [[ "$channel" == tag ]]; then
    git -C "$repo" rev-parse -q --verify "refs/tags/$tag^{commit}" >/dev/null || {
      bad "release $tag does not exist in the configured repository"
      exit 1
    }
    target="$tag"
  elif [[ "$channel" == release ]]; then
    target=$(git -C "$repo" tag -l 'v*' --sort=-v:refname | head -1)
    if [[ -z "$target" ]]; then
      say "${YLW}no release tags found — following main instead${RST}"
      channel=edge
    fi
  fi
  if [[ "$channel" == edge ]]; then
    local branch
    branch=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/master)
    branch=${branch#origin/}
    git -C "$repo" checkout -q "$branch"
    git -C "$repo" pull -q --ff-only origin "$branch"
    target="$branch"
  else
    git -C "$repo" checkout -q --detach "$target"
  fi
  ok "checked out $target ($(git -C "$repo" rev-parse --short HEAD))"
  say "Re-running the ritual (idempotent)..."
  bash "$repo/raise.sh"
  log "upgrade: $target"
}

# ------------------------------------------------------------------ logs ----
cmd_logs() {
  local target="${1:-grave}"
  case "$target" in
    t3|t3code)  sudo journalctl -u t3code -n 100 -f ;;
    dash|gravedecay) sudo journalctl -u gravedecay -n 100 -f ;;
    term)       sudo journalctl -u gravedecay-term -n 100 -f ;;
    ssh|sshd)   sudo journalctl -u sshd -n 100 -f ;;
    tailscale)  sudo journalctl -u tailscaled -n 100 -f ;;
    system)     sudo journalctl -p warning -n 100 -f ;;
    grave)      tail -n 50 -f "$LOG_FILE" ;;
    agent)      tail -n 100 -f "$GRAVE_ROOT"/agents/"${2:?agent name}"/session-*.log ;;
    workspace)  sudo journalctl -u "gravedecay-t3@${2:?workspace}" -u "gravedecay-term@${2}" -u "gravedecay-dashboard@${2}" -n 150 -f ;;
    *)          dk logs --tail 100 -f "$target" 2>/dev/null || \
                sudo journalctl -u "$target" -n 100 -f ;;
  esac
}

# ---------------------------------------------------------------- doctor ----
check() { # check <description> <command...>
  if "${@:2}" >/dev/null 2>&1; then ok "$1"; else bad "$1"; FAILURES=$((FAILURES+1)); fi
}
firewall_active() {
  # Not merely "a firewall is running": the appliance boundary (AGENTS.md §3) is
  # default-deny incoming (only ssh + tailscale0 allowed). A firewall that is up
  # but defaults to allow-in still violates it, so assert the default policy too.
  if command -v ufw >/dev/null; then
    local s; s=$(sudo ufw status verbose 2>/dev/null) || return 1
    grep -q "Status: active" <<<"$s" && grep -qE "Default: (deny|reject) \(incoming\)" <<<"$s"
  elif command -v firewall-cmd >/dev/null; then
    # On firewalld systems the doctor runs unprivileged. raise.sh grants
    # passwordless sudo for the READ-ONLY /usr/libexec/gravedecay/firewall-status
    # wrapper (raw firewall-cmd is never granted — it can rewrite any rule), so
    # the default-deny invariant can be verified without a polkit agent on
    # headless boxes; fall back to a direct call on boxes raised before the
    # wrapper existed. An array, not a string-split command — word-splitting
    # $fc was fragile and silently wrong if a path ever contained spaces.
    local fc=()
    if sudo -n /usr/libexec/gravedecay/firewall-status --state >/dev/null 2>&1; then
      fc=(sudo -n /usr/libexec/gravedecay/firewall-status)
    elif sudo -n firewall-cmd --state >/dev/null 2>&1; then fc=(sudo -n firewall-cmd)
    elif firewall-cmd --state >/dev/null 2>&1; then fc=(firewall-cmd)
    else return 1; fi
    "${fc[@]}" --state >/dev/null 2>&1 || return 1
    local zone; zone=$("${fc[@]}" --get-default-zone 2>/dev/null) || return 1
    # the default zone must not blanket-accept inbound (trusted, or target ACCEPT)
    [[ "$zone" != trusted ]] && ! "${fc[@]}" --info-zone="$zone" 2>/dev/null | grep -q 'target: ACCEPT'
  else return 1; fi
}
service_accounts_ok() {
  local unit properties account group
  for unit in t3code gravedecay gravedecay-term gravedecay-agents; do
    properties=$(systemctl show -p LoadState -p User -p Group "$unit") || return 1
    grep -qx 'LoadState=loaded' <<<"$properties" || continue
    account=$(sed -n 's/^User=//p' <<<"$properties")
    group=$(sed -n 's/^Group=//p' <<<"$properties")
    getent passwd "${account:-root}" >/dev/null || return 1
    [[ -z "$group" ]] || getent group "$group" >/dev/null || return 1
  done
}

appliance_owner_ok() {
  local owner entry home unit properties actual
  [[ ! -L "$GRAVE_ROOT/config/owner" ]] || return 1
  owner=$(cat "$GRAVE_ROOT/config/owner") || return 1
  [[ "$owner" =~ ^[a-z_][a-z0-9_-]{0,31}$ && "$owner" != root ]] || return 1
  entry=$(getent passwd "$owner") || return 1
  [[ "$(cut -d: -f3 <<<"$entry")" != 0 ]] || return 1
  home=$(cut -d: -f6 <<<"$entry")
  [[ -d "$home" && "$(stat -c %U "$GRAVE_ROOT")" == "$owner" && "$(stat -c %U "$home")" == "$owner" ]] || return 1
  # Only owner services belong here. gravedecay-net deliberately runs as root
  # to manage networking; workspace services have their own Unix identities.
  for unit in gravedecay t3code gravedecay-term gravedecay-upgrade gravedecay-backup gravedecay-digest gravedecay-gamewatch gravedecay-keepalive gravedecay-selfheal; do
    properties=$(systemctl show -p LoadState -p User "$unit") || return 1
    grep -qx 'LoadState=loaded' <<<"$properties" || continue
    actual=$(sed -n 's/^User=//p' <<<"$properties")
    [[ "$actual" == "$owner" ]] || return 1
  done
}

cmd_doctor() { # grave doctor [--no-page]
  # --no-page suppresses the failure notification: `grave digest` embeds the
  # doctor verdict in its own single morning page, and two pages about one
  # failing contract is how notifications get muted wholesale.
  local no_page=0
  [[ "${1:-}" == "--no-page" ]] && no_page=1
  FAILURES=0
  hdr "grave doctor"
  check "managed agent worktrees valid and writable" agent_worktrees_check
  if [[ "${MULTI_USER:-0}" == 0 ]]; then
    check "scheduled agent runner installed" test -r "$GRAVE_ROOT/scripts/agent-jobs.py"
    check "scheduled prompts and service valid" env GRAVE_ROOT="$GRAVE_ROOT" python3 "$GRAVE_ROOT/scripts/agent-jobs.py" check
  fi
  check "issue agent task runner installed" test -r "$GRAVE_ROOT/scripts/agent-task.py"
  check "issue tasks private and consistent with session metadata" agent_tasks_check
  check "development benchmark ready" python3 "$GRAVE_ROOT/scripts/benchmark.py" --root "$GRAVE_ROOT" check
  if [[ -f "$GRAVE_ROOT/config/leap42-compat" ]]; then
    check "Leap 42.3 compatibility runtime" "$GRAVE_ROOT/scripts/leap42-check"
  fi
  check "service users and groups resolve" service_accounts_ok
  if [[ -e "$GRAVE_ROOT/config/owner" ]]; then
    check "appliance owner matches data, home, and services" appliance_owner_ok
  else
    say "  ${YLW}– appliance owner not recorded yet — re-run raise.sh${RST}"
  fi
  check "tailscaled running"            systemctl is-active --quiet tailscaled
  # A Type=simple tailscaled races the localapi ExecStartPost against socket
  # creation and crash-loops (see raise.sh). notify is the invariant that keeps
  # the box on the tailnet across reboots; upstream's packaged unit sets it too.
  check "tailscaled unit uses Type=notify" bash -c "systemctl show -p Type tailscaled | grep -qx 'Type=notify'"
  check "tailscale logged in"           tailscale status --peers=false
  # OpenSSH server unit is `sshd` on Arch/Fedora, `ssh` on Debian/Ubuntu.
  check "ssh server running"            bash -c "systemctl is-active --quiet sshd || systemctl is-active --quiet ssh"
  if [[ "${CHECK_FIREWALL:-1}" == 1 ]]; then
    check "firewall active"             firewall_active
  else
    say "  ${YLW}– firewall check relaxed (LAN kept open for gaming; boundary is 127.0.0.1 + tailnet)${RST}"
  fi
  check "ssh password auth disabled"    bash -c "sudo sshd -T | grep -qi 'passwordauthentication no'"
  if [[ "${CHECK_SLEEP_MASKED:-0}" == 1 ]]; then
    check "sleep targets masked"        bash -c '[[ $(systemctl is-enabled sleep.target) == masked ]]'
  fi
  if [[ "${CHECK_LID_IGNORED:-0}" == 1 ]]; then
    check "lid switch ignored"          bash -c '[[ $(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager HandleLidSwitch) == *ignore* ]]'
  fi
  if [[ "${CHECK_DOCKER_SUBVOL:-0}" == 1 ]]; then
    check "/var/lib/docker on own subvol" bash -c 'findmnt -n /var/lib/docker | grep -q subvol'
  fi
  if [[ "${CHECK_SNAPPER:-0}" == 1 ]]; then
    check "snapper config for GRAVE_ROOT" sudo snapper -c "${SNAPPER_CONFIG:-srv}" list
  fi
  if [[ "${CHECK_IMMUTABLE_ROOT:-0}" == 1 ]]; then
    # On an image-based rootfs (SteamOS) an OS update replaces /usr. Everything
    # we rely on must therefore live off the root mount, or it silently vanishes.
    check "GRAVE_ROOT off the immutable root mount" \
      bash -c "[[ \"\$(findmnt -no TARGET --target '$GRAVE_ROOT')\" != / ]]"
    check "durable toolchain under \$HOME (Homebrew)" command -v brew
    check "Docker is rootless (survives OS updates)" \
      bash -c "[[ '${DOCKER_ROOTLESS:-0}' == 1 ]]"
    # /etc drift after a SteamOS update — the self-heal boot unit drops this
    # marker when a config file it depends on went missing (see docs/STEAMOS.md).
    if [[ -f "$GRAVE_ROOT/logs/DRIFT-DETECTED" ]]; then
      bad "config drift after OS update — re-run raise.sh (see $GRAVE_ROOT/logs/selfheal.log)"
      FAILURES=$((FAILURES+1))
    fi
  fi
  # --- reboot-readiness: "active" isn't "enabled". A unit that's running now
  # but not enabled won't come back after a reboot, so surviving a reboot is
  # only real if these pass. (Doctor is the contract.)
  local u
  for u in "${ALWAYS_ON[@]}"; do
    systemctl cat "$u.service" >/dev/null 2>&1 || continue   # unit not on this host
    # The owner terminal is deliberately replaced by per-workspace terminals
    # in multi-user mode; its disabled state is enforced below as a boundary
    # invariant, rather than being misreported as a boot-readiness failure.
    [[ "${MULTI_USER:-0}" == 1 && "$u" == gravedecay-term ]] && continue
    check "$u enabled (starts at boot)"  systemctl is-enabled --quiet "$u"
  done
  # DEV_SERVICES enablement IS the boot-mode toggle: `grave bootmode gaming`
  # deliberately disables them, so a disabled dev service is an expected state,
  # not a reboot-readiness failure. Report the mode instead of counting a failure.
  for u in "${DEV_SERVICES[@]}"; do
    systemctl cat "$u.service" >/dev/null 2>&1 || continue
    if systemctl is-enabled --quiet "$u"; then ok "$u enabled (boot mode: developer)"
    else say "  ${YLW}– $u disabled at boot (boot mode: gaming — 'grave developer' to wake)${RST}"; fi
  done
  if [[ "${DOCKER_ROOTLESS:-0}" == 1 ]]; then
    check "rootless docker enabled at boot"   systemctl --user is-enabled --quiet docker
    check "linger on (user services start without login)" \
      bash -c "loginctl show-user \"\$(id -un)\" 2>/dev/null | grep -q 'Linger=yes'"
  fi
  if [[ -r "$GAMEWATCH_PREFERENCE" ]]; then
    local gamewatch_preference
    gamewatch_preference="$(tr -d '[:space:]' <"$GAMEWATCH_PREFERENCE")"
    case "$gamewatch_preference" in
      on)  check "gamewatch preference synced (on)" test -e "$GRAVE_ROOT/config/gamewatch.on" ;;
      off) check "gamewatch preference synced (off)" test ! -e "$GRAVE_ROOT/config/gamewatch.on" ;;
      *)   bad "invalid gamewatch preference '$gamewatch_preference' (expected on or off)"
           FAILURES=$((FAILURES+1)) ;;
    esac
  else
    say "  ${YLW}– gamewatch preference not initialized — re-run raise.sh${RST}"
  fi
  if [[ -e "$GRAVE_ROOT/config/gamewatch.on" ]]; then
    if systemctl cat gravedecay-gamewatch.service >/dev/null 2>&1; then
      check "game-mode watcher running"   systemctl is-active --quiet gravedecay-gamewatch
      check "game-mode watcher enabled"   systemctl is-enabled --quiet gravedecay-gamewatch
      local detector_report detector_rc
      set +e
      detector_report="$($GRAVE_ROOT/scripts/gravedecay-gamewatch doctor 2>&1)"
      detector_rc=$?
      set -e
      case "$detector_rc" in
        0) ok "game detection signals evaluable ($detector_report)" ;;
        2) say "  ${YLW}– game detection has only the fragile process fallback ($detector_report)${RST}" ;;
        *) bad "game detection signals unusable ($detector_report)"; FAILURES=$((FAILURES+1)) ;;
      esac
    else
      bad "gamewatch on but gravedecay-gamewatch.service not installed — 'grave gamewatch off' or re-run raise.sh"
      FAILURES=$((FAILURES+1))
    fi
  fi
  if [[ -e "$GRAVE_ROOT/config/keepalive.on" ]]; then
    if systemctl cat gravedecay-keepalive.service >/dev/null 2>&1; then
      check "tailnet keepalive running"   systemctl is-active --quiet gravedecay-keepalive
      check "tailnet keepalive enabled"   systemctl is-enabled --quiet gravedecay-keepalive
    else
      bad "keepalive on but gravedecay-keepalive.service not installed — 'grave keepalive off' or re-raise"
      FAILURES=$((FAILURES+1))
    fi
  fi
  if dkctl is-active --quiet docker; then
    check "docker healthy"              dk info
    # dk is a shell function, so expand the real argv for the piped subshell
    check "no LAN-exposed containers"   bash -c "! ${_DOCKER[*]} ps --format '{{.Ports}}' | grep -E '0\.0\.0\.0|\[::\]'"
  else
    say "  ${YLW}– docker stopped (gaming mode?)${RST}"
  fi
  if systemctl is-active --quiet t3code; then
    check "t3 CLI runs"                   t3 --version
    check "t3code answering"            curl -sf -o /dev/null "http://127.0.0.1:$T3_PORT/"
  else
    say "  ${YLW}– t3code stopped (gaming mode?)${RST}"
  fi
  if [[ -e "$T3_ACTIVITY_ENV" ]]; then
    check "T3 activity secret is private" bash -c "[[ \$(stat -c %a '$T3_ACTIVITY_ENV') == 600 ]]"
    check "T3 activity configuration valid" t3_activity_configured
    if t3_activity_configured; then
      check "T3 activity source readable" t3_activity_ok
    fi
  fi
  # --- T3 Connect: the mode file is the operator's declared intent; the CLI's
  # persisted state must match it, or a relay tunnel is running (or silently
  # dead) without anyone having decided that. See docs/SECURITY.md.
  local tc_mode tc_json
  tc_mode="$(t3_connect_mode)"
  if [[ "$tc_mode" != off ]]; then
    check "T3 Connect credentials private and usable by service user" t3_connect_files_ok
  fi
  if tc_json="$(t3_connect_json)" && [[ -n "$tc_json" ]]; then
    case "$tc_mode" in
      off)
        check "t3 connect disabled (mode: off)"       t3c_is '.desired|not' "$tc_json"
        # [c] defeats pgrep's self-match: the pattern is in bash -c's own argv
        check "no relay tunnel process (mode: off)"   bash -c "! pgrep -f '$T3_BASE_DIR/.*[c]loudflared' >/dev/null"
        ;;
      publish)
        check "t3 connect link desired (mode: publish)"   t3c_is '.desired' "$tc_json"
        check "t3 connect publishes agent activity"       t3c_is '.publishAgentActivity' "$tc_json"
        # publish-only explicitly runs NO managed tunnel — transport stays tailnet
        check "no relay tunnel process (publish-only)"    bash -c "! pgrep -f '$T3_BASE_DIR/.*[c]loudflared' >/dev/null"
        if systemctl is-active --quiet t3code; then
          check "t3 connect environment linked"           t3c_is '.linked' "$tc_json"
        fi
        ;;
      full)
        check "t3 connect link desired (mode: full)"      t3c_is '.desired' "$tc_json"
        check "t3 connect publishes agent activity"       t3c_is '.publishAgentActivity' "$tc_json"
        check "relay client installed"                    t3c_is '.relayClient.status == "available"' "$tc_json"
        if systemctl is-active --quiet t3code; then
          check "t3 connect environment linked"           t3c_is '.linked' "$tc_json"
          check "relay tunnel process running"            pgrep -f "$T3_BASE_DIR/.*[c]loudflared"
          if ! t3c_is '.linked' "$tc_json"; then
            say "     run 'grave t3 connect diagnose' for relay errors and registered environments"
          fi
        fi
        ;;
    esac
  elif [[ "$tc_mode" != off ]]; then
    bad "t3 connect mode is $tc_mode but its status is unreadable — run 'grave t3 connect status'"
    FAILURES=$((FAILURES+1))
  fi
  # Stray Connect identities: a bare `t3` run or the desktop app links the
  # DEFAULT profile (~/.t3) — a second relay identity outside this contract.
  # A warning, not a failure: transient desktop-app use on the box is legal,
  # but it should never be the way this appliance is exposed.
  # `.linked` matters more than `.desired` here: the desktop app links without
  # ever setting the CLI's desired flag, so testing intent alone stayed silent
  # while the stray profile held the account's environment — the appliance's
  # own link then 403s with nothing pointing at the cause.
  if t3_owner_run bash -c '[[ -d "$HOME/.t3" ]]' 2>/dev/null && t3c_is '.desired or .linked' "$(t3_owner_run t3 connect status --json 2>/dev/null)"; then
    say "  ${YLW}– stray T3 Connect link on the default t3 profile (~/.t3) — not this appliance's instance. It may hold a managed-tunnel slot and make this box's link 403; 't3 connect unlink' it if unintended, and check the slot was really released (unlink degrades to local-only when that profile holds no CLI credential — see docs/SECURITY.md)${RST}"
  fi
  if pgrep -af 'cloudflared.*tunnel run' 2>/dev/null | grep -v "$T3_BASE_DIR" | grep -q .; then
    say "  ${YLW}– a relay tunnel is running outside the appliance T3 instance (desktop app?) — the box is exposed beyond the declared Connect mode${RST}"
  fi
  if systemctl is-active --quiet gravedecay; then
    if [[ "${MULTI_USER:-0}" == 1 ]]; then
      check "gravedecay maintenance health" sudo -n "$0" __dashboard-health
      check "dashboard summary API contract" dashboard_summary_ok
      check "dashboard running installed build" dashboard_build_ok
      check "dashboard serving installed shell" dashboard_shell_ok
      check "dashboard self-updater installed" systemctl cat gravedecay-upgrade.service
      check "selectable release updater installed" systemctl cat 'gravedecay-upgrade@.service'
      check "dashboard PWA owns app origin" dashboard_manifest_ok
      check "dashboard offline shell ready" dashboard_sw_ok
      check "dashboard serving installed offline page" dashboard_offline_ok
    else
      check "dashboard identity and local maintenance boundary" env GRAVE_ROOT="$GRAVE_ROOT" DASH_PORT="$DASH_PORT" python3 "$GRAVE_ROOT/scripts/gravedecay.py" --check-auth
      check "gravedecay answering"         curl -sf -o /dev/null "http://127.0.0.1:$DASH_PORT/healthz"
    check "dashboard summary API contract" bash -c \
      "curl -sf 'http://127.0.0.1:$DASH_PORT/api/v1/summary' | jq -e '.product == \"gravedecay\" and .api_version == 1' >/dev/null"
    check "dashboard running installed build" bash -c \
      "test \"\$(sha256sum '$GRAVE_ROOT/scripts/gravedecay.py' | cut -d' ' -f1)\" = \"\$(curl -sf 'http://127.0.0.1:$DASH_PORT/healthz' | jq -r .build)\""
    # The PWA shell left the Python file; a stale index.html is the same
    # class of bug as a stale gravedecay.py. Compare the on-disk asset
    # (sha256sum) to the hash the running process reports for that file.
    check "dashboard serving installed shell" bash -c \
      "test \"\$(sha256sum '$GRAVE_ROOT/scripts/dashboard-static/index.html' | cut -d' ' -f1)\" = \"\$(curl -sf 'http://127.0.0.1:$DASH_PORT/healthz' | jq -r .shell)\""
    check "dashboard self-updater installed" systemctl cat gravedecay-upgrade.service
    check "selectable release updater installed" systemctl cat 'gravedecay-upgrade@.service'
    check "dashboard PWA owns app origin" bash -c \
      "curl -sf 'http://127.0.0.1:$DASH_PORT/manifest.webmanifest' | grep -q '\"scope\": \"/\"'"
    check "dashboard offline shell ready" bash -c \
      "curl -sf -D - -o /dev/null 'http://127.0.0.1:$DASH_PORT/sw.js' | grep -qi '^Service-Worker-Allowed: /'"
    # The worker's cache name embeds a digest of offline.html (healthz.sw).
    # A mismatch means installed PWAs are pinning an outdated offline page —
    # the browser only re-installs a worker whose served bytes changed.
    check "dashboard serving installed offline page" bash -c \
      "test \"\$(sha256sum '$GRAVE_ROOT/scripts/dashboard-static/offline.html' | cut -d' ' -f1 | cut -c-12)\" = \"\$(curl -sf 'http://127.0.0.1:$DASH_PORT/healthz' | jq -r .sw)\""
    fi
  else
    say "  ${YLW}– gravedecay stopped${RST}"
  fi
  if systemctl is-active --quiet gravedecay-term; then
    check "web terminal answering"       curl -sf -o /dev/null "http://127.0.0.1:${TERM_PORT:-4713}/"
    # Stock ttyd 1.7.7 serves a frontend that drops OSC 52 — clipboard copy
    # out of tmux silently dies (docs/TERMINAL.md). The unit must serve the
    # raise.sh-built index (ttyd -I), which carries this marker.
    check "web terminal clipboard frontend" bash -c \
      "curl -sf 'http://127.0.0.1:${TERM_PORT:-4713}/' | grep -q gravedecay-term-frontend"
  else
    say "  ${YLW}– web terminal stopped${RST}"
  fi
  if systemctl cat gravedecay-net.service >/dev/null 2>&1; then
    if systemctl is-active --quiet gravedecay-net; then
      check "gravenet answering"         curl -sf -o /dev/null "http://127.0.0.1:${NET_PORT:-4714}/healthz"
    else
      say "  ${YLW}– gravenet stopped${RST}"
    fi
  fi
  check "backups dir writable"          test -w "$BACKUP_DIR"
  # Backup freshness (#112): .last-verified is written only after every artifact
  # in a run was created AND verified, so "fresh marker" means "a restorable
  # backup exists", not "the timer fired". Gated on the timer unit so installs
  # that predate it degrade to a nudge instead of a failure.
  if systemctl cat gravedecay-backup.timer >/dev/null 2>&1; then
    check "backup timer enabled"        systemctl is-enabled --quiet gravedecay-backup.timer
    check "backup timer active"         systemctl is-active --quiet gravedecay-backup.timer
    if [[ -f "$BACKUP_DIR/.last-verified" ]]; then
      check "verified backup newer than ${BACKUP_MAX_AGE_DAYS}d" bash -c \
        "(( \$(date +%s) - \$(stat -c %Y '$BACKUP_DIR/.last-verified') < ${BACKUP_MAX_AGE_DAYS} * 86400 ))"
    else
      say "  ${YLW}– no verified backup yet — first nightly run pending (or now: grave backup)${RST}"
    fi
  else
    say "  ${YLW}– backup timer not installed — re-run raise.sh${RST}"
  fi
  # Notification inbox (#119): bodies carry private detail (session names,
  # doctor output), so the durable copy must stay owner-only.
  if [[ -f "$GRAVE_ROOT/logs/notifications.jsonl" ]]; then
    check "notification inbox is private" bash -c "[[ \$(stat -c %a '$GRAVE_ROOT/logs/notifications.jsonl') == 600 ]]"
  fi
  # Morning digest (#106): same shape as the backup timer — the schedule is the
  # invariant; whether it actually pages is the human's ⚙️ preference (digest
  # class in NOTIFY_EVENTS), which doctor deliberately does not second-guess.
  if systemctl cat gravedecay-digest.timer >/dev/null 2>&1; then
    check "digest timer enabled"        systemctl is-enabled --quiet gravedecay-digest.timer
    check "digest timer active"         systemctl is-active --quiet gravedecay-digest.timer
  else
    say "  ${YLW}– digest timer not installed — re-run raise.sh${RST}"
  fi
  # Notification invariants, each gated on its channel being opted into: a
  # dead channel silently eats every page, so reachability is an invariant,
  # not a nicety (see docs/NOTIFICATIONS.md).
  if [[ -e "$NOTIFY_ENV" ]]; then
    check "ntfy channel reachable"      notify_reachable
    check "ntfy secret is private"      bash -c "[[ \$(stat -c %a '$NOTIFY_ENV') == 600 ]]"
  fi
  if push_ready; then
    check "push subscription store is private" bash -c "[[ \$(stat -c %a '$PUSH_SUBS') == 600 ]]"
    check "push VAPID key is private"   bash -c "[[ \$(stat -c %a '$GRAVE_ROOT/config/secrets/vapid.pem') == 600 ]]"
    # The dashboard does the Web Push crypto — ask it, don't guess: 501 here
    # means python3-cryptography vanished (e.g. after an OS update).
    if [[ "${MULTI_USER:-0}" == 1 ]]; then
      check "web push sender ready"     dashboard_push_ok
    else
      check "web push sender ready"     dashboard_local_push_ok
    fi
  fi
  if [[ -e "$NOTIFY_ENV" ]] || push_ready; then
    check "failure notifier installed"  systemctl cat 'gravedecay-notify@.service'
    check "agent notify helper installed" test -x "$AGENT_NOTIFY"
    check "Claude notify hooks installed" claude_notify_hook_present
    check "Codex notify hook installed"   codex_notify_hook_present
  fi
  if [[ -e "$GRAVE_ROOT/config/workspaces.json" ]]; then
    # Route through the root helper: the workspace doctor stats root-owned 0700
    # service-env files and grave-<slug>-owned homes, which the invoking owner
    # can't traverse — run unprivileged it raises PermissionError and fails on a
    # healthy box. Same path as every other `grave users` operation.
    if workspace_doctor_ok; then ok "workspace registry and ownership"; else
      bad "workspace registry and ownership"; FAILURES=$((FAILURES+1))
    fi
  fi
  if [[ "${MULTI_USER:-0}" == 1 ]]; then
    check "identity gateway loopback health" curl -sf -o /dev/null "http://127.0.0.1:${GATEWAY_PORT:-4710}/healthz"
    check "gateway capability is private" bash -c "[[ \$(stat -c %a '$GRAVE_ROOT/config/secrets/gateway-token') == 600 ]]"
    check "gateway is the Serve origin" bash -c "tailscale serve status | grep -q '127.0.0.1:${GATEWAY_PORT:-4710}'"
    check "Tailscale LocalAPI hidden from workspaces" bash -c "[[ \$(stat -c %a /run/tailscale/tailscaled.sock) == 660 ]]"
    check "multi-user loopback boundary active" systemctl is-active --quiet gravedecay-boundary.service
    check "multi-user loopback boundary enabled" systemctl is-enabled --quiet gravedecay-boundary.service
    check "identity gateway enabled" systemctl is-enabled --quiet gravedecay-gateway.service
    check "multi-user loopback boundary rules" sudo -n "$0" __boundary-status
    check "legacy T3 disabled" legacy_t3_disabled
    check "legacy terminal disabled" legacy_terminal_disabled
  fi
  echo
  if (( FAILURES > 0 && ! no_page )); then
    # Page the human about a failing contract (muteable via NOTIFY_EVENTS,
    # silent no-op when unconfigured). Subshell: cmd_notify exits, doctor must
    # still print its own verdict below.
    ( cmd_notify --event doctor --priority high --link "/grave/?tab=system" "doctor: $FAILURES check(s) failed" "on $(hostname) — run: grave doctor" ) || true
  fi
  if (( FAILURES == 0 )); then say "${GRN}${BLD}All checks passed.${RST}"; else say "${RED}${BLD}$FAILURES check(s) failed.${RST}"; exit 1; fi
}

cmd_dashboard_health() {
  [[ $EUID == 0 ]] || { bad "internal dashboard health helper requires root"; exit 1; }
  curl -sf -o /dev/null "http://127.0.0.1:$DASH_PORT/healthz"
}

cmd_dashboard_probe() {
  [[ $EUID == 0 ]] || { bad "internal dashboard probe requires root"; exit 1; }
  local path="$1" include=""
  case "$path" in
    health) path=/healthz ;;
    summary) path=/api/v1/summary ;;
    manifest) path=/manifest.webmanifest ;;
    sw) path=/sw.js; include=1 ;;
    push-key) path=/api/push-key ;;
    *) bad "unknown dashboard probe"; exit 2 ;;
  esac
  local token local_token=""
  if [[ "$path" == /api/push-key ]]; then
    local_token=$(cat "$GRAVE_ROOT/config/secrets/dashboard-local-token") || return 1
    [[ "$local_token" =~ ^[0-9a-f]{64}$ ]] || return 1
  fi
  token=$(sed -n 's/^GRAVEDECAY_BACKEND_TOKEN=//p' "$GRAVE_ROOT/config/secrets/admin-dashboard.env" | head -1)
  [[ "$path" == /healthz || ${#token} -ge 32 ]] || { bad "dashboard capability missing"; exit 1; }
  {
    printf 'url = "http://127.0.0.1:%s%s"\nfail\nsilent\nshow-error\n' "$DASH_PORT" "$path"
    [[ -z "$local_token" ]] || printf 'header = "X-Grave-Local-Token: %s"\n' "$local_token"
    [[ -z "$include" ]] || printf 'include\n'
    [[ "$path" != /healthz ]] && printf 'header = "X-Grave-Backend-Token: %s"\n' "$token"
  } | curl --config -
}

dashboard_local_push_ok() { GRAVE_ROOT="$GRAVE_ROOT" DASH_PORT="$DASH_PORT" python3 "$GRAVE_ROOT/scripts/gravedecay.py" --local-request /api/push-key | jq -e .ok >/dev/null; }

dashboard_probe() { sudo -n "$0" __dashboard-probe "$1"; }
dashboard_summary_ok() { dashboard_probe summary | jq -e '.product == "gravedecay" and .api_version == 1' >/dev/null; }
dashboard_build_ok() { [[ "$(sha256sum "$GRAVE_ROOT/scripts/gravedecay.py" | cut -d' ' -f1)" == "$(dashboard_probe health | jq -r .build)" ]]; }
dashboard_shell_ok() { [[ "$(sha256sum "$GRAVE_ROOT/scripts/dashboard-static/index.html" | cut -d' ' -f1)" == "$(dashboard_probe health | jq -r .shell)" ]]; }
dashboard_manifest_ok() { dashboard_probe manifest | grep -q '"scope": "/"'; }
dashboard_sw_ok() { dashboard_probe sw | grep -qi '^Service-Worker-Allowed: /'; }
dashboard_offline_ok() { [[ "$(sha256sum "$GRAVE_ROOT/scripts/dashboard-static/offline.html" | cut -d' ' -f1 | cut -c-12)" == "$(dashboard_probe health | jq -r .sw)" ]]; }
dashboard_push_ok() { dashboard_probe push-key | jq -e .ok >/dev/null; }
t3_activity_configured() { local url; [[ -r "$T3_ACTIVITY_ENV" ]] || return; url=$(sed -n 's/^T3_ACTIVITY_URL=//p' "$T3_ACTIVITY_ENV" | head -1); [[ "$url" =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]+)?/?$ || "$url" =~ ^https://[A-Za-z0-9.-]+\.ts\.net(:[0-9]+)?/?$ ]] && grep -q '^T3_ACTIVITY_TOKEN=.' "$T3_ACTIVITY_ENV" && grep -q '^T3_ACTIVITY_ENVIRONMENT=.' "$T3_ACTIVITY_ENV" && grep -q '^T3_ACTIVITY_ENVIRONMENT_ID=.' "$T3_ACTIVITY_ENV"; }
t3_activity_ok() { local url token; url=$(sed -n 's/^T3_ACTIVITY_URL=//p' "$T3_ACTIVITY_ENV" | head -1); token=$(sed -n 's/^T3_ACTIVITY_TOKEN=//p' "$T3_ACTIVITY_ENV" | head -1); { printf 'url = "%s/api/orchestration/shell"\nfail\nsilent\nmax-time = 3\nheader = "Authorization: Bearer %s"\n' "${url%/}" "$token"; } | curl --config - | jq -e '.projects|type == "array"' >/dev/null; }
legacy_t3_disabled() { ! systemctl is-enabled --quiet t3code && ! systemctl is-active --quiet t3code; }
legacy_terminal_disabled() { ! systemctl is-enabled --quiet gravedecay-term && ! systemctl is-active --quiet gravedecay-term; }
workspace_doctor_ok() {
  local report
  report=$(sudo -n "$0" __users doctor 2>&1) && return
  # Unlike routine probes this reports the exact root-helper invariant, so
  # doctor failures are actionable without rerunning an internal command.
  printf '%s\n' "$report" >&2
  return 1
}

cmd_boundary_apply() {
  [[ $EUID == 0 ]] || { bad "internal boundary helper requires root"; exit 1; }
  command -v nft >/dev/null || { bad "multi-user mode requires nftables; install nftables and rerun raise.sh"; exit 1; }
  nft list ruleset >/dev/null || { bad "nftables kernel enforcement is unavailable"; exit 1; }
  local delete=""
  nft list table inet gravedecay >/dev/null 2>&1 && delete='delete table inet gravedecay'
  {
    [[ -z "$delete" ]] || printf '%s\n' "$delete"
    cat <<'EOF'
add table inet gravedecay
add chain inet gravedecay output { type filter hook output priority filter; policy accept; }
add rule inet gravedecay output meta skuid != 0 tcp dport { 4711-4713, 4810-5109 } reject
EOF
  } | nft -f -
  cmd_boundary_status
}

cmd_boundary_status() {
  [[ $EUID == 0 ]] || { bad "internal boundary helper requires root"; exit 1; }
  local chain
  chain=$(nft list chain inet gravedecay output)
  grep -Fq 'type filter hook output priority filter; policy accept;' <<<"$chain"
  grep -Eq 'meta skuid != 0 tcp dport \{ 4711-4713, 4810-5109 \} reject' <<<"$chain"
}

cmd_boundary_remove() {
  [[ $EUID == 0 ]] || { bad "internal boundary helper requires root"; exit 1; }
  command -v nft >/dev/null && nft delete table inet gravedecay >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------- backup ----
backup_tar() { # backup_tar <label> <out.tar.gz> <tar args…> — create + verify
  # Listing the archive back proves it decompresses end to end — a truncated
  # write (disk full mid-run) otherwise looks identical to a good backup until
  # restore day. Counts into cmd_backup's `failures` (bash dynamic scope).
  local label="$1" out="$2"; shift 2
  if tar -czf "$out" "$@" 2>/dev/null && tar -tzf "$out" >/dev/null 2>&1; then
    ok "$label"
  else
    bad "$label failed"; failures=$((failures+1))
  fi
}

cmd_backup() {
  local include_secrets=0
  [[ "${1:-}" == "--include-secrets" ]] && include_secrets=1
  need_root_helper
  local ts dest failures=0; ts=$(date +%Y%m%d-%H%M%S); dest="$BACKUP_DIR/$ts"
  mkdir -p "$dest"/{repos,volumes,configs}
  say "Backing up to $dest"

  # Every artifact is verified as it lands and any miss fails the whole run
  # (#112): the nightly unit must land in failed state — and page via
  # OnFailure= — rather than let retention quietly age out the last good copy.
  # The .last-verified marker is written only on a clean run, so doctor's
  # freshness check means "a backup that verifies", not "the timer fired".
  local repo name
  for repo in "$GRAVE_ROOT"/repos/*/; do
    [[ -d "$repo/.git" ]] || continue
    name=$(basename "$repo")
    # A repo with no commits has nothing to lose and `bundle create --all`
    # errors on it — skip it rather than page every night about a fresh clone.
    git -C "$repo" rev-parse --quiet --verify HEAD >/dev/null 2>&1 \
      || { say "  ${YLW}– repo $name has no commits — skipped${RST}"; continue; }
    # verify needs a repository for context (bare `git bundle verify` dies with
    # "need a repository" from the timer's cwd or any non-repo shell) — run it
    # -C the source repo, same as create.
    if git -C "$repo" bundle create "$dest/repos/$name.bundle" --all 2>/dev/null \
       && git -C "$repo" bundle verify "$dest/repos/$name.bundle" >/dev/null 2>&1; then
      ok "repo $name (git bundle, verified)"
    else
      bad "repo $name bundle failed"; failures=$((failures+1))
    fi
  done

  local excludes=(--exclude='config/secrets' --exclude='workspaces/*/config/secrets' --exclude='workspaces/*/.config/gh' --exclude='workspaces/*/.codex/auth.json' --exclude='workspaces/*/.claude/.credentials.json' --exclude='workspaces/*/.claude.json')
  (( include_secrets )) && excludes=()
  backup_tar "platform config" "$dest/configs/grave-platform.tar.gz" \
    "${excludes[@]}" -C "$GRAVE_ROOT" config docker docs scripts
  if [[ -d "$GRAVE_ROOT/workspaces" ]]; then
    backup_tar "workspace homes, state, and dirty worktrees" "$dest/configs/workspaces.tar.gz" \
      "${excludes[@]}" -C "$GRAVE_ROOT" workspaces
  fi
  if [[ -d "$GRAVE_ROOT/worktrees" ]]; then
    # Bundles above preserve branches, but not staged/dirty/untracked files.
    # Keep the raw checkout files and lifecycle records as a recovery archive.
    local agent_paths=(worktrees) metadata name dir head branch recovery
    recovery=$(mktemp -d "$dest/configs/.agent-recovery.XXXXXX")
    mkdir -p "$recovery/recovery"
    for metadata in "$GRAVE_ROOT"/agents/*/meta.json; do
      [[ -f "$metadata" ]] || continue
      jq -e '.worktree == true' "$metadata" >/dev/null || continue
      agent_paths+=("${metadata#"$GRAVE_ROOT/"}")
      jq -e '.pruned != true' "$metadata" >/dev/null || continue
      name=$(basename "$(dirname "$metadata")")
      if ! agent_worktree_valid "$name"; then
        bad "invalid agent worktree $name"; failures=$((failures+1)); continue
      fi
      dir=$(jq -r '.dir' "$metadata")
      mkdir -p "$recovery/recovery/$name"
      # The index can hold a different version from the file on disk. Keep
      # its binary patch against the recorded HEAD, plus that exact commit
      # (including detached work that the source repo's --all may not bundle).
      if head=$(git -C "$dir" rev-parse HEAD) &&
         git -C "$dir" diff --cached --binary "$head" >"$recovery/recovery/$name/staged.patch" &&
         git -C "$dir" bundle create "$recovery/recovery/$name/commits.bundle" HEAD &&
         git -C "$dir" bundle verify "$recovery/recovery/$name/commits.bundle" >/dev/null 2>&1; then
        branch=$(git -C "$dir" symbolic-ref --short -q HEAD) || branch=""
        jq -n --arg head "$head" --arg branch "$branch" '{head:$head,branch:$branch}' \
          >"$recovery/recovery/$name/head.json"
      else
        bad "agent index/commit backup failed: $name"; failures=$((failures+1))
      fi
    done
    (umask 077; failures=0
      backup_tar "agent worktree files and metadata" "$dest/configs/agent-worktrees.tar.gz" \
        -C "$GRAVE_ROOT" "${agent_paths[@]}" -C "$recovery" recovery
      (( failures == 0 ))) || failures=$((failures+1))
    rm -rf "$recovery"
  fi
  printf '{"version":1,"secrets_included":%s,"created":"%s"}\n' "$([[ $include_secrets == 1 ]] && echo true || echo false)" "$(date -u +%FT%TZ)" >"$dest/manifest.json"
  local d
  for d in "${AGENT_CONFIG_DIRS[@]}"; do
    [[ -e "$HOME/$d" ]] && backup_tar "agent config $d" "$dest/configs/${d#.}.tar.gz" \
      --exclude="$d/auth.json" --exclude="$d/.credentials.json" -C "$HOME" "$d"
  done
  [[ -d "$GRAVE_ROOT/agents/t3code" ]] && backup_tar "t3code state" "$dest/configs/t3code-state.tar.gz" \
    -C "$GRAVE_ROOT/agents" t3code

  if dkctl is-active --quiet docker; then
    local vol
    for vol in $(dk volume ls -q | grep -vE '^[0-9a-f]{64}$'); do
      if dk run --rm -v "$vol":/data:ro -v "$dest/volumes":/backup alpine \
           tar -czf "/backup/$vol.tar.gz" -C /data . \
         && tar -tzf "$dest/volumes/$vol.tar.gz" >/dev/null 2>&1; then
        ok "volume $vol (verified)"
      else
        bad "volume $vol failed"; failures=$((failures+1))
      fi
    done
  else
    say "  ${YLW}docker stopped — volumes skipped this run${RST}"
  fi

  # retention — only timestamped backups (YYYYMMDD-HHMMSS). $BACKUP_DIR also holds
  # migration-* and removed-workspaces/, which sort AFTER the digits and would
  # otherwise occupy the "keep last N" slots, pruning real backups early (and
  # risk rm-ing non-backup dirs). Filter to the backup name shape.
  local old
  while IFS= read -r old; do
    rm -rf "$BACKUP_DIR/${old:?}"; say "  pruned old backup $old"
  done < <(ls -1 "$BACKUP_DIR" 2>/dev/null | grep -E '^[0-9]{8}-[0-9]{6}$' | sort | head -n -"$BACKUP_KEEP")
  if (( failures > 0 )); then
    log "backup: $ts FAILED ($failures artifact(s))"
    bad "backup incomplete: $failures artifact(s) failed — kept at $dest; freshness marker not updated"
    exit 1
  fi
  date -u +%FT%TZ >"$BACKUP_DIR/.last-verified"
  log "backup: $ts complete"
  ok "backup complete: $dest"
}

cmd_restore() {
  local ts="${1:-}"
  if [[ -z "$ts" ]]; then
    hdr "Available backups"
    ls -1 "$BACKUP_DIR" 2>/dev/null || say "(none)"
    say ""
    say "usage: grave restore <backup> [volume <name> | repo <name> | workspaces]"
    say "Full procedures: $GRAVE_ROOT/docs/RECOVERY.md"
    return
  fi
  local dest="$BACKUP_DIR/$ts"
  [[ -d "$dest" ]] || { bad "no such backup: $ts"; exit 1; }
  case "${2:-}" in
    volume)
      local vol="${3:?volume name}"
      # $vol flows into `docker run -v $vol:/data` and a container `sh -c`, so an
      # unvalidated value could bind a host path (vol=/etc) or inject shell.
      [[ "$vol" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad "volume name must be letters, digits, '.', '-' or '_'"; exit 1; }
      dk volume create "$vol" >/dev/null
      dk run --rm -v "$vol":/data -v "$dest/volumes":/backup:ro alpine \
        sh -c "cd /data && tar -xzf /backup/$vol.tar.gz"
      ok "volume $vol restored from $ts" ;;
    repo)
      local name="${3:?repo name}"
      git clone "$dest/repos/$name.bundle" "$GRAVE_ROOT/repos/$name-restored"
      ok "repo restored to $GRAVE_ROOT/repos/$name-restored" ;;
    workspaces)
      [[ -f "$dest/configs/workspaces.tar.gz" ]] || { bad "backup has no workspace archive"; exit 1; }
      tar -C "$GRAVE_ROOT" -xzf "$dest/configs/grave-platform.tar.gz" config/workspaces.json 2>/dev/null || true
      tar -C "$GRAVE_ROOT" -xzf "$dest/configs/workspaces.tar.gz"
      ok "workspace data restored; run raise.sh then grave doctor" ;;
    *)
      say "Backup contents of $ts:"; find "$dest" -type f | sed "s|$dest/|  |"
      say ""; say "Restore a piece: grave restore $ts volume <name> | repo <name>"
      say "Full procedures: $GRAVE_ROOT/docs/RECOVERY.md" ;;
  esac
}

# ------------------------------------------------------------ multi-user ----
cmd_multiuser() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    status)
      say "multi-user: $([[ "${MULTI_USER:-0}" == 1 ]] && echo enabled || echo disabled)"
      [[ -r "$GRAVE_ROOT/config/workspaces.json" ]] && "$(dirname "$0")/grave-workspaces" list || true
      ;;
    enable)
      [[ $EUID == 0 ]] || { bad "multi-user migration requires root helper"; exit 1; }
      [[ "${MULTI_USER:-0}" != 1 ]] || { ok "multi-user mode already enabled"; return; }
      local identity="${1:?stable Tailscale numeric user ID}" login="${2:?owner Tailscale login}" slug="${3:?owner workspace slug}"; shift 3
      tailscale status --json | jq -e --arg id "$identity" --arg login "$login" '.User[$id].LoginName == $login' >/dev/null \
        || { bad "owner stable ID/login is not confirmed by local Tailscale state"; exit 1; }
      local profile=generic
      [[ "${1:-}" == --profile ]] && { profile="${2:?profile}"; shift 2; }
      local owner="${SUDO_USER:-$(stat -c %U "$GRAVE_ROOT")}" owner_home helper migration conf_backup
      owner_home=$(getent passwd "$owner" | cut -d: -f6); helper="$(dirname "$0")/grave-workspaces"
      migration="$GRAVE_ROOT/backups/migration-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$migration"
      conf_backup="$migration/grave.conf"; cp "$CONF" "$conf_backup"
      tailscale serve get-config "$migration/serve.json" >/dev/null 2>&1 || true
      HOME="$owner_home" cmd_backup
      # Provider access is opt-in per workspace.  Preserve an existing shared
      # provider only when this appliance actually has a provider credential;
      # otherwise a migrated owner must not acquire an unusable entitlement.
      local provider_lines provider_arg=()
      provider_lines=$(grep -E '^(OPENAI_API_KEY|ANTHROPIC_API_KEY)=' "$GRAVE_ROOT/config/secrets/t3.env" 2>/dev/null || true)
      [[ -n "$provider_lines" ]] || provider_arg=(--no-llm)
      GRAVE_ROOT="$GRAVE_ROOT" GRAVE_WORKSPACE_START=0 "$helper" add "$identity" "$login" "$slug" --role admin "${provider_arg[@]}"
      local target="$GRAVE_ROOT/workspaces/$slug"
      [[ -d "$GRAVE_ROOT/agents/t3code" ]] && cp -a --reflink=auto "$GRAVE_ROOT/agents/t3code/." "$target/state/t3/"
      # The appliance checkout itself is commonly a top-level repos symlink.
      # Never copy a link into a workspace: it escapes that workspace's home
      # and makes adoption/doctor either follow or reject an unsafe checkout.
      if [[ -d "$GRAVE_ROOT/repos" ]]; then
        for repo in "$GRAVE_ROOT"/repos/*; do
          [[ -d "$repo" && ! -L "$repo" ]] || continue
          cp -a --reflink=auto "$repo" "$target/repos/"
        done
      fi
      for d in .config/gh .codex .claude; do [[ -e "$owner_home/$d" ]] && { mkdir -p "$target/$(dirname "$d")"; cp -a "$owner_home/$d" "$target/$d"; }; done
      [[ -f "$owner_home/.gitconfig" ]] && cp -a "$owner_home/.gitconfig" "$target/.gitconfig"
      [[ -f "$GRAVE_ROOT/config/secrets/linear.env" ]] && cp -a "$GRAVE_ROOT/config/secrets/linear.env" "$target/config/secrets/linear.env"
      [[ -f "$GRAVE_ROOT/config/gravedecay-settings.json" ]] && cp -a "$GRAVE_ROOT/config/gravedecay-settings.json" "$target/config/gravedecay-settings.json"
      # These capabilities are consumed by root gateway/systemd only.  Create
      # them while this migration helper is root so the owner never races a
      # readable initial value before the re-raise installs the boundary.
      local gateway_token="$GRAVE_ROOT/config/secrets/gateway-token" admin_token="$GRAVE_ROOT/config/secrets/admin-dashboard.env"
      [[ -s "$gateway_token" ]] || python3 -c 'import secrets; print(secrets.token_hex(32))' >"$gateway_token"
      [[ -s "$admin_token" ]] || printf 'GRAVEDECAY_BACKEND_TOKEN=%s\n' "$(python3 -c 'import secrets; print(secrets.token_hex(32))')" >"$admin_token"
      chown root:root "$gateway_token" "$admin_token"; chmod 600 "$gateway_token" "$admin_token"
      # The owner re-raise is intentionally limited to the installed scoped
      # sudo grant.  It may tee files under /etc/systemd/system, but cannot
      # create a new directory there, so create this root-owned drop-in
      # directory while the migration helper still has root authority.
      install -d -m 755 -o root -g root /etc/systemd/system/gravedecay.service.d
      [[ -n "$provider_lines" && ! -e "$GRAVE_ROOT/config/secrets/provider.env" ]] && { printf '%s\n' "$provider_lines" >"$GRAVE_ROOT/config/secrets/provider.env"; chmod 600 "$GRAVE_ROOT/config/secrets/provider.env"; }
      chown -R "grave-$slug:grave-$slug" "$target"
      chown root:root "$GRAVE_ROOT/config/workspace-services/$slug.env"; chmod 600 "$GRAVE_ROOT/config/workspace-services/$slug.env"
      local repo name url
      for repo in "$target"/repos/*; do
        [[ -d "$repo/.git" && ! -L "$repo" ]] || continue; name=$(basename "$repo"); url=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
        [[ -n "$url" ]] && GRAVE_ROOT="$GRAVE_ROOT" "$helper" adopt "$slug" "$name" "$url"
      done
      if grep -q '^MULTI_USER=' "$CONF"; then sed -i 's/^MULTI_USER=.*/MULTI_USER=1/' "$CONF"; else printf '\nMULTI_USER=1\nGATEWAY_PORT=4710\n' >>"$CONF"; fi
      if sudo -u "$owner" -H env -u SUDO_USER -u SUDO_UID -u SUDO_GID USER="$owner" "$REPO_DIR/raise.sh" --profile "$profile"; then
        systemctl disable --now t3code gravedecay-term >/dev/null 2>&1 || true
        printf '{"state":"enabled","owner":"%s","backup":"%s"}\n' "$slug" "$migration" >"$GRAVE_ROOT/config/multiuser-migration.json"
        audit_msg="multi-user enabled owner=$slug"; log "$audit_msg"; ok "$audit_msg"
      else
        cp "$conf_backup" "$CONF"
        sudo -u "$owner" -H env -u SUDO_USER -u SUDO_UID -u SUDO_GID USER="$owner" "$REPO_DIR/raise.sh" --profile "$profile" || true
        printf '{"state":"rolled-back","workspace_retained":"%s"}\n' "$slug" >"$GRAVE_ROOT/config/multiuser-migration.json"
        bad "migration failed; single-user config restored and workspace retained"; exit 1
      fi
      ;;
    *) say "usage: grave multiuser [status|enable <tailscale-id> <login> <slug> --profile <profile>]"; exit 1 ;;
  esac
}

cmd_multiuser_serve() {
  [[ $EUID == 0 && "${MULTI_USER:-0}" == 1 ]] || { bad "internal multi-user Serve helper requires root and MULTI_USER=1"; exit 1; }
  [[ "${GATEWAY_PORT:-}" =~ ^[0-9]+$ ]] && (( GATEWAY_PORT >= 1024 && GATEWAY_PORT <= 65535 )) \
    || { bad "unsafe gateway port"; exit 1; }
  local token
  token=$(<"$GRAVE_ROOT/config/secrets/gateway-token")
  [[ ${#token} -ge 32 ]] || { bad "gateway capability missing"; exit 1; }
  # Serve paths are persistent: remove legacy mounts in the same root-owned
  # operation that reads the private capability and installs the sole origin.
  tailscale serve --https=443 --set-path=/grave off >/dev/null 2>&1 || true
  tailscale serve --https=443 --set-path=/term off  >/dev/null 2>&1 || true
  tailscale serve --bg --https=443 "http://127.0.0.1:$GATEWAY_PORT/_grave_proxy/$token" >/dev/null
}

cmd_multiuser_cleanup() {
  [[ $EUID == 0 ]] || { bad "internal multi-user cleanup requires root"; exit 1; }
  systemctl disable --now gravedecay-boundary.service >/dev/null 2>&1 || true
  cmd_boundary_remove
  rm -f /etc/systemd/system/gravedecay.service.d/multiuser-boundary.conf
  rmdir /etc/systemd/system/gravedecay.service.d 2>/dev/null || true
  systemctl daemon-reload
}

# ------------------------------------------------------------- uninstall ----
# The inverse of raise.sh. Two rules shape every step below:
#
#  1. Remove what gravedecay installed; leave what it merely USED. Docker,
#     Homebrew, node, ttyd, t3 and the distro packages predate (or outlive) the
#     appliance and other things on the box may depend on them. Tailscale is the
#     sharpest case: we drop OUR serve mounts and the LocalAPI drop-in, but never
#     log the node out — on a remote box (the Steam Machine) that is the link the
#     operator is watching the uninstall through.
#  2. Data is not platform. $GRAVE_ROOT holds repos, agent history, secrets and
#     backups; it survives unless --purge says otherwise. A wrong uninstall
#     should cost a re-raise, not the work.
#
# Anything we deliberately leave behind is REPORTED at the end, so "what is
# still on this box" is never a guess.
UNINSTALL_UNITS=(
  gravedecay-backup.timer gravedecay-digest.timer
  gravedecay-auto-thaw.timer gravedecay-auto-thaw.service
  gravedecay-backup.service gravedecay-digest.service gravedecay-agents.service
  gravedecay-upgrade.service gravedecay-upgrade@.service
  gravedecay-gamewatch.service gravedecay-keepalive.service
  gravedecay-selfheal.service gravedecay-net.service
  gravedecay-term.service t3code.service
  gravedecay-gateway.service gravedecay-boundary.service gravedecay.service
  gravedecay-notify@.service
  gravedecay-t3@.service gravedecay-term@.service gravedecay-dashboard@.service
)

# Descriptions are written as completed results ("units stopped"), so the ✓ line
# and the dry-run line are the same sentence — the ○ marker, not the wording,
# says whether it happened.
uninst_do() { # uninst_do <description> <cmd...> — must succeed; honors --dry-run
  local what="$1"; shift
  if (( UNINSTALL_DRY )); then printf '  %b○%b %s\n' "$YLW" "$RST" "$what"; return 0; fi
  if "$@"; then ok "$what"; else bad "$what — failed (continuing)"; UNINSTALL_FAILED=1; fi
}
uninst_try() { # same, but a failure is expected-and-fine (nothing there to undo)
  local what="$1"; shift
  if (( UNINSTALL_DRY )); then printf '  %b○%b %s\n' "$YLW" "$RST" "$what"; return 0; fi
  if "$@" >/dev/null 2>&1; then ok "$what"; else say "  ${YLW}– $what — nothing to do${RST}"; fi
}

uninstall_strip_agent_hooks() { # drop the grave-agent-notify hooks from agent CLIs
  local settings="$HOME/.claude/settings.json" codex="$HOME/.codex/config.toml" tmp found=0
  grep -q 'grave-agent-notify' "$settings" 2>/dev/null && found=1
  grep -q 'grave-agent-notify' "$codex"    2>/dev/null && found=1
  (( found )) || { say "  ${YLW}– no gravedecay hooks in the agent CLI configs${RST}"; return 0; }
  # Left in place these become a Stop hook pointing at a deleted script, so every
  # Claude turn ends in a "command not found" error on a box with no gravedecay.
  if [[ -s "$settings" ]] && grep -q 'grave-agent-notify' "$settings" 2>/dev/null; then
    if (( UNINSTALL_DRY )); then
      printf '  %b○%b %s\n' "$YLW" "$RST" "gravedecay hooks removed from $settings"
    else
      tmp=$(mktemp)
      # Drop only OUR hook entries, then prune the arrays/keys they leave empty —
      # a hand-added hook in the same event survives untouched.
      if jq '
        def clean: map(.hooks |= map(select(.command | test("grave-agent-notify") | not)))
                 | map(select(.hooks | length > 0));
        if .hooks then .hooks |= (with_entries(.value |= clean) | with_entries(select(.value | length > 0))) else . end
        | if (.hooks // {}) == {} then del(.hooks) else . end
      ' "$settings" >"$tmp" 2>/dev/null; then
        mv "$tmp" "$settings"; chmod 600 "$settings"; ok "gravedecay hooks removed from $settings"
      else
        # Not cosmetic: the hooks stay, pointing at a script this run deletes,
        # so every future agent turn errors. Fail the run so it gets fixed.
        rm -f "$tmp"; bad "$settings is not valid JSON — remove the grave-agent-notify hooks by hand"
        UNINSTALL_FAILED=1
      fi
    fi
  fi
  if [[ -f "$codex" ]] && grep -q 'grave-agent-notify' "$codex" 2>/dev/null; then
    # Rewrite through a temp file rather than `sed -i`: the in-place flag takes
    # an argument on BSD sed and none on GNU, and this runs on both.
    uninst_do "gravedecay notify line removed from $codex" \
      uninstall_drop_lines "$codex" 'grave-agent-notify'
  fi
}

uninstall_drop_lines() { # uninstall_drop_lines <file> <fixed-string> — delete matching lines
  local file="$1" needle="$2" tmp
  tmp=$(mktemp) || return 1
  grep -vF -- "$needle" "$file" >"$tmp" || true   # grep exits 1 when nothing remains
  cat "$tmp" >"$file" && rm -f "$tmp"             # preserve the original mode (600)
}

tailscale_backend_state() { # print tailscaled's BackendState; empty if unreachable
  tailscale status --json 2>/dev/null \
    | sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p' | head -1
}

tailscale_wait_running() { # bounded wait for a warming-up backend
  # `tailscale status` exits non-zero for the whole reconnect window, so a
  # caller that reads that as "logged out" skips its own teardown. Wait out the
  # transient states only — NeedsLogin and Stopped are answers, not delays.
  local waited=0 state
  while :; do
    state=$(tailscale_backend_state)
    case "$state" in
      Running)             return 0 ;;
      NoState|Starting|"") ;;
      *)                   return 1 ;;
    esac
    (( waited >= 15 )) && return 1
    sleep 1; waited=$(( waited + 1 ))
  done
}

uninstall_tailscale_serve() { # drop only the mounts raise.sh created
  command -v tailscale >/dev/null 2>&1 || return 0
  if ! tailscale_wait_running; then
    case "$(tailscale_backend_state)" in
      NeedsLogin|Stopped)
        say "  ${YLW}– tailscale is logged out — no serve config to clear${RST}" ;;
      *)
        bad "tailscaled never became ready — serve mounts NOT cleared"
        say "      once it is up: tailscale serve --https=443 off"
        UNINSTALL_FAILED=1 ;;
    esac
    return 0
  fi
  # A path that was never mounted makes `serve off` exit non-zero — expected on
  # a box that never finished its raise, so these are best-effort throughout.
  local path
  for path in /grave /term /net; do
    uninst_try "tailnet mount $path removed" \
      tailscale serve --https=443 --set-path="$path" off
  done
  uninst_try "tailnet mount / removed" tailscale serve --https=443 off
  # `grave preview` tunnels live on their own ports and would otherwise outlive
  # the CLI that knows how to stop them.
  local line port
  while IFS= read -r line; do
    port=$(sed -n 's#^https://[^ :]*:\([0-9]\{1,\}\).*#\1#p' <<<"$line")
    # An `if` (not a bare `&&` chain): most lines of `serve status` — the
    # header, the mount rows, the trailing blank — carry no port, and a chain
    # ending false makes the loop, and this function, return non-zero. Under
    # `set -e` that aborted the uninstall here, skipping Docker, /etc and the
    # CLI on every box that was serving without a preview tunnel open.
    if [[ -n "$port" ]] && preview_in_range "$port"; then
      uninst_try "preview tunnel on :$port removed" tailscale serve --https="$port" off
    fi
  done < <(tailscale serve status 2>/dev/null)
  # `serve off` on a path that was never mounted also exits non-zero, so no
  # exit code above can tell "nothing to remove" from "could not remove it".
  # Ask the daemon instead: anything still served here outlived the uninstall,
  # and a box whose tailnet URLs still answer is exactly what must not pass
  # silently.
  (( UNINSTALL_DRY )) && return 0
  local left stuck=()
  left=$(tailscale serve status 2>/dev/null)
  # Only our own mounts: a tunnel this box serves for some other reason was
  # deliberately left alone above, and must not read as a failed teardown.
  for path in / /grave /term /net; do
    grep -qE "^\|-- ${path}( |$)" <<<"$left" && stuck+=("$path")
  done
  if ((${#stuck[@]})); then
    bad "tailnet mounts survived the teardown: ${stuck[*]}"
    say "      the box still answers on its tailnet URL, proxying to dead ports"
    say "      clear them with: tailscale serve --https=443 off"
    UNINSTALL_FAILED=1
  fi
}

cmd_uninstall() { # grave uninstall [--purge] [--yes] [--dry-run]
  local purge=0 assume_yes=0
  UNINSTALL_DRY=0 UNINSTALL_FAILED=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --purge)          purge=1 ;;
      --yes|-y)         assume_yes=1 ;;
      --dry-run|-n)     UNINSTALL_DRY=1 ;;
      *) say "usage: grave uninstall [--purge] [--yes] [--dry-run]"; exit 1 ;;
    esac
    shift
  done

  local grave_bin grave_dir grave_needs_root=1
  grave_bin="$(readlink -f "$0")"; grave_dir="$(dirname "$grave_bin")"
  # Immutable hosts install the CLI into ~/.local/bin, which needs no root to
  # remove. Decide on writability of the containing directory rather than a
  # $HOME path prefix — that is the question actually being asked, and it
  # survives a symlinked home.
  [[ -w "$grave_dir" ]] && grave_needs_root=0

  hdr "🪦 Uninstall gravedecay$( (( purge )) && printf ' — PURGE' )$( (( UNINSTALL_DRY )) && printf ' (dry run)' )"
  say "Removes:"
  say "  • platform systemd units (dashboard, t3code, term, net, timers, watchers)"
  say "  • the grave CLIs ($grave_bin, $grave_dir/grave-workspaces)"
  say "  • /etc/gravedecay, the scoped sudoers drop-in, /usr/libexec/gravedecay"
  say "  • the gravedecay tailnet serve mounts (/, /grave, /term, /net) + previews"
  say "  • the ${DEV_STACKS[*]} containers and the devnet docker network"
  if (( purge )); then
    say "  • ${RED}$GRAVE_ROOT entirely — repos, agent history, secrets, backups${RST}"
    say "  • ${RED}all docker volumes (databases included)${RST}"
  else
    say "Keeps:"
    say "  • $GRAVE_ROOT — repos, agent history, secrets, backups, docker volumes"
    say "  • docker, tailscale (still logged in), the toolchain and distro packages"
  fi
  say ""

  if (( ! assume_yes && ! UNINSTALL_DRY )); then
    local want="uninstall" answer
    (( purge )) && want="purge $(hostname 2>/dev/null || echo box)"
    [[ -t 0 ]] || { bad "uninstall needs a terminal to confirm — pass --yes to run headless"; exit 1; }
    printf 'Type %b%s%b to continue: ' "$BLD" "$want" "$RST"
    read -r answer
    [[ "$answer" == "$want" ]] || { say "Aborted — nothing was changed."; exit 1; }
  fi
  # Removing unit files and /etc entries is outside the scoped NOPASSWD grant
  # (which only allows `tee` INTO /etc/systemd/system), so cache a credential up
  # front rather than dying at a prompt halfway through a teardown.
  # Even a user-installed CLI needs root for the unit files and /etc entries, so
  # this is not gated on grave_needs_root.
  if [[ $EUID != 0 ]]; then
    (( UNINSTALL_DRY )) || sudo -v || { bad "sudo access required to remove system files"; exit 1; }
  fi
  log "uninstall: started (purge=$purge dry=$UNINSTALL_DRY)"

  # ---- 1. T3 Connect: drop the relay link before the box stops existing ----
  local connect_mode; connect_mode="$(t3_connect_mode 2>/dev/null || echo off)"
  if [[ "$connect_mode" != off ]]; then
    hdr "T3 Connect"
    # A live relay link that outlives the appliance leaves the official apps
    # pointed at a box that no longer answers — and holds the account's
    # managed-tunnel slot hostage (see docs/SECURITY.md).
    if command -v t3 >/dev/null 2>&1; then
      uninst_try "T3 Connect unlinked (mode was $connect_mode)" \
        t3 connect unlink --base-dir "$T3_BASE_DIR"
    else
      bad "T3 Connect mode is '$connect_mode' but the t3 CLI is gone — this box"
      say "     may still hold a relay link and a managed-tunnel slot. Unlink from"
      say "     another environment before deleting $T3_BASE_DIR (docs/SECURITY.md)."
    fi
  fi

  # ---- 2. services ----
  hdr "Services"
  # Templates (name@.service) are not runnable units — `systemctl stop` on one
  # fails with "missing the instance name". Only their INSTANCES can be stopped,
  # and only the template FILE gets removed below.
  local unit present=()
  for unit in "${UNINSTALL_UNITS[@]}"; do
    [[ "$unit" == *@.service ]] && continue
    systemctl cat "$unit" >/dev/null 2>&1 && present+=("$unit")
  done
  # Workspace instances: an enabled gravedecay-t3@slug keeps its template
  # referenced, and a stopped-but-enabled instance reappears on the next boot.
  # Read them from systemd rather than the registry so instances for workspaces
  # already removed from workspaces.json are still caught.
  local svc
  while IFS= read -r svc; do [[ -n "$svc" ]] && present+=("$svc"); done < <(
    systemctl list-units --all --no-legend --plain 'gravedecay-*@*.service' 2>/dev/null | awk '{print $1}')
  if ((${#present[@]})); then
    # These were filtered to units systemd knows, and stopping an already-dead
    # unit succeeds — so a failure here is real and worth surfacing.
    uninst_do "${#present[@]} platform unit(s) stopped" sudo systemctl stop "${present[@]}"
    # `disable` exits non-zero on a unit with no [Install] section (static) —
    # nothing to undo there, so a miss is not a failure.
    uninst_try "platform units disabled" sudo systemctl disable "${present[@]}"
  else
    say "  ${YLW}– no gravedecay units are running${RST}"
  fi
  local f files=()
  for unit in "${UNINSTALL_UNITS[@]}"; do
    f="/etc/systemd/system/$unit"; [[ -e "$f" ]] && files+=("$f")
  done
  [[ -e /etc/systemd/system/tailscaled.service.d/gravedecay-localapi.conf ]] \
    && files+=(/etc/systemd/system/tailscaled.service.d/gravedecay-localapi.conf)
  [[ -e /etc/systemd/system/gravedecay.service.d/multiuser-boundary.conf ]] \
    && files+=(/etc/systemd/system/gravedecay.service.d/multiuser-boundary.conf)
  ((${#files[@]})) && uninst_do "${#files[@]} unit file(s) removed from /etc/systemd/system" \
    sudo rm -f "${files[@]}"
  # The drop-in dir is ours only when empty — tailscaled may carry others.
  (( UNINSTALL_DRY )) || sudo rmdir /etc/systemd/system/tailscaled.service.d 2>/dev/null || true
  (( UNINSTALL_DRY )) || sudo rmdir /etc/systemd/system/gravedecay.service.d 2>/dev/null || true
  uninst_do "systemd daemon reloaded" sudo systemctl daemon-reload
  (( UNINSTALL_DRY )) || sudo systemctl reset-failed 2>/dev/null || true

  # ---- 3. tailnet exposure ----
  hdr "Tailnet"
  uninstall_tailscale_serve
  # tailscaled lost the LocalAPI drop-in with the unit files above; restart so
  # the socket returns to root-only ownership instead of keeping our group
  # grant. This has to come *after* the serve teardown: restarting first leaves
  # the daemon warming up, and every LocalAPI call above it fails.
  systemctl is-active --quiet tailscaled 2>/dev/null \
    && uninst_try "tailscaled restarted without the gravedecay drop-in" \
         sudo systemctl restart tailscaled
  uninst_try "multi-user loopback boundary removed" \
    sudo "$0" __boundary-remove

  # ---- 4. containers ----
  hdr "Docker"
  if dkctl is-active --quiet docker 2>/dev/null || dk info >/dev/null 2>&1; then
    local stack
    for stack in "${DEV_STACKS[@]}"; do
      [[ -d "$GRAVE_ROOT/docker/$stack" ]] || continue
      # --volumes only under --purge: a `down -v` on the core stack destroys the
      # postgres data directory, which is exactly the "cost a re-raise, not the
      # work" line this command is not allowed to cross by default.
      if (( purge )); then
        uninst_do "stack $stack removed (containers + volumes)" compose "$stack" down --volumes --remove-orphans
      else
        uninst_do "stack $stack removed (containers only — volumes kept)" compose "$stack" down --remove-orphans
      fi
    done
    dk network inspect devnet >/dev/null 2>&1 \
      && uninst_do "docker network devnet removed" dk network rm devnet
    if (( purge )); then
      # Anonymous volumes (64-hex names) went with `down --volumes` above; these
      # are the named ones, which outlive their stack by design.
      local vol
      while IFS= read -r vol; do
        [[ -n "$vol" ]] && uninst_do "docker volume $vol removed" dk volume rm "$vol"
      done < <(dk volume ls -q 2>/dev/null | grep -vE '^[0-9a-f]{64}$' || true)
    fi
  else
    say "  ${YLW}– docker is not running — containers and networks left as they are${RST}"
  fi

  # ---- 5. agent CLI hooks ----
  hdr "Agent CLI hooks"
  uninstall_strip_agent_hooks

  # ---- 6. system config ----
  hdr "System configuration"
  # /etc/sudoers.d is 0440 inside a 0750 dir on stock Arch — we usually cannot
  # even stat our own drop-in, so remove both possible names unconditionally
  # (raise.sh picks 50- or zz- depending on whether a wheel rule outranks it)
  # rather than testing for them. The stamp is the record of which one landed.
  local sudoers_file="" stamp="$GRAVE_ROOT/config/.sudoers.stamp"
  [[ -r "$stamp" ]] && sudoers_file="$(head -1 "$stamp")"
  [[ "$sudoers_file" == /etc/sudoers.d/* ]] || sudoers_file="(unrecorded)"
  uninst_do "sudoers drop-in removed — installed as $sudoers_file" \
    sudo rm -f /etc/sudoers.d/50-gravedecay /etc/sudoers.d/zz-gravedecay
  [[ -d /etc/gravedecay ]] && uninst_do "/etc/gravedecay removed" sudo rm -rf /etc/gravedecay
  [[ -d /usr/libexec/gravedecay ]] && uninst_do "/usr/libexec/gravedecay removed" sudo rm -rf /usr/libexec/gravedecay
  # The sleep/suspend masks are a gravedecay policy (profile_apply on always-on
  # boxes), not a pre-existing system setting — leaving them would silently keep
  # a Steam Machine from ever suspending again after the appliance is gone.
  if [[ "${CHECK_SLEEP_MASKED:-0}" == 1 ]]; then
    uninst_do "sleep/suspend targets unmasked" \
      sudo systemctl unmask sleep.target suspend.target hibernate.target hybrid-sleep.target
  fi

  # ---- 7. data ----
  hdr "Data"
  if (( purge )); then
    # ~/Projects is raise.sh's symlink into the tree we are about to delete.
    if [[ -L "$HOME/Projects" && "$(readlink "$HOME/Projects")" == "$GRAVE_ROOT/repos" ]]; then
      uninst_do "~/Projects symlink removed" rm -f "$HOME/Projects"
    fi
    if [[ -d "$GRAVE_ROOT" ]]; then
      # Owner-writable on a single-user box; the multi-user subtrees are not.
      if (( UNINSTALL_DRY )); then
        say "  would delete $GRAVE_ROOT ($(du -sh "$GRAVE_ROOT" 2>/dev/null | cut -f1 || echo '?') on disk)"
      else
        rm -rf "$GRAVE_ROOT" 2>/dev/null || sudo rm -rf "$GRAVE_ROOT"
        [[ -d "$GRAVE_ROOT" ]] && { bad "$GRAVE_ROOT could not be fully removed"; UNINSTALL_FAILED=1; } || ok "$GRAVE_ROOT deleted"
      fi
    fi
  else
    say "  ${GRN}✓${RST} $GRAVE_ROOT kept — repos, agent history, secrets, backups"
    say "    re-raise onto it any time: $GRAVE_ROOT/repos/gravedecay/raise.sh"
  fi

  # ---- 8. the CLIs, last: everything above needed them ----
  hdr "CLI"
  local rm_cmd=(sudo rm -f); (( grave_needs_root )) || rm_cmd=(rm -f)
  [[ -e "$grave_dir/grave-workspaces" ]] \
    && uninst_do "$grave_dir/grave-workspaces removed" "${rm_cmd[@]}" "$grave_dir/grave-workspaces"
  # Unlinking the running script is safe: the kernel keeps the inode alive for
  # the shell's open fd until this process exits.
  uninst_do "$grave_bin removed" "${rm_cmd[@]}" "$grave_bin"
  # Remove the dedicated owner's password-authenticated administrator rule
  # only after the last privileged operation. The Unix account/home remain.
  uninst_do "owner administrator rule removed (account retained)" \
    sudo rm -f /etc/sudoers.d/40-gravedecay-owner

  # ---- 9. what is still here ----
  hdr "Left on this box (by design)"
  say "  • docker, tailscale, node/npm, ttyd, t3 and distro packages — remove them yourself if unwanted"
  command -v tailscale >/dev/null 2>&1 && say "  • this node is still on the tailnet — 'sudo tailscale logout' to leave"
  (( purge )) || say "  • $GRAVE_ROOT and every docker volume"
  if [[ "${MULTI_USER:-0}" == 1 ]]; then
    local slugs; slugs=$(getent passwd 2>/dev/null | cut -d: -f1 | grep '^grave-' | tr '\n' ' ' || true)
    [[ -n "$slugs" ]] && say "  • ${YLW}workspace unix users: $slugs${RST} — collaborator credentials live in their homes; delete deliberately with 'userdel -r'"
  fi
  [[ "${CHECK_SNAPPER:-0}" == 1 ]] && say "  • snapper config '${SNAPPER_CONFIG:-srv}' and its snapshots"
  say ""
  if (( UNINSTALL_DRY )); then
    say "🪦 Dry run only — nothing was changed."
  elif (( UNINSTALL_FAILED )); then
    bad "uninstall finished with errors — review the ✗ lines above"
    exit 1
  else
    say "🪦 The box is unraised."
  fi
}

# ------------------------------------------------------------------ help ----
cmd_help() {
  cat <<'EOF'
grave — gravedecay appliance control 🪦

  grave status               overview: services, containers, agents, system
  grave doctor               verify every platform invariant
  grave bench [quick|capacity|sustained|status|cancel]  benchmark this dev box
  grave users [status|list|add|inspect|disable|remove]
  grave projects [list|grant|revoke|git-config]
  grave integrations [status|github-login|github-logout|linear-set|linear-logout]
  grave provider [set|grant|revoke|status]
  grave multiuser [status|enable]

  grave gaming               🎮 free resources: stop services, FREEZE agent
                             sessions in place (🧊 torpor — RAM kept, zero CPU)
  grave gaming --kill        ☠️ same but destroy agent sessions (max free RAM)
  grave gaming --for 2h      ⏱️ torpor now, automatically restore after 2h
  grave developer            💻 thaw sessions + restore full development mode
  grave start | stop         same as developer / gaming (without the banner)
  grave restart              stop + start developer services

  grave agents               list agent tmux sessions
  grave agents new <n> [dir]    create persistent agent session
  grave agents new <n> --repo <r> [--branch <b>]  start in an isolated worktree
  grave agents new <n> --repo <r> --task <json>  start Codex/Claude on a saved issue
  grave agents prune           remove clean, idle, merged/pushed worktrees
  grave agents attach <n>       attach (detach: Ctrl-b d)
  grave agents kill <n>         kill session
  grave agents history          past sessions — logs survive death; view 📜
                                and resume ▶ from the dashboard too
  grave agents resume <n>       recreate a dead session in its old dir

  grave docker [ps|up <stack>|down <stack>|logs <c>|stacks|disk]
  grave logs [t3|dash|ssh|tailscale|system|grave|agent <n>|<container/unit>]

  grave preview <port>       expose a running dev server (e.g. :3000) to the
                             tailnet at https://<box>.ts.net:<port> — root path,
                             so HMR/websockets just work. Server stays loopback.
  grave preview              auto-pick the one dev server listening in the range
  grave preview list         show active previews
  grave preview off <port>   stop a preview

  grave t3 [status|update]   show versions or install npm's stable T3 release
  grave t3 connect <mode>    T3 Connect for the official T3 apps — status, diagnose,
                             publish (phone notifications, transport stays
                             tailnet), full (managed relay tunnel, no VPN
                             needed), off. Doctor enforces the declared mode
  grave releases            list selectable stable gravedecay releases
  grave update               snapshot (if snapper), update pkgs/npm/images
  grave upgrade              update gravedecay itself: pull latest release
                             (--tag vX.Y.Z pins one; --edge follows main)
  grave bootmode [dev|game]  what a reboot boots into: developer services
                             up (default) or gaming (ALWAYS_ON only)
  grave gamewatch [on|off]   persistent automatic gaming/developer switching;
                             'status' shows the watcher and last signal
  grave keepalive [on|off]   "always alive": warm tailnet relay paths so a
                             remote/relay device's websocket doesn't idle-drop
  grave notify <t> [body]    page your devices: ntfy topic and/or Web Push to
                             the installed PWA (enroll in ⚙️ settings). Agents,
                             failing units, and doctor use the same channels —
                             see docs/NOTIFICATIONS.md
  grave digest [--print]     morning summary (agents, spend, doctor, backup);
                             a timer pages it at ~08:00 — --print composes
                             without paging
  grave backup               bundle repos, configs, docker volumes — every
                             artifact verified; a timer runs one nightly and
                             doctor enforces freshness (docs/RECOVERY.md)
  grave restore [backup]     list / restore backups
  grave uninstall            remove the platform: units, CLIs, /etc/gravedecay,
                             tailnet mounts, containers. KEEPS $GRAVE_ROOT
                             (repos, agents, secrets, backups) and leaves
                             docker/tailscale/packages alone
  grave uninstall --purge    also delete $GRAVE_ROOT and every docker volume
  grave uninstall --dry-run  print the teardown without touching anything

Docs: $GRAVE_ROOT/docs   Config: /etc/gravedecay/grave.conf
EOF
}

# ------------------------------------------------------------------ main ----
case "${1:-help}" in
  __dashboard-health) cmd_dashboard_health ;;
  __dashboard-probe) shift; cmd_dashboard_probe "${1:-}" ;;
  __boundary-apply) cmd_boundary_apply ;;
  __boundary-status) cmd_boundary_status ;;
  __boundary-remove) cmd_boundary_remove ;;
  __multiuser-serve) cmd_multiuser_serve ;;
  __multiuser-cleanup) cmd_multiuser_cleanup ;;
  __auto-thaw) shift || true; cmd_auto_thaw_root "$@" ;;
  status)     cmd_status ;;
  gaming)     shift || true; cmd_gaming "$@" ;;
  developer)  cmd_developer ;;
  start)      start_dev ;;
  stop)       shift || true; stop_dev "$@" ;;
  restart)    stop_dev; thaw_agents; start_dev ;;
  agents)     shift; cmd_agents "$@" ;;
  docker)     shift; cmd_docker "$@" ;;
  preview)    shift || true; cmd_preview "$@" ;;
  t3|t3code)  shift || true; cmd_t3 "$@" ;;
  update)     cmd_update ;;
  releases)   shift || true; cmd_releases "$@" ;;
  upgrade)    shift || true; cmd_upgrade "$@" ;;
  bootmode)   shift || true; cmd_bootmode "$@" ;;
  gamewatch)  shift || true; cmd_gamewatch "$@" ;;
  keepalive)  shift || true; cmd_keepalive "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  notify)     shift || true; cmd_notify "$@" ;;
  digest)     shift || true; cmd_digest "$@" ;;
  bench)      shift; exec python3 "$GRAVE_ROOT/scripts/benchmark.py" --root "$GRAVE_ROOT" "$@" ;;
  doctor)     shift || true; cmd_doctor "$@" ;;
  users)      shift || true; exec sudo -n "$0" __users "$@" ;;
  projects)
    shift || true; sub="${1:-list}"; shift || true
    case "$sub" in
      list) exec sudo -n "$0" __users projects "$@" ;;
      grant|revoke|git-config) exec sudo -n "$0" __users "$sub" "$@" ;;
      *) say "usage: grave projects [list <workspace>|grant <workspace> <name> <url>|revoke <workspace> <name>|git-config <workspace> --name N --email E]"; exit 1 ;;
    esac ;;
  integrations)
    shift || true; sub="${1:-status}"; shift || true
    case "$sub" in
      status) exec sudo -n "$0" __users integration-status "$@" ;;
      github-login|github-logout|linear-set|linear-logout) exec sudo -n "$0" __users "$sub" "$@" ;;
      *) say "usage: grave integrations [status <workspace>|github-login <workspace>|github-logout <workspace> --user U|linear-set <workspace>|linear-logout <workspace>]"; exit 1 ;;
    esac ;;
  provider)
    shift || true; sub="${1:-status}"; shift || true
    case "$sub" in
      set) exec sudo -n "$0" __users provider-set "$@" ;;
      grant|revoke) exec sudo -n "$0" __users provider-policy "$sub" "$@" ;;
      status) exec sudo -n "$0" __users provider-status "$@" ;;
      *) say "usage: grave provider [set|grant <workspace>|revoke <workspace>|status]"; exit 1 ;;
    esac ;;
  multiuser)  shift || true; exec sudo -n "$0" __multiuser "$@" ;;
  __multiuser) shift || true; cmd_multiuser "$@" ;;
  __users)    shift || true; [[ $EUID == 0 ]] || { bad "internal users helper requires root"; exit 1; }
              # Every lifecycle call (not just raise-time reapply) must carry
              # the appliance's resolved toolchain into workspace unit envs.
              # This keeps later additions correct on /usr/local and immutable
              # Homebrew hosts where the old /usr/bin defaults do not exist.
              export GRAVE_T3_BIN="$(command -v t3 2>/dev/null || true)"
              export GRAVE_TTYD_BIN="$(command -v ttyd 2>/dev/null || true)"
              export GRAVE_TOOL_PATH="${TOOL_PATH:-}"
              export GRAVE_BIN="$0"
              exec "$(dirname "$0")/grave-workspaces" "$@" ;;
  backup)     shift || true; cmd_backup "$@" ;;
  restore)    shift || true; cmd_restore "$@" ;;
  uninstall)  shift || true; cmd_uninstall "$@" ;;
  help|--help|-h) cmd_help ;;
  *) say "unknown command: $1"; cmd_help; exit 1 ;;
esac
